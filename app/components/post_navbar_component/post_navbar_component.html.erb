<ul class="notice post-notice post-notice-search">
  <% if has_search_navbar? %>
    <li class="search-navbar" data-selected="true">
      <%= link_to I18n.t("components.post_navbar.prev"), show_seq_post_path(post, q: search, seq: "prev"), rel: "nofollow prev", class: "prev", "data-shortcut": "a" %>
      <span class="search-name"><%= I18n.t("components.post_navbar.search_html", link: link_to(search, posts_path(tags: search), rel: "nofollow")).html_safe %></span>
      <%= link_to I18n.t("components.post_navbar.next"), show_seq_post_path(post, q: search, seq: "next"), rel: "nofollow next", class: "next", "data-shortcut": "d" %>
    </li>
  <% end %>

  <% pools.each do |pool| %>
    <% selected = selected_pool == pool %>
    <% first_post_id = pool.post_ids.first %>
    <% last_post_id = pool.post_ids.last %>
    <% previous_post_id = pool.previous_post_id(post.id) %>
    <% next_post_id = pool.next_post_id(post.id) %>

    <%= tag.li class: "pool-navbar pool-category-#{pool.category}", "data-selected": selected do %>
      <span class="first">
        <%= link_to_unless first_post_id == post.id, "«", post_path(first_post_id, q: "pool:#{pool.id}"), rel: "nofollow", title: I18n.t("components.post_navbar.to_page_1") %>
      </span>

      <span class="prev">
        <%= link_to_if previous_post_id, I18n.t("components.post_navbar.prev"), post_path(previous_post_id.to_i, q: "pool:#{pool.id}"), rel: ["nofollow", ("prev" if selected)], title: I18n.t("components.post_navbar.to_page", page: pool.page_number(previous_post_id)), "data-shortcut": ("a" if selected) %>
      </span>

      <span class="pool-name">
        <%= link_to I18n.t("components.post_navbar.pool", name: pool.pretty_name), pool, title: I18n.t("components.post_navbar.page_of", page: pool.page_number(post.id), count: pool.post_count) %>
      </span>

      <span class="next">
        <%= link_to_if next_post_id, I18n.t("components.post_navbar.next"), post_path(next_post_id.to_i, q: "pool:#{pool.id}"), rel: ["nofollow", ("next" if selected)], title: I18n.t("components.post_navbar.to_page", page: pool.page_number(next_post_id)), "data-shortcut": ("d" if selected) %>
      </span>

      <span class="last">
        <%= link_to_unless last_post_id == post.id, "»", post_path(last_post_id, q: "pool:#{pool.id}"), rel: "nofollow", title: I18n.t("components.post_navbar.to_page", page: pool.post_count) %>
      </span>
    <% end %>
  <% end %>

  <% favgroups.each do |favgroup| %>
    <% selected = selected_favgroup == favgroup %>
    <% first_post_id = favgroup.post_ids.first %>
    <% last_post_id = favgroup.post_ids.last %>
    <% previous_post_id = favgroup.previous_post_id(post.id) %>
    <% next_post_id = favgroup.next_post_id(post.id) %>

    <%= tag.li class: "favgroup-navbar", "data-selected": selected do %>
      <span class="first">
        <%= link_to_unless first_post_id == post.id, "«", post_path(first_post_id, q: "favgroup:#{favgroup.id}"), rel: "nofollow" %>
      </span>

      <span class="prev">
        <%= link_to_if previous_post_id, I18n.t("components.post_navbar.prev"), post_path(previous_post_id.to_i, q: "favgroup:#{favgroup.id}"), rel: ["nofollow", ("prev" if selected)], "data-shortcut": ("a" if selected) %>
      </span>

      <span class="favgroup-name">
        <%= link_to I18n.t("components.post_navbar.favgroup", name: favgroup.pretty_name), favgroup %>
      </span>

      <span class="next">
        <%= link_to_if next_post_id, I18n.t("components.post_navbar.next"), post_path(next_post_id.to_i, q: "favgroup:#{favgroup.id}"), rel: ["nofollow", ("next" if selected)], "data-shortcut": ("d" if selected) %>
      </span>

      <span class="last">
        <%= link_to_unless last_post_id == post.id, "»", post_path(last_post_id, q: "favgroup:#{favgroup.id}"), rel: "nofollow" %>
      </span>
    <% end %>
  <% end %>
</ul>
