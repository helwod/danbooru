<%= render PopupMenuComponent.new(classes: "preview-size-menu") do |menu| %>
  <% menu.with_button do %>
    <span class="rounded flex gap-1 items-center leading-none">
      <%= image_icon %> <span class="text-sm"><%= I18n.t("components.preview_size_menu.size") %></span> <%= caret_down_icon(class: "text-xs self-center") %>
    </span>
  <% end %>

  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.small"), current_page_path(size: 150), class: ("font-bold" if current_size == 150), rel: "nofollow" %>
  <% end %>

  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.medium"), current_page_path(size: 180), class: ("font-bold" if current_size == 180), rel: "nofollow" %>
  <% end %>

  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.large"), current_page_path(size: 225), class: ("font-bold" if current_size == 225), rel: "nofollow" %>
  <% end %>

  <%# Mobile only %>
  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.huge"), current_page_path(size: 360), class: ["mobile-only", ("font-bold" if current_size == 360)], rel: "nofollow" %>
  <% end %>

  <%# Desktop only %>
  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.huge"), current_page_path(size: 270), class: ["desktop-only", ("font-bold" if current_size == 270)], rel: "nofollow" %>
  <% end %>

  <%# Desktop only %>
  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.gigantic"), current_page_path(size: 360), class: ["desktop-only", ("font-bold" if current_size == 360)], rel: "nofollow" %>
  <% end %>

  <%# Desktop only %>
  <% menu.with_item do %>
    <%= link_to I18n.t("components.common.absurd"), current_page_path(size: 720), class: ["desktop-only", ("font-bold" if current_size == 720)], rel: "nofollow" %>
  <% end %>
<% end %>
