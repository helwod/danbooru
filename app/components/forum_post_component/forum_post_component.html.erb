<%= tag.article class: "forum-post message", id: "forum_post_#{forum_post.id}", data: { "is-reported": reported?, **data_attributes_for(forum_post, "", forum_post.html_data_attributes) }, "x-data": "{}" do %>
  <div class="author">
    <div class="author-name">
      <%= link_to_user forum_post.creator %>
      <% if forum_post.is_deleted? %>
        <%= I18n.t("components.forum_post.deleted") %>
      <% end %>
    </div>
    <%= link_to time_ago_in_words_tagged(forum_post.created_at), forum_post, class: "message-timestamp" %>
  </div>

  <div class="content">
    <div class="prose">
      <%= forum_post.dtext_body.format_text(references: dtext_references) %>
    </div>
    <%= render "application/update_notice", record: forum_post, current_user: current_user %>

    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
      <% if policy(forum_post).reply? %>
        <% if current_user.is_anonymous? %>
          <%= link_to I18n.t("components.common.reply"), login_path(url: request.fullpath) %>
        <% else %>
          <%= link_to I18n.t("components.common.reply"), new_forum_post_path(post_id: forum_post.id), method: :get, remote: true %>
        <% end %>
      <% end %>

      <% if reported? %>
        <span class="moderation-report-notice">
          <%= I18n.t("components.forum_post.reported_html", link: link_to(I18n.t("components.forum_post.reports", count: forum_post.pending_moderation_reports.length), moderation_reports_path(search: { model_type: "ForumPost", model_id: forum_post.id, status: "pending" }))).html_safe %>
        </span>
      <% end %>

      <%= render PopupMenuComponent.new do |menu| %>
        <% if policy(forum_post).update? %>
          <% menu.with_item do %>
            <% if forum_post.is_original_post?(original_forum_post_id) %>
              <%= link_to edit_forum_topic_path(forum_post.topic), id: "edit_forum_topic_link_#{forum_post.topic_id}", class: "edit_forum_topic_link" do %>
                <%= edit_icon %> <%= I18n.t("components.common.edit") %>
              <% end %>
            <% else %>
              <%= link_to edit_forum_post_path(forum_post.id), id: "edit_forum_post_link_#{forum_post.id}", class: "edit_forum_post_link" do %>
                <%= edit_icon %> <%= I18n.t("components.common.edit") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <% if forum_post.is_deleted? && policy(forum_post).undelete? && !forum_post.is_original_post?(original_forum_post_id) %>
          <% menu.with_item do %>
            <%= link_to undelete_forum_post_path(forum_post.id), method: :post, remote: true do %>
              <%= undelete_icon %> <%= I18n.t("components.common.undelete") %>
            <% end %>
          <% end %>
        <% end %>

        <% if !forum_post.is_deleted? && policy(forum_post).destroy? && !forum_post.is_original_post?(original_forum_post_id) %>
          <% menu.with_item do %>
            <%= link_to forum_post_path(forum_post.id), "data-confirm": I18n.t("components.forum_post.confirm_delete"), method: :delete, remote: true do %>
              <%= delete_icon %> <%= I18n.t("components.common.delete") %>
            <% end %>
          <% end %>
        <% end %>

        <% if policy(forum_post).reportable? %>
          <% menu.with_item do %>
            <%= link_to new_moderation_report_path(moderation_report: { model_type: "ForumPost", model_id: forum_post.id }), remote: true do %>
              <%= flag_icon %> <%= I18n.t("components.common.report") %>
            <% end %>
          <% end %>
        <% end %>

        <% if !forum_post.creator.is_banned? && policy(Ban.new(user: forum_post.creator)).create? %>
          <% menu.with_item do %>
            <%= link_to new_ban_path(ban: { user_id: forum_post.creator.id }) do %>
              <%= ban_icon %> <%= I18n.t("components.common.ban_user") %>
            <% end %>
          <% end %>
        <% end %>

        <% menu.with_item do %>
          <%= link_to "#", class: "forum-post-copy-id", "x-on:click.prevent": "$copyToClipboard('forum ##{j forum_post.id}')" do %>
            <%= hashtag_icon %> <%= I18n.t("components.common.copy_id") %>
          <% end %>
        <% end %>

        <% menu.with_item do %>
          <%= link_to "#", class: "forum-post-copy-link", "x-on:click.prevent": "$copyToClipboard('#{j forum_post_url(forum_post)}')" do %>
            <%= link_icon %> <%= I18n.t("components.common.copy_link") %>
          <% end %>
        <% end %>

        <% if bur.present? %>
          <% if policy(bur).approve? || policy(bur).update? || policy(bur).destroy? %>
            <% menu.with_item do %>
              <hr class="border">
            <% end %>
          <% end %>

          <% if policy(bur).approve? %>
            <% menu.with_item do %>
              <%= link_to approve_bulk_update_request_path(bur.id), id: "approve_bulk_update_request_link_#{bur.id}", class: "approve_bulk_update_request_link", "data-confirm": I18n.t("components.forum_post.confirm_approve_bur"), method: :post, remote: true do %>
                <%= check_square_icon %> <%= I18n.t("components.forum_post.approve_bur") %>
              <% end %>
            <% end %>
          <% end %>

          <% if policy(bur).update? %>
            <% menu.with_item do %>
              <%= link_to edit_bulk_update_request_path(bur.id), id: "edit_bulk_update_request_link_#{bur.id}", class: "edit_bulk_update_request_link" do %>
                <%= edit_icon %> <%= I18n.t("components.forum_post.edit_bur") %>
              <% end %>
            <% end %>
          <% end %>

          <% if policy(bur).destroy? %>
            <% menu.with_item do %>
              <%= link_to bur, "data-confirm": I18n.t("components.forum_post.confirm_reject_bur"), method: :delete, remote: true do %>
                <%= delete_icon %> <%= I18n.t("components.forum_post.reject_bur") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if bur.present? %>
        <%= render "forum_post_votes/list", votes: forum_post.votes, forum_post: forum_post %>
      <% end %>
    </div>

    <% if policy(forum_post).update? %>
      <% if forum_post.is_original_post?(original_forum_post_id) %>
        <%= render "forum_topics/form", forum_topic: forum_post.topic, inline: true %>
      <% else %>
        <%= render "forum_posts/partials/edit/form", forum_post: forum_post, inline: true %>
      <% end %>
    <% end %>
  </div>
<% end %>
