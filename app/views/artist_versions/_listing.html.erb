<%= search_form_for(artist_versions_path) do |f| %>
  <%= f.input :updater_name, label: t("artist_versions.listing.updater"), input_html: { value: params.dig(:search, :updater_name), "data-autocomplete": "user" } %>
  <%= f.input :name, label: t("artist_versions.listing.artist"), input_html: { value: params.dig(:search, :name), "data-autocomplete": "artist" } %>
  <%= f.input :order, collection: [[t("artist_versions.listing.order_id"), "id"], [t("artist_versions.listing.order_created"), "created_at"], [t("artist_versions.listing.order_updated"), "updated_at"], [t("artist_versions.listing.order_name"), "name"]], selected: params.dig(:search, :order) %>
  <%= f.submit t("artist_versions.listing.submit") %>
<% end %>

<div id="p-<%= listing_type(:artist_id) %>-listing">
    <%= table_for @artist_versions, class: "striped autofit", width: "100%" do |t| %>
      <% t.column t("artist_versions.listing.column_name"), column: "name", td: {class: "diff-body"} do |artist_version| %>
        <%= link_to artist_version.name, artist_path(artist_version.artist_id) %>
        <%= link_to "»", artist_versions_path(search: {artist_id: artist_version.artist_id}, anchor: "artist-version-#{artist_version.id}") %>
        <%= artist_version_name_diff(artist_version, params[:type]) %>
      <% end %>
      <% t.column t("artist_versions.listing.column_other_names"), column: "other-names", td: {class: "diff-body"} do |artist_version| %>
        <%= artist_version_group_name_diff(artist_version, params[:type]) %>
        <%= artist_version_other_names_diff(artist_version, params[:type]) %>
      <% end %>
      <% t.column t("artist_versions.listing.column_urls"), column: "urls", td: {class: "col-expand"} do |artist_version| %>
        <%= artist_version_urls_diff(artist_version, params[:type]) %>
      <% end %>
      <% t.column t("artist_versions.listing.column_changes"), column: "changes" do |artist_version| %>
        <%= status_diff_html(artist_version, params[:type]) %>
      <% end %>
      <% t.column t("artist_versions.listing.column_updated"), column: "updated" do |artist_version| %>
        <%= link_to_user artist_version.updater %>
        <%= link_to "»", artist_versions_path(search: { updater_name: artist_version.updater.name }) %>
        <div><%= compact_time(artist_version.updated_at) %></div>
      <% end %>
      <% if listing_type(:artist_id) == :revert %>
        <% t.column column: "control" do |artist_version| %>
          <%= link_to t("artist_versions.listing.revert_to"), revert_artist_path(artist_version.artist_id, version_id: artist_version.id), method: :put, "data-confirm": t("artist_versions.listing.confirm_revert") %>
        <% end %>
      <% end %>
    <% end %>

</div>
