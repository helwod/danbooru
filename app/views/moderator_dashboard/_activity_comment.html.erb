<h2><%= t("moderator_dashboard.comment_activity") %></h2>

<table class="striped w-full">
  <thead>
    <tr>
      <th><%= t("moderator_dashboard.id") %></th>
      <th><%= t("moderator_dashboard.body") %></th>
      <th><%= t("moderator_dashboard.user") %></th>
      <th><%= t("moderator_dashboard.votes") %></th>
      <th><%= t("moderator_dashboard.score") %></th>
    </tr>
  </thead>
  <tbody>
    <% @dashboard.comments.each do |comment, count| %>
      <tr>
        <td><%= link_to comment.dtext_shortlink, comment %></td>
        <td>
          <div class="prose">
            <%= comment.dtext_body.format_text %>

            <% if comment.is_deleted? %>
              <span class="inactive"><%= t("moderator_dashboard.deleted") %></span>
            <% end %>
          </div>
        </td>
        <td><%= link_to_user(comment.creator) %></td>
        <td><%= count %></td>
        <td><%= comment.score %></td>
      </tr>
    <% end %>
  </tbody>
</table>
