<h2><%= t("moderator_dashboard.uploads") %></h2>

<table class="striped w-full">
  <thead>
    <tr>
      <th><%= t("moderator_dashboard.user") %></th>
      <th><%= t("moderator_dashboard.count") %></th>
    </tr>
  </thead>
  <tbody>
    <% @dashboard.posts.each do |user, count| %>
      <tr>
        <td><%= link_to_user(user) %></td>
        <td><%= link_to count, posts_path(tags: "user:#{user.name}") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
