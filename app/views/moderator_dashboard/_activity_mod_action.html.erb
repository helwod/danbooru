<h2><%= t("moderator_dashboard.mod_actions") %></h2>

<table class="striped w-full">
  <thead>
    <tr>
      <th><%= t("moderator_dashboard.moderator") %></th>
      <th><%= t("moderator_dashboard.description") %></th>
    </tr>
  </thead>
  <tbody>
    <% @dashboard.mod_actions.each do |mod_action| %>
      <tr>
        <td><%= link_to_user mod_action.creator %></td>
        <td>
          <div class="prose">
            <%= mod_action.dtext_description.format_text %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to t("moderator_dashboard.view_all_actions"), mod_actions_path %></p>
