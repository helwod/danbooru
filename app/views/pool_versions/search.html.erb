<div id="c-pool-versions">
  <div id="a-search">
    <h1><%= t("pool_versions.search.title") %></h1>

    <%= search_form_for(pool_versions_path) do |f| %>
      <%= f.input :updater_name, label: t("pool_versions.search.updater"), input_html: { value: params.dig(:search, :updater_name), "data-autocomplete": "user" } %>
      <%= f.input :name_contains, label: t("pool_versions.search.pool"), input_html: { value: params.dig(:search, :name_contains), "data-autocomplete": "pool" } %>
      <%= f.input :category, label: t("pool_versions.search.category"), collection: [[t("pool_versions.search.category_series"), "series"], [t("pool_versions.search.category_collection"), "collection"]], include_blank: true %>
      <%= f.input :is_new, label: t("pool_versions.search.is_new"), collection: [[t("pool_versions.search.yes"), true], [t("pool_versions.search.no"), false]], include_blank: true %>
      <%= f.input :name_changed, label: t("pool_versions.search.name_changed"), collection: [[t("pool_versions.search.yes"), true], [t("pool_versions.search.no"), false]], include_blank: true %>
      <%= f.input :description_changed, label: t("pool_versions.search.description_changed"), collection: [[t("pool_versions.search.yes"), true], [t("pool_versions.search.no"), false]], include_blank: true %>
      <%= f.input :is_deleted, label: t("pool_versions.search.deleted"), collection: [[t("pool_versions.search.yes"), true], [t("pool_versions.search.no"), false]], include_blank: true %>
      <%= f.submit t("pool_versions.search.submit") %>
    <% end %>
  </div>
</div>

<%= render "secondary_links" %>
