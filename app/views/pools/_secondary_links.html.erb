<% content_for(:secondary_links) do %>
  <%= quick_search_form_for(:name_contains, pools_path, "pools", autocomplete: "pool", redirect: true) %>
  <%= subnav_link_to t("pools.secondary_links.gallery"), gallery_pools_path, id: "gallery" %>
  <%= subnav_link_to t("pools.secondary_links.listing"), pools_path, id: "listing" %>
  <% if policy(Pool).create? %>
    <%= subnav_link_to t("pools.secondary_links.new"), new_pool_path, id: "new" %>
  <% end %>
  <% if PoolVersion.enabled? %>
    <%= subnav_link_to t("pools.secondary_links.changes"), pool_versions_path, id: "changes" %>
  <% end %>
  <%= subnav_link_to t("pools.secondary_links.help"), wiki_page_path("help:pools"), id: "help" %>
  <% if @pool && !@pool.new_record? %>
    <%= subnav_divider %>
    <%= subnav_link_to t("pools.secondary_links.posts"), posts_path(:tags => "pool:#{@pool.id}"), id: "posts" %>
    <% if policy(@pool).update? %>
      <%= subnav_link_to t("pools.secondary_links.edit"), edit_pool_path(@pool), "data-shortcut": "e", id: "edit" %>
    <% end %>
    <% if current_page?(action: :edit) %>
      <% if policy(@pool).undelete? %>
        <%= subnav_link_to t("pools.secondary_links.undelete"), undelete_pool_path(@pool), :method => :post, :remote => true, id: "undelete" %>
      <% elsif policy(@pool).destroy? %>
        <%= subnav_link_to t("pools.secondary_links.delete"), pool_path(@pool), :method => :delete, :"data-shortcut" => "shift+d", :"data-confirm" => t("pools.secondary_links.confirm_delete"), :remote => true, id: "delete" %>
      <% end %>
    <% end %>
    <% if PoolVersion.enabled? %>
      <%= subnav_link_to t("pools.secondary_links.history"), pool_versions_path(:search => {:pool_id => @pool.id}), id: "history" %>
    <% end %>
    <% if policy(@pool).update? %>
      <%= subnav_link_to t("pools.secondary_links.order"), edit_pool_order_path(@pool), id: "order" %>
    <% end %>
  <% end %>
<% end %>
