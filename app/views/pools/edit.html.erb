<div id="c-pools">
  <div id="a-edit">
    <%= edit_form_for(@pool) do |f| %>
      <h1><%= t("pools.edit.title", name: @pool.pretty_name) %></h1>

      <%= f.input :name, :as => :string, :input_html => { :value => @pool.pretty_name } %>
      <%= f.input :description, as: :dtext, input_html: { autofocus: true } %>
      <%= f.input :post_ids_string, as: :text, label: t("pools.form.posts") %>
      <%= f.input :category, :collection => [[t("pools.category_series"), "series"], [t("pools.category_collection"), "collection"]], :include_blank => false %>
      <%= f.submit_button %>
    <% end %>
  </div>
</div>

<%= render "secondary_links" %>
