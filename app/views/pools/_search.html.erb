<%= search_form_for(path) do |f| %>
  <%= f.input :name_contains, label: t("pools.search.name"), input_html: { value: params.dig(:search, :name_contains), "data-autocomplete": "pool" } %>
  <%= f.input :description_matches, label: t("pools.search.description"), input_html: { value: params.dig(:search, :description_matches) } %>
  <%= f.input :post_tags_match, label: t("pools.search.post_tags"), input_html: { value: params.dig(:search, :post_tags_match), "data-autocomplete": "tag-query" } %>
  <%= f.input :is_deleted, label: t("pools.search.deleted"), as: :select, include_blank: true, selected: params[:search][:is_deleted] %>
  <%= f.input :category, collection: [[t("pools.category_series"), "series"], [t("pools.category_collection"), "collection"]], include_blank: true, selected: params[:search][:category] %>
  <%= f.input :order, collection: [[t("pools.search.order_last_updated"), "updated_at"], [t("pools.search.order_name"), "name"], [t("pools.search.order_recently_created"), "created_at"], [t("pools.search.order_post_count"), "post_count"]], include_blank: true, selected: params.dig(:search, :order) %>
  <%= f.submit t("pools.search.submit") %>
<% end %>
