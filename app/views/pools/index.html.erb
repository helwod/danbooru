<% page_title t("pools.index.page_title") %>
<% meta_description t("pools.meta_description", app_name: Danbooru.config.app_name) %>

<%= render "secondary_links" %>

<div id="c-pools">
  <div id="a-index">
    <%= render "search", :path => pools_path %>

    <%= table_for @pools, width: "100%" do |t| %>
      <% t.column t("pools.index.column_name"), width: "60%", column: "name" do |pool| %>
        <span class="pool-category-<%= pool.category %>"><%= link_to pool.pretty_name, pool_path(pool) %></span>
        <% if pool.is_deleted? %>
          <span class="inactive"><%= t("pools.index.deleted") %></span>
        <% end %>
        <% if pool.last_page > 1 %>
          <%= link_to t("pools.index.page", page: pool.last_page), pool_path(pool, :page => pool.last_page), :class => "last-page" %>
        <% end %>
      <% end %>
      <% t.column t("pools.index.column_count"), width: "10%", column: "count" do |pool| %>
        <%= pool.post_count %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@pools) %>
  </div>
</div>
