<% page_title t("backup_codes.send_title") %>
<%= render "users/secondary_links" %>

<div id="c-totp">
  <div id="a-confirm-recover">
    <div class="card mt-4 p-4 max-w-540px mx-auto flex flex-col items-center gap-2">
      <h1 class="text-center"><%= t("backup_codes.send_heading_html", user: link_to_user(@user)) %></h1>

      <div class="prose">
        <p><%= t("backup_codes.send_intro") %></p>

        <p><%= t("backup_codes.send_email_hint") %></p>

        <p><%= t("backup_codes.send_warning_html", link: link_to(t("backup_codes.login_history"), user_user_events_path(@user))) %></p>
      </div>

      <%= button_to t("backup_codes.send_button"), recover_user_backup_codes_path(user_id: @user.id), class: "button-primary h-fit", disabled: @user.backup_codes.blank? || @user.email_address.blank? %>
    </div>
  </div>
</div>
