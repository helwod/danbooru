<% page_title t("backup_codes.title") %>

<%= render "users/secondary_links" %>

<div id="c-totp">
  <div id="a-new">
    <div class="card mt-8 p-4 max-w-540px mx-auto flex flex-col gap-4 items-center">
      <h1><%= t("backup_codes.title") %></h1>

      <div class="prose">
        <p>
          <%= t("backup_codes.intro") %>
        </p>

        <p>
          <%= t("backup_codes.save_warning") %>
        </p>

        <hr>

        <p>
          <% @backup_codes.each do |code| %>
            <pre class="block !text-xxl text-center"><%= code %></pre>
          <% end %>
        </p>

        <div class="flex justify-center gap-4" x-data>
          <%= link_to user_backup_codes_path(@user, format: :txt), class: "button-outline-primary", download: "danbooru-backup-codes.txt" do %>
            <%= download_icon %> <%= t("backup_codes.download") %>
          <% end %>

          <%= tag.button class: "button-outline-primary", "x-on:click": "$printPage('#{j user_backup_codes_path(@user, format: :txt)}')" do %>
            <%= print_icon %> <%= t("backup_codes.print") %>
          <% end %>

          <%= tag.button class: "button-outline-primary", "x-on:click": "$copyToClipboard('#{j @backup_codes.join("\n")}')" do %>
            <%= copy_icon %> <%= t("backup_codes.copy") %>
          <% end %>
        </div>

        <hr>
      </div>

      <% if @continue %>
        <%= link_to t("backup_codes.continue"), settings_path, class: "button-primary" %>
      <% else %>
        <%= edit_form_for(:backup_codes, url: user_backup_codes_path(@user), method: "post") do |f| %>
          <%= f.submit_button t("backup_codes.generate") %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-4 flex justify-center">
      <%= link_to t("backup_codes.back_to_settings"), settings_path %>
    </div>
  </div>
</div>
