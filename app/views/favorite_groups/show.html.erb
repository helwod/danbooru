<% page_title t("favorite_groups.show.page_title", name: @favorite_group.pretty_name) %>
<%= render "secondary_links" %>

<div id="c-favorite-groups">
  <div id="a-show">
    <h1>
      <%= t("favorite_groups.show.heading") %>
      <%= link_to @favorite_group.pretty_name, posts_path(:tags => "favgroup:#{@favorite_group.id} status:any") %>
    </h1>

    <%= t("favorite_groups.show.creator", name: link_to_user(@favorite_group.creator)).html_safe %>
    <br>
    <br>

    <%= render BlacklistComponent.new(user: CurrentUser.user, inline: true) %>

    <%= render_post_gallery(@posts, tags: "favgroup:#{@favorite_group.id}", show_deleted: true) do |gallery| %>
      <% gallery.with_footer do %>
        <%= numbered_paginator(@posts) %>
      <% end %>
    <% end %>
  </div>
</div>
