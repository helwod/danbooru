<div id="c-favorite-groups">
  <div id="a-index">
    <%= search_form_for(favorite_groups_path) do |f| %>
      <%= f.input :name_contains, label: t("favorite_groups.index.search_name"), input_html: { value: params.dig(:search, :name_contains), "data-autocomplete": "favorite-group" } %>
      <%= f.input :creator_name, label: t("favorite_groups.index.search_creator"), input_html: { value: params.dig(:search, :creator_name), "data-autocomplete": "user" } %>
      <%= f.input :order, collection: [[t("favorite_groups.index.order_created"), "created_at"], [t("favorite_groups.index.order_updated"), "updated_at"], [t("favorite_groups.index.order_name"), "name"], [t("favorite_groups.index.order_post_count"), "post_count"]], include_blank: true, selected: params.dig(:search, :order) %>
      <%= f.submit t("favorite_groups.index.submit") %>
    <% end %>

    <%= table_for @favorite_groups, width: "100%" do |t| %>
      <% t.column t("favorite_groups.index.column_name"), width: "60%", column: "name" do |favgroup| %>
        <%= link_to favgroup.pretty_name, favorite_group_path(favgroup) %>
        <% if favgroup.post_count > CurrentUser.user.per_page %>
          <%= link_to t("favorite_groups.index.page", page: favgroup.last_page), favorite_group_path(favgroup, :page => favgroup.last_page), :class => "last-page" %>
        <% end %>
      <% end %>
      <% t.column :post_count %>
      <% t.column t("favorite_groups.index.column_creator"), column: "creator" do |favgroup| %>
        <%= link_to_user favgroup.creator %>
        <%= link_to "»", favorite_groups_path(search: { creator_name: favgroup.creator.name }) %>
      <% end %>
      <% t.column t("favorite_groups.index.column_created"), column: "created" do |favgroup| %>
        <%= time_ago_in_words_tagged(favgroup.created_at) %>
      <% end %>
      <% t.column t("favorite_groups.index.column_updated"), column: "updated" do |favgroup| %>
        <%= time_ago_in_words_tagged(favgroup.updated_at) %>
      <% end %>
      <% t.column column: "control" do |favgroup| %>
        <% if policy(favgroup).update? %>
          <%= link_to t("favorite_groups.index.edit"), edit_favorite_group_path(favgroup) %> |
          <%= link_to t("favorite_groups.index.delete"), favorite_group_path(favgroup), method: :delete, remote: true, "data-confirm": t("favorite_groups.index.confirm_delete") %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@favorite_groups) %>

    <%= render "secondary_links" %>
  </div>
</div>
