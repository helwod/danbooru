<p><%= t("favorite_groups.add_to_dialog.new_group_html", link: link_to_wiki("help:favorite_groups")).html_safe %></p>

<% new_favorite_group = FavoriteGroup.new(creator: CurrentUser.user) %>
<%= edit_form_for(new_favorite_group, html: { class: "one-line-form" }) do |f| %>
  <%= f.input :name, as: :string, required: true, input_html: { style: "width: 20em" } %>
  <%= f.input :post_ids, as: :hidden, input_html: { value: post.id } %>
  <%= f.submit_button %>

  <% if policy(new_favorite_group).can_enable_privacy? %>
    <div>
      <%= f.input :is_private, label: t("favorite_groups.form.private"), as: :boolean, hint: t("favorite_groups.form.private_hint") %>
    </div>
  <% end %>
<% end %>

<% if CurrentUser.favorite_groups.present? %>
  <hr class="border">

  <p class="mt-2"><%= t("favorite_groups.add_to_dialog.existing_group") %></p>

  <% CurrentUser.favorite_groups.each_with_index do |favgroup, i| %>
    <div>
      <%= i + 1 %>.
      <%= link_to favgroup.pretty_name,
        favorite_group_path(favgroup),
        id: "add-to-favgroup-#{i + 1}", class: "add-to-favgroup", "data-favgroup-id": favgroup.id,
        "data-shortcut": i > 9 ? nil : (i + 1) % 10, "data-shortcut-when": i > 9 ? nil : ":visible"
      %>
    </div>
  <% end %>
<% end %>
