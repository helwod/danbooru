<% content_for(:secondary_links) do %>
  <%= subnav_link_to t("favorite_groups.secondary_links.listing"), favorite_groups_path, id: "listing" %>
  <% if policy(FavoriteGroup).create? %>
    <%= subnav_link_to t("favorite_groups.secondary_links.new"), new_favorite_group_path, id: "new" %>
  <% end %>
  <%= subnav_link_to t("favorite_groups.secondary_links.help"), wiki_page_path("help:favorite_groups"), id: "help" %>

  <% if @favorite_group && !@favorite_group.new_record? %>
    <%= subnav_divider %>
    <%= subnav_link_to t("favorite_groups.secondary_links.show"), favorite_group_path(@favorite_group), id: "show" %>
    <%= subnav_link_to t("favorite_groups.secondary_links.posts"), posts_path(:tags => "favgroup:#{@favorite_group.id} status:any"), id: "posts" %>
    <% if policy(@favorite_group).update? %>
      <%= subnav_link_to t("favorite_groups.secondary_links.edit"), edit_favorite_group_path(@favorite_group), "data-shortcut": "e", id: "edit" %>
      <%= subnav_link_to t("favorite_groups.secondary_links.delete"), favorite_group_path(@favorite_group), :method => :delete, :data => {:shortcut => "shift+d", :confirm => t("favorite_groups.secondary_links.confirm_delete")}, id: "delete" %>
      <% if @favorite_group.post_count <= 100 %>
        <%= subnav_link_to t("favorite_groups.secondary_links.order"), edit_favorite_group_order_path(@favorite_group), id: "order" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
