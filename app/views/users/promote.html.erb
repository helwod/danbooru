<% page_title t("users.promote_title") %>
<%= render "secondary_links" %>

<div id="c-users">
  <div id="a-promote">
    <div class="card mt-4 p-4 max-w-540px mx-auto flex flex-col gap-2">
      <h1 class="text-center"><%= t("users.promote_heading_html", user: link_to_user(@user)) %></h1>

      <p class="prose">
        <%= t("users.promote_notice_html", user: link_to_user(@user), link: link_to_wiki("help:users")) %>
      </p>

      <%= edit_form_for(@user, url: admin_user_path(@user)) do |f| %>
        <%= f.input :level, collection: User.level_hash.select { |name, level| level > @user.level && level < CurrentUser.user.level }.to_a, include_blank: false %>
        <%= f.submit_button t("users.promote"), "data-confirm": t("users.promote_confirm", name: @user.name) %>
      <% end %>
    </div>
  </div>
</div>
