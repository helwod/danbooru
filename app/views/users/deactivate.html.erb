<% page_title t("users.deactivate_title") %>
<%= render "secondary_links" %>

<div id="c-users">
  <div id="a-deactivate">
    <div class="card mt-4 p-4 max-w-540px mx-auto flex flex-col gap-2">
      <% if @user == CurrentUser.user %>
        <h1 class="text-center"><%= t("users.deactivate_title") %></h1>

        <div class="prose">
          <p>
            <%= t("users.deactivate_intro") %>

          </p><%= t("users.deactivate_effects_intro") %></p>

          <ul>
            <li><%= t("users.deactivate_effect_name_html", id: @user.id) %></li>
            <li><%= t("users.deactivate_effect_credentials_html", link: link_to_wiki(t("users.api_keys"), "help:api")) %></li>
            <li><%= t("users.deactivate_effect_saved_searches_html", link: link_to_wiki(t("users.saved_searches"), "help:saved_searches")) %></li>
            <li><%= t("users.deactivate_effect_favgroups_html", link: link_to_wiki(t("users.private_favorite_groups"), "help:favorite_groups")) %></li>
            <% if @user.enable_private_favorites %>
              <li><%= t("users.deactivate_effect_favorites") %></li>
            <% end %>
          </ul>

          <p>
            <%= t("users.deactivate_kept_intro_html") %>
          </p>

          <ul>
            <li><%= t("users.deactivate_kept_posts") %></li>
            <li><%= t("users.deactivate_kept_discussion") %></li>
            <li><%= t("users.deactivate_kept_contributions") %></li>
            <li><%= t("users.deactivate_kept_login_history") %></li>
          </ul>

          <p><%= t("users.deactivate_change_name_html", link: link_to(t("users.change_name_here"), change_name_user_path(@user))) %></p>

          <p>
            <%= t("users.deactivate_warning") %>
          </p>
        </div>

        <%= edit_form_for(:user, url: user_path(@user), method: :delete) do |f| %>
          <%= f.input :password, as: :password, input_html: { autofocus: true, autocomplete: "current-password" }, hint: link_to(t("users.forgot_password"), password_reset_path).html_safe %>
          <%= f.submit t("users.deactivate_submit"), class: "button-danger", "data-confirm": t("users.deactivate_confirm_self") %>
        <% end %>
      <% else %>
        <h1 class="text-center"><%= t("users.deactivate_heading_html", user: link_to_user(@user)) %></h1>

        <div class="prose">
          <p><%= t("users.deactivate_other_notice_html", user: link_to_user(@user)) %></p>

          <p><%= t("users.deactivate_other_effects_html", id: @user.id) %></p>
        </div>

        <%= edit_form_for(:user, url: user_path(@user), method: :delete) do |f| %>
          <%= f.submit t("users.deactivate_submit"), class: "button-danger", "data-confirm": t("users.deactivate_confirm_other", name: @user.name) %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
