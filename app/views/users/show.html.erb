<% page_title "@#{@user.pretty_name}" %>
<%= render "secondary_links" %>

<div id="c-users">
  <div id="a-show">
    <%= render UserProfileComponent.new(user: @user, current_user: CurrentUser.user, show_votes: show_votes?) %>
  </div>
</div>

<% if Danbooru.config.comments_enabled?.to_s.truthy? %>
  <% atom_feed_tag t("users.atom.comments_on_uploads", name: @user.pretty_name), comments_url(:atom, search: { post_tags_match: "user:#{@user.name}" }) %>
  <% atom_feed_tag t("users.atom.comments_by_user", name: @user.pretty_name), comments_url(:atom, search: { post_tags_match: "commenter:#{@user.name}" }) %>
<% end %>
