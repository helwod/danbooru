<% page_title t("users.settings") %>
<%= render "secondary_links" %>

<div id="c-users">
  <div id="a-edit">
    <h1 class="mb-4"><%= t("users.settings") %></h1>

    <%= render(TabPanelComponent.new(classes: "horizontal-tab-panel fixed-width-container") do |t| %>
      <% t.panel(t("users.tabs.basic"), id: "basic-tab", active: true) do %>
        <%= edit_form_for @user, formatted_errors: true do |f| %>
          <div id="basic-settings-section">
            <div class="input">
              <label><%= t("users.username") %></label>
              <p><%= link_to t("users.change_name"), change_name_user_path(@user) %></p>
            </div>

            <div class="input">
              <label><%= t("users.email") %></label>
              <p>
                <% if @user.email_address.present? %>
                  <%= @user.email_address.address %>

                  <% if @user.email_address.is_verified %>
                    (<%= link_to t("users.change_email"), edit_user_email_path(@user) %>)
                  <% else %>
                    (<%= link_to t("users.change_email"), edit_user_email_path(@user) %> | <%= link_to t("users.verify_email"), verify_user_email_path(@user) %>)
                  <% end %>
                <% else %>
                  <%= link_to t("users.add_email"), edit_user_email_path(@user) %>
                <% end %>
              </p>
            </div>

            <%= f.input :theme,
              as: :radio_buttons,
              boolean_style: :nested,
              collection: User.themes.keys,
              collection_wrapper_tag: "div",
              collection_wrapper_class: "flex flex-wrap",
              item_wrapper_class: "theme-swatch w-16",
              item_label_class: "cursor-pointer !m-0",
              input_html: { class: "hidden", "x-on:change": "Danbooru.CurrentUser.theme = $el.value" },
              label_method: ->(theme) {
                tag.div(class: "theme-swatch-preview mx-auto w-12 h-12 rounded-lg", data: { current_user_theme: theme }) +
                  tag.div(theme.titleize, class: "mt-2 text-xs text-center text-balance leading-normal")
              }
            %>

            <%= f.input :enable_safe_mode, as: :boolean, wrapper: "stacked-toggle-switch", label: t("users.safe_mode"), hint: t("users.safe_mode_hint") %>
            <%= f.input :per_page, label: t("users.posts_per_page"), hint: t("users.posts_per_page_hint", max: PostSets::Post::MAX_PER_PAGE), input_html: { min: 1, max: PostSets::Post::MAX_PER_PAGE } %>
            <%= f.input :default_image_size, hint: t("users.default_image_width_hint", width: Danbooru.config.large_image_width), label: t("users.default_image_width"), collection: [["850px", "large"], [t("users.original_size"), "original"]], include_blank: false %>
            <%= f.input :receive_email_notifications, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.receive_email_notifications_hint") %>
            <%= f.input :time_zone, include_blank: false, hint: t("users.time_zone_hint") %>
            <%= f.input :comment_threshold, hint: t("users.comment_threshold_hint"), input_html: { min: -100, max: 5 } %>
            <%= f.input :blacklisted_tags, hint: t("users.blacklisted_tags_hint_html"), :input_html => { :data => {:autocomplete => "tag-query"}} %>
          </div>

          <%= f.submit_button %>
        <% end %>
      <% end %>

      <% t.panel(t("users.tabs.advanced"), id: "advanced-tab") do %>
        <%= edit_form_for @user, formatted_errors: true do |f| %>
          <div id="advanced-settings-section">
            <div class="input">
              <label><%= t("users.account") %></label>
              <p>
                <%= link_to t("users.deactivate_submit"), deactivate_user_path(@user), id: "delete-account" %>
                (<em><%= t("users.requires_confirmation") %></em>)
              </p>
            </div>

            <%= f.input :new_post_navigation_layout, :as => :select, :label => t("users.nav_bar_position"), :include_blank => false, :collection => [[t("users.position.below"), "true"], [t("users.position.above"), "false"]], :hint => t("users.nav_bar_position_hint") %>
            <%= f.input :show_deleted_posts, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.show_deleted_posts_hint") %>
            <%= f.input :show_deleted_children, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.show_deleted_children_hint") %>
            <%= f.input :disable_categorized_saved_searches, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.disable_categorized_saved_searches_hint") %>
            <% if policy(@user).can_enable_private_favorites? %>
              <%= f.input :enable_private_favorites, label: t("users.private_favorites"), as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.private_favorites_hint") %>
            <% elsif @user.enable_private_favorites? %>
              <%= f.input :enable_private_favorites, label: t("users.private_favorites"), as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.private_favorites_gold_hint_html", upgrade: link_to(t("users.upgrading_to_gold"), new_user_upgrade_path), learn_more: link_to_wiki(t("users.learn_more"), "help:privacy_mode")) %>
            <% else %>
              <%= f.input :enable_private_favorites, label: t("users.private_favorites"), as: :boolean, wrapper: "stacked-toggle-switch", hint: link_to(t("users.upgrade_to_enable_private_favorites"), new_user_upgrade_path) %>
            <% end %>
            <%= f.input :disable_tagged_filenames, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.disable_tagged_filenames_hint") %>
            <%= f.input :disable_mobile_gestures, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.disable_mobile_gestures_hint") %>
            <%= f.input :disable_post_tooltips, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.disable_post_tooltips_hint") %>
            <%= f.input :enable_desktop_mode, as: :boolean, wrapper: "stacked-toggle-switch", hint: t("users.enable_desktop_mode_hint") %>

            <%= f.input :favorite_tags, :label => t("users.frequent_tags"), :hint => t("users.frequent_tags_hint"), :input_html => { :data => { :autocomplete => "tag-query" } } %>
            <%= f.input :custom_style, :label => t("users.custom_style"), :hint => t("users.custom_style_hint") %>
          </div>
          <%= f.submit_button %>
        <% end %>
      <% end %>

      <% t.panel(t("users.tabs.security"), id: "security-tab") do %>
        <div class="space-y-4">
          <div class="flex justify-between gap-4">
            <div>
              <span class="font-bold leading-normal"><%= t("users.password") %></span>
              <p class="fineprint max-w-360px"><%= t("users.update_password") %></p>
            </div>

            <div>
              <%= link_to t("users.change_password"), edit_user_password_path(user_id: @user.id), class: "button-primary" %>
            </div>
          </div>

          <div class="flex justify-between gap-4">
            <div>
              <div class="mb-1">
                <span class="font-bold leading-normal"><%= t("users.two_factor_authentication") %></span>

                <% if @user.totp.present? %>
                  <span class="chip-green text-success text-xs"><%= t("users.enabled") %></span>
                <% else %>
                  <span class="chip-red text-error text-xs"><%= t("users.disabled") %></span>
                <% end %>
              </div>

              <p class="fineprint max-w-360px"><%= t("users.two_factor_description") %></p>
            </div>

            <div>
              <% if @user.totp.present? %>
                <%= link_to t("users.disable"), edit_user_totp_path(user_id: @user.id), class: "button-outline-danger" %>
              <% else %>
                <%= link_to t("users.enable"), edit_user_totp_path(user_id: @user.id), class: "button-primary" %>
              <% end %>
            </div>
          </div>

          <% if @user.totp.present? %>
            <div class="flex justify-between gap-4">
              <div>
                <span class="font-bold leading-normal"><%= t("users.backup_codes") %></span>
                <p class="fineprint max-w-360px"><%= t("users.backup_codes_description") %></p>
              </div>

              <div>
                <%= link_to t("users.view"), user_backup_codes_path(@user), class: "button-primary" %>
              </div>
            </div>
          <% end %>

          <div class="flex justify-between gap-4">
            <div>
              <span class="font-bold leading-normal"><%= t("users.account_history") %></span>

              <div class="fineprint max-w-360px">
                <%= t("users.account_history_description") %><br>
              </div>

              <% if @user.user_events.last.present? %>
                <div class="fineprint max-w-360px">
                  <%= t("users.last_activity", time: time_ago_in_words_tagged(@user.user_events.last.created_at)) %>
                </div>
              <% end %>
            </div>

            <div>
              <%= link_to t("users.view"), user_user_events_path(@user), class: "button-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    <% end) %>
  </div>
</div>
