<%# user %>

<% if user.is_contributor? %>
  none
<% else %>
  <%= link_to user.upload_limit.used_upload_slots, posts_path(tags: "user:#{user.name} status:pending") %> /
  <% if user.upload_limit.maxed? %>
    <%= tag.abbr user.upload_limit.upload_slots, title: t("users.upload_limit.max_reached") %>
  <% else %>
    <%= tag.abbr user.upload_limit.upload_slots, title: t("users.upload_limit.approvals_needed", count: user.upload_limit.approvals_for_next_level - user.upload_limit.approvals_on_current_level, current: user.upload_limit.approvals_on_current_level, total: user.upload_limit.approvals_for_next_level) %>
  <% end %>
<% end %>

(<%= link_to_wiki t("users.help"), "help:upload_limits" %>)
