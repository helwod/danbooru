<%= render "wiki_pages/sidebar" %>

<% content_for(:content) do %>
  <div class="fixed-width-container">
    <%= render "wiki_page_versions/navbar", wiki_page_version: @wiki_page_version %>

    <h1 id="wiki-page-title"><%= link_to_wiki @wiki_page_version.pretty_title, @wiki_page_version.title, class: "tag-type-#{@wiki_page_version.wiki_page.tag&.category.to_i}" %></h1>

    <p class="fineprint">
      <%= @wiki_page_version.previous ? t("wiki_page_versions.show.edited") : t("wiki_page_versions.show.created") %>
      <%= link_to humanized_time(@wiki_page_version.updated_at), diff_wiki_page_versions_path(thispage: @wiki_page_version.id) %> <%= t("wiki_page_versions.show.by", name: link_to_user(@wiki_page_version.updater)).html_safe %>.

      <% if @wiki_page_version.previous %>
        <%= t("wiki_page_versions.show.previously_edited", time: link_to(humanized_time(@wiki_page_version.previous.updated_at), diff_wiki_page_versions_path(thispage: @wiki_page_version.previous.id)), name: link_to_user(@wiki_page_version.previous.updater)).html_safe %>.
      <% end %>
    </p>

    <% if @wiki_page_version.other_names.present? %>
      <%= wiki_page_other_names_list(@wiki_page_version) %>
    <% end %>

    <div id="wiki-page-body" class="dtext prose">
      <%= @wiki_page_version.dtext_body.format_text %>
    </div>
  </div>
<% end %>

<%= render "wiki_pages/secondary_links" %>
