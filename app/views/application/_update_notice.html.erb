<%# record, interval, current_user %>

<% if record.nil? %>
<% elsif record.respond_to?(:updater_id) && record.updater_id != record.creator_id  %>
  <% if record.updater.is_moderator? && !policy(record).can_see_updater_notice? %>
    <p class="fineprint edit-notice my-2"><%= t("application.update_notice.by_moderator", action: record.try(:is_deleted?) ? t("application.update_notice.deleted") : t("application.update_notice.updated"), time: time_ago_in_words_tagged(record.updated_at)) %></p>
  <% else %>
    <p class="fineprint edit-notice my-2"><%= t("application.update_notice.by_user_html", action: record.try(:is_deleted?) ? t("application.update_notice.deleted") : t("application.update_notice.updated"), user: link_to_user(record.updater), time: time_ago_in_words_tagged(record.updated_at)) %></p>
  <% end %>
<% elsif record.updated_at - record.created_at > (local_assigns[:interval] || 5.minutes) %>
  <% if record.respond_to?(:updater_id) %>
    <p class="fineprint edit-notice my-2"><%= t("application.update_notice.by_user_html", action: record.try(:is_deleted?) ? t("application.update_notice.deleted") : t("application.update_notice.updated"), user: link_to_user(record.updater), time: time_ago_in_words_tagged(record.updated_at)) %></p>
  <% else %>
    <p class="fineprint edit-notice my-2"><%= t("application.update_notice.by_time", action: record.try(:is_deleted?) ? t("application.update_notice.deleted") : t("application.update_notice.updated"), time: time_ago_in_words_tagged(record.updated_at)) %></p>
  <% end %>
<% end %>
