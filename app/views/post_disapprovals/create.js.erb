<% if @post_disapproval.errors.any? %>
  if ($("#c-modqueue").length) {
    $("#post_<%= @post_disapproval.post.id %>").hide();
    Danbooru.Notice.error("<%= j format_text(t("post_disapprovals.create.error_on_post", id: @post_disapproval.post.id, message: @post_disapproval.errors.full_messages.join("; ")), inline: true) %>");
  } else {
    Danbooru.Notice.error("<%= j t("post_disapprovals.create.error", message: @post_disapproval.errors.full_messages.join("; ")) %>");
  }
<% else %>
  if ($("#c-posts #a-show").length) {
    location.reload();
  } else if ($("#c-modqueue").length) {
    $("#post_<%= @post_disapproval.post.id %>").hide();
    Danbooru.Notice.info("<%= j format_text(t("post_disapprovals.create.#{@post_disapproval.reason == "disinterest" ? "skipped" : "rejected"}", id: @post_disapproval.post.id), inline: true) %>");
  }
<% end %>
