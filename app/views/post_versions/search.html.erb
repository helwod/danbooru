<div id="c-post-versions">
  <div id="a-search">
    <h1><%= t("post_versions.search.title") %></h1>

    <%= search_form_for(post_versions_path) do |f| %>
      <%= f.input :updated_at, label: t("post_versions.search.date"), input_html: { value: params.dig(:search, :updated_at) } %>
      <%= f.input :updater_name, label: t("post_versions.search.updater"), input_html: { value: params.dig(:search, :updater_name), "data-autocomplete": "user" } %>
      <%= f.input :added_tags_include_all, label: t("post_versions.search.added_tags"), input_html: { value: params.dig(:search, :added_tags_include_all), "data-autocomplete": "tag-query" } %>
      <%= f.input :removed_tags_include_all, label: t("post_versions.search.removed_tags"), input_html: { value: params.dig(:search, :removed_tags_include_all), "data-autocomplete": "tag-query" } %>
      <%= f.input :all_changed_tags, label: t("post_versions.search.all_changed_tags"), input_html: { "data-autocomplete": "tag-query", value: params.dig(:search, :all_changed_tags) }, hint: t("post_versions.search.all_changed_tags_hint") %>
      <%= f.input :any_changed_tags, label: t("post_versions.search.any_changed_tags"), input_html: { "data-autocomplete": "tag-query", value: params.dig(:search, :any_changed_tags) }, hint: t("post_versions.search.any_changed_tags_hint") %>
      <%= f.input :post_id, input_html: { value: params.dig(:search, :post_id) } %>
      <%= f.input :parent_id, input_html: { value: params.dig(:search, :parent_id) } %>
      <%= f.input :rating, input_html: { value: params.dig(:search, :rating) } %>
      <%= f.input :source_ilike, label: t("post_versions.search.source"), input_html: { value: params.dig(:search, :source_ilike) } %>
      <%= f.input :tag_matches, input_html: { value: params.dig(:search, :tag_matches) }, hint: t("post_versions.search.tag_matches_hint") %>
      <%= f.input :version, input_html: { value: params.dig(:search, :version) } %>
      <%= f.input :is_new, label: t("post_versions.search.include_uploads"), collection: [[t("post_versions.search.yes"), nil], [t("post_versions.search.no"), false], [t("post_versions.search.only"), true]], include_blank: false, selected: params.dig(:search, :is_new), hint: t("post_versions.search.include_uploads_hint") %>
      <%= f.input :rating_changed, as: :select, include_blank: true, selected: params.dig(:search, :rating_changed) %>
      <%= f.input :parent_changed, as: :select, include_blank: true, selected: params.dig(:search, :parent_changed) %>
      <%= f.input :source_changed, as: :select, include_blank: true, selected: params.dig(:search, :source_changed) %>
      <%= f.submit t("post_versions.search.submit") %>
    <% end %>
  </div>
</div>

<%= render "secondary_links" %>
