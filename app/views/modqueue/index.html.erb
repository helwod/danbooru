<% page_title t("modqueue.title") %>

<% content_for(:top_content) do %>
  <h1 class="mb-4"><%= t("modqueue.title") %></h1>

  <div class="prose mb-4">
    <details>
      <summary><%= t("modqueue.guidelines") %></summary>

      <div>
        <ul>
          <li><%= t("modqueue.guideline_approve") %></li>
          <li><%= t("modqueue.guideline_skip") %></li>
          <li><%= t("modqueue.guideline_reject") %></li>
          <li><%= t("modqueue.guideline_detailed_rejection") %></li>
          <li><%= t("modqueue.guideline_delete_html", link: link_to_wiki(t("modqueue.upload_rules"), "help:upload rules")) %></li>
          <li><%= t("modqueue.guideline_inactivity") %></li>
        <ul>
      </div>
    </details>
  </div>
<% end %>

<% content_for(:content) do %>
  <div class="tab-panel-component horizontal-tab-panel">
    <div class="tab-list">
      <%= link_to t("modqueue.tab_new"), current_page_path(search: search_params.except(:modqueue, :order)), class: [(search_params[:modqueue].nil? ? "tab active-tab" : "tab")] %>
      <%= link_to t("modqueue.tab_seen"), current_page_path(search: search_params.merge(modqueue: :seen, order: "disapproved")), class: [(search_params[:modqueue] == "seen" ? "tab active-tab" : "tab")] %>

      <span class="flex-grow-1"></span>

      <%= render PreviewSizeMenuComponent.new(current_size: preview_size) %>

      <% if @mode == "gallery" %>
        <%= link_to list_icon, current_page_path(mode: "list"), title: t("modqueue.list"), class: "tab" %>
      <% else %>
        <%= link_to grid_icon, current_page_path(mode: nil), title: t("modqueue.gallery"), class: "tab" %>
      <% end %>
    </div>
  </div>

  <% if @mode == "gallery" %>
    <%= render(PostGalleryComponent.new(size: preview_size)) do |gallery| %>
      <% @posts.each do |post| %>
        <% gallery.with_post(post: post, size: preview_size, classes: "card mod-queue-preview p-2", show_deleted: true) do |preview| %>
          <% preview.with_footer do %>
            <%= render "modqueue/post_preview_footer", post: post %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="flex flex-col gap-4">
      <% @posts.each do |post| %>
        <%= render "modqueue/post", post: post %>
      <% end %>
    </div>
  <% end %>

  <%= numbered_paginator(@posts) %>
<% end %>

<%= render "modqueue/sidebar" %>
<%= render "post_disapprovals/detailed_rejection_dialog" %>
<%= render "modqueue/secondary_links" %>
