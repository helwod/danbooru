<div id="c-user-feedbacks">
  <div id="a-new" class="fixed-width-container">
    <h1><%= t("user_feedbacks.new_title") %></h1>

    <div class="fixed-width-container">
      <p><%= t("user_feedbacks.new_negative_notice_html", link: link_to_wiki(t("user_feedbacks.site_rules"), "help:community rules")) %></p>

      <p><%= t("user_feedbacks.new_neutral_notice") %></p>

      <p><%= t("user_feedbacks.new_help_notice_html", link: link_to_wiki(t("user_feedbacks.user_records_link"), "help:user records")) %></p>
    </div>

    <div id="preview">
    </div>

    <%= edit_form_for(@user_feedback) do |f| %>
      <%= f.input :user_name, :label => t("user_feedbacks.user"), :input_html => { value: @user_feedback.user.try(:name), data: { autocomplete: "user" } } %>
      <%= f.input :category, :collection => ["positive", "neutral", "negative"].map { |category| [t("user_feedbacks.categories.#{category}", default: category.capitalize), category] }, :include_blank => false %>
      <%= f.input :body, as: :dtext %>
      <%= f.submit_button %>
    <% end %>
  </div>
</div>

<%= render "secondary_links" %>
