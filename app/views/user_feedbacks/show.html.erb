<% page_title t("user_feedbacks.show_title", name: @user_feedback.user.name) %>
<%= render "secondary_links" %>

<div id="c-user-feedbacks">
  <div id="a-show">
    <h1><%= t("user_feedbacks.show_heading_html", user: link_to_user(@user_feedback.user)) %></h1>

    <ul>
      <li><strong><%= t("user_feedbacks.creator") %></strong> <%= link_to_user @user_feedback.creator %></li>
      <li><strong><%= t("user_feedbacks.date") %></strong> <%= @user_feedback.created_at %></li>
      <li><strong><%= t("user_feedbacks.category") %></strong> <%= @user_feedback.category %></li>
      <li>
        <strong><%= t("user_feedbacks.message") %></strong>
        <div class="prose">
          <%= @user_feedback.dtext_body.format_text %>
        </div>
      </li>
    </ul>

    <%= render "application/update_notice", record: @user_feedback, interval: 0.minutes, current_user: CurrentUser.user %>
  </div>
</div>
