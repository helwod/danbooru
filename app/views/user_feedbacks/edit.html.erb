<div id="c-user-feedbacks">
  <div id="a-edit">
    <h1><%= t("user_feedbacks.edit_title") %></h1>

    <div id="preview">
    </div>

    <%= edit_form_for(@user_feedback) do |f| %>
      <%= f.input :category, :collection => ["positive", "neutral", "negative"], :include_blank => false %>
      <%= f.input :body, as: :dtext, input_html: { autofocus: true } %>
      <%= f.input :is_deleted, label: t("user_feedbacks.deleted") %>
      <%= f.submit_button %>
    <% end %>
  </div>
</div>

<%= render "secondary_links" %>
