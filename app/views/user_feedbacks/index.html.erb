<div id="c-user-feedbacks">
  <div id="a-index">
    <h1><%= t("user_feedbacks.title") %></h1>

    <%= search_form_for(user_feedbacks_path) do |f| %>
      <%= f.input :user_name, input_html: { value: params.dig(:search, :user_name), "data-autocomplete": "user" } %>
      <%= f.input :creator_name, input_html: { value: params.dig(:search, :creator_name), "data-autocomplete": "user" } %>
      <%= f.input :body_matches, label: t("user_feedbacks.message"), input_html: { value: params.dig(:search, :body_matches) } %>
      <%= f.input :category, collection: %w[positive neutral negative].map { |category| [t("user_feedbacks.categories.#{category}", default: category.capitalize), category] }, include_blank: true, selected: params.dig(:search, :category) %>
      <%= f.input :hide_bans, label: t("user_feedbacks.hide_bans"), collection: [t("user_feedbacks.no_label"), t("user_feedbacks.yes_label")], selected: params.dig(:search, :hide_bans) %>
      <% if policy(UserFeedback).can_view_deleted? %>
        <%= f.input :is_deleted, label: t("user_feedbacks.deleted"), collection: [t("user_feedbacks.yes_label"), t("user_feedbacks.no_label")], include_blank: true, selected: params.dig(:search, :is_deleted) %>
      <% end %>
      <%= f.submit t("user_feedbacks.search") %>
    <% end %>

    <%= table_for @user_feedbacks, class: "striped autofit" do |t| %>
      <% t.column t("user_feedbacks.user"), column: "user" do |feedback| %>
        <%= link_to_user feedback.user %>
        <%= link_to "»", user_feedbacks_path(search: { user_name: feedback.user.name }) %>
      <% end %>
      <% t.column t("user_feedbacks.message"), td: {class: "col-expand"}, column: "message" do |feedback| %>
        <div class="prose">
          <%= feedback.dtext_body.format_text %>
        </div>
        <%= render "application/update_notice", record: feedback, interval: 0.minutes, current_user: CurrentUser.user %>
      <% end %>
      <% if policy(UserFeedback).can_view_deleted? %>
        <% t.column t("user_feedbacks.status"), column: "status" do |feedback| %>
          <%= t("user_feedbacks.deleted") if feedback.is_deleted? %>
        <% end %>
      <% end %>
      <% t.column t("user_feedbacks.category"), column: "category" do |feedback| %>
        <%= link_to t("user_feedbacks.categories.#{feedback.category}", default: feedback.category.capitalize), user_feedbacks_path(search: { category: feedback.category }) %>
      <% end %>
      <% t.column t("user_feedbacks.creator"), column: "creator" do |feedback| %>
        <%= link_to_user feedback.creator %>
        <%= link_to "»", user_feedbacks_path(search: { creator_name: feedback.creator.name }) %>
        <div><%= time_ago_in_words_tagged(feedback.created_at) %></div>
      <% end %>
      <% t.column column: "control" do |feedback| %>
        <% if policy(feedback).update? %>
          <%= link_to t("user_feedbacks.edit_link"), edit_user_feedback_path(feedback) %>
          <% if feedback.is_deleted? %>
            | <%= link_to t("user_feedbacks.undelete"), user_feedback_path(feedback), method: :put, remote: true, "data-params": "user_feedback[is_deleted]=false" %>
          <% else %>
            | <%= link_to t("user_feedbacks.delete"), user_feedback_path(feedback), method: :put, remote: true, "data-params": "user_feedback[is_deleted]=true", "data-confirm": t("user_feedbacks.delete_confirm") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@user_feedbacks) %>
  </div>
</div>

<%= render "secondary_links" %>
