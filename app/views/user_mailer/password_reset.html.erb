<h2><%= t("user_mailer.greeting_html", user: link_to_user(@user)) %></h2>

<p>
  <%= t("user_mailer.password_reset.requested_html", app_name: Danbooru.config.canonical_app_name) %>
</p>

<p style="margin-left: 2em">
  <%= link_to t("user_mailer.password_reset.reset_password"), edit_password_reset_url(user: { signed_id: @user.generate_token_for(:password_reset) }) %>
</p>

<p class="fineprint">
  <%= t("user_mailer.password_reset.notice_line1_html", app_name: link_to(Danbooru.config.canonical_app_name, root_url)) %><br>
  <%= t("user_mailer.password_reset.notice_line2") %>
</p>
