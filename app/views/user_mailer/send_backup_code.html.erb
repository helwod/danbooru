<h2><%= t("user_mailer.greeting_plain", user: @user.pretty_name) %></h2>

<p><%= t("user_mailer.send_backup_code.here_is_code") %></p>

<p style="font-size: 28px; text-align: center;"><%= @backup_code.to_s.rjust(User::BACKUP_CODE_LENGTH, "0") %></p>

<p>
  <%= t("user_mailer.send_backup_code.usage") %>
</p>

<p>
  <%= t("user_mailer.send_backup_code.after_change") %>
</p>

<div style="text-align: center">
  <%= link_to t("user_mailer.send_backup_code.login"), login_url, style: "display: inline-block; padding: 8px 16px; border-radius: 4px; color: white; background-color: #0075f8;" %>
  <%= link_to t("user_mailer.send_backup_code.update_2fa"), edit_user_totp_url(@user), style: "display: inline-block; padding: 8px 16px; border-radius: 4px; color: white; background-color: #0075f8;" %>
  <%= link_to t("user_mailer.send_backup_code.view_backup_codes"), user_backup_codes_url(@user), style: "display: inline-block; padding: 8px 16px; border-radius: 4px; color: white; background-color: #0075f8;" %>
</div>

<p class="fineprint">
  <%= t("user_mailer.send_backup_code.notice") %>
</p>
