<p><%= t("user_mailer.dmca_complaint.submitted", email: Danbooru.config.dmca_email) %></p>

<p><%= t("user_mailer.dmca_complaint.name", name: @dmca[:name]) %></p>
<p><%= t("user_mailer.dmca_complaint.email", email: @dmca[:email]) %></p>
<p><%= t("user_mailer.dmca_complaint.address", address: @dmca[:address]) %></p>

<p><%= t("user_mailer.dmca_complaint.infringing_urls") %></p>
<ul>
  <% @dmca[:infringing_urls].to_s.split.each do |url| %>
    <li><%= url %></li>
  <% end %>
</ul>

<p><%= t("user_mailer.dmca_complaint.original_urls") %></p>
<ul>
  <% @dmca[:original_urls].to_s.split.each do |url| %>
    <li><%= url %></li>
  <% end %>
</ul>

<p><%= t("user_mailer.dmca_complaint.proof", proof: @dmca[:proof]) %></p>
<p><%= t("user_mailer.dmca_complaint.signature", signature: @dmca[:signature]) %></p>
