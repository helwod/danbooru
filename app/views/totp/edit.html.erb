<% page_title t("totp.setup_title") %>

<%= render "users/secondary_links" %>

<div id="c-totp">
  <div id="a-new">
    <div class="card mt-8 p-4 max-w-540px mx-auto flex flex-col items-center">
      <h1 class="pb-4"><%= t("totp.heading") %></h1>

      <% if @user.totp.present? %>
        <p class="w-full"><%= t("totp.enabled_html") %></p>

        <p class="w-full"><%= t("totp.disable_hint_html") %></p>
      <% else %>
        <p class="w-full">
          <%= t("totp.enable_intro") %>
        </p>

        <p class="w-full">
          <%= t("totp.get_started_html",
                google: external_link_to("https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2", "Google Authenticator", class: "break-words"),
                microsoft: external_link_to("https://www.microsoft.com/en-us/security/mobile-authenticator-app", "Microsoft Authenticator", class: "break-words")) %>
        </p>
      <% end %>

      <div class="card p-2 mb-2">
        <%= @totp.qr_code.as_svg(offset: 8, module_size: 4, fill: :white).html_safe %>
      </div>

      <div x-data="{ open: false }">
        <a href="#" @click.prevent="open = true" class="text-xs" x-show="!open"><%= t("totp.cannot_scan") %></a>

        <div class="prose" x-show="open" x-cloak>
          <p><%= t("totp.manual_entry") %></p>

          <code class="block text-center"><%= @totp.secret %></code>
        </div>
      </div>

      <div class="prose w-full mb-4">
        <hr>
      </div>

      <% if @user.totp.present? %>
        <%= edit_form_for(@totp, url: user_totp_path(@user), method: "delete", html: { class: "w-full stacked-form stacked-hints", "data-validate-form": "true" }) do |f| %>
          <%= f.submit t("totp.disable"), class: "button-outline-danger" %>
        <% end %>
      <% else %>
        <%= edit_form_for(@totp, url: user_totp_path(@user), method: "put", html: { class: "w-full stacked-form stacked-hints", "data-validate-form": "true" }) do |f| %>
          <%= f.input :signed_secret, as: :hidden, input_html: { value: @totp.signed_secret } %>
          <%= f.input :verification_code, placeholder: "123456", hint: t("totp.code_hint"), required: true, minlength: 6, maxlength: 6, pattern: '\d+', input_html: { value: nil } %>
          <p class="text-sm text-muted"><%= t("totp.enable_notice") %></p>
          <%= f.submit_button t("totp.enable"), disabled: true %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-4 flex justify-center">
      <%= link_to t("totp.back_to_settings"), settings_path %>
    </div>
  </div>
</div>
