<% page_title @forum_topic.title %>
<% meta_description(DText.new(@forum_topic.original_post&.body).excerpt) %>

<% atom_feed_tag(@forum_topic.title, forum_topic_url(@forum_topic.id, format: :atom)) %>
<%= render "secondary_links" %>

<div id="c-forum-topics">
  <div id="a-show">
    <h1>
      <%= @forum_topic.title %>

      <% if @forum_topic.is_private? %>
        <span class="level-topic"><%= t("forum_topics.show.min_level_only", level: @forum_topic.min_level.downcase) %></span>
      <% end %>

      <% if @forum_topic.is_deleted? %>
        <span class="locked-topic"><%= t("forum_topics.show.deleted") %></span>
      <% end %>
    </h1>

    <p class="fineprint"><%= t("forum_topics.show.posted_under_html", link: link_to(@forum_topic.category, forum_topics_path(search: { category_id: @forum_topic.category_id }))).html_safe %></p>

    <% if @forum_topic.is_locked? %>
      <div class="notice">
        <p><%= t("forum_topics.show.locked_notice") %></p>
      </div>
    <% end %>

    <div class="list-of-forum-posts list-of-messages">
      <%= render ForumPostComponent.with_collection(@forum_posts, forum_topic: @forum_topic, current_user: CurrentUser.user) %>
    </div>

    <% if policy(ForumPost.new(topic: @forum_topic)).create? %>
      <p><%= link_to t("forum_topics.show.post_reply"), new_forum_post_path(topic_id: @forum_topic.id), id: "new-response-link" %></p>

      <div style="display: none;" id="topic-response">
        <%= render "forum_posts/partials/new/form", forum_post: ForumPost.new(topic_id: @forum_topic.id), inline: true %>
      </div>
    <% end %>

    <%= numbered_paginator(@forum_posts) %>
  </div>
</div>
