<% page_title t("forum_topics.index.page_title") %>

<% atom_feed_tag t("forum_topics.index.atom_feed"), forum_topics_url(:atom, search: params.fetch(:search, {}).permit!) %>
<%= render "secondary_links" %>

<div id="c-forum-topics">
  <div id="a-index">
    <h1><%= t("forum_topics.index.page_title") %></h1>

    <p>
      <%= t("forum_topics.index.categories") %>
      <%= link_to t("forum_topics.index.all"), forum_topics_path %>,
      <%= link_to t("forum_topics.index.new"), forum_topics_path(search: { is_read: false }) %>,
      <% if CurrentUser.user.is_builder? %>
        <%= link_to t("forum_topics.index.private"), forum_topics_path(search: { is_private: true }) %>,
      <% end %>
      <%= ForumTopic.categories.map { |name, id| link_to_unless_current(name, forum_topics_path(search: { category_id: id })) }.join(", ").html_safe %>
    </p>

    <%= render "listing", forum_topics: @forum_topics %>

    <%= numbered_paginator(@forum_topics) %>
  </div>
</div>
