<div id="c-post-events">
  <div id="a-index">
    <% if @post %>
      <h1><%= t("post_events.index.title_with_post_html", link: link_to(@post.dtext_shortlink, @post)).html_safe %></h1>
      <%= link_to t("post_events.index.back"), post_events_path, class: "text-xs" %>
    <% else %>
      <h1><%= t("post_events.index.title") %></h1>
    <% end %>

    <% unless @post %>
      <%= search_form_for(post_events_path) do |f| %>
        <%= f.input :creator_name, label: t("post_events.index.search_user"), input_html: { value: params[:search][:creator_name], "data-autocomplete": "user" } %>
        <%= f.input :post_tags_match, label: t("post_events.index.search_tags"), input_html: { value: params[:search][:post_tags_match], "data-autocomplete": "tag-query" } %>
        <%= f.input :category, label: t("post_events.index.search_category"), collection: PostEvent.categories.map { |category| [t("post_events.categories.#{category}", default: category.titleize), category] }, include_blank: true, selected: params[:search][:category] %>
        <%= f.input :order, collection: [[t("post_events.index.order_newest"), "event_at"], [t("post_events.index.order_oldest"), "event_at_asc"]], include_blank: true, selected: params[:search][:order] %>
        <%= f.submit t("post_events.index.submit") %>
      <% end %>
    <% end %>

    <%= table_for @post_events, class: "striped autofit mt-4", width: "100%" do |t| %>
      <% t.column t("post_events.index.column_event"), td: { class: "col-expand" }, column: "event" do |event| %>
        <% post = event.post %>
        <% model = event.model %>
        <% creator = event.creator %>

        <% case event.model_type %>
        <% when "Post" %>
          <%= t("post_events.index.was_uploaded_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
        <% when "PostAppeal" %>
          <div class="prose">
            <%= t("post_events.index.was_appealed_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator), reason: (model.reason.present? ? " (#{format_text(model.reason.strip.chomp("."), inline: true)})".html_safe : "")).html_safe %>.
          </div>
        <% when "PostApproval" %>
          <%= t("post_events.index.was_approved_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
        <% when "PostDisapproval" %>
          <div class="prose">
            <% if policy(model).can_view_creator? %>
              <%= t("post_events.index.was_disapproved_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator), reason: model.reason.titleize.downcase, message: (model.message.present? ? ": ".html_safe + format_text(model.message.strip.chomp("."), inline: true) : "")).html_safe %>.
            <% else %>
              <%= t("post_events.index.was_disapproved_html", post: link_to(post.dtext_shortlink, post), reason: model.reason.titleize.downcase, message: (model.message.present? ? ": ".html_safe + format_text(model.message.strip.chomp("."), inline: true) : "")).html_safe %>.
            <% end %>
          </div>
        <% when "PostFlag" %>
          <div class="prose">
            <% if policy(model).can_view_flagger? %>
              <%= t("post_events.index.was_flagged_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator), reason: format_text(model.reason.strip.chomp("."), inline: true)).html_safe %>.
            <% else %>
              <%= t("post_events.index.was_flagged_html", post: link_to(post.dtext_shortlink, post), reason: format_text(model.reason.strip.chomp("."), inline: true)).html_safe %>.
            <% end %>
          </div>
        <% when "PostReplacement" %>
          <%= t("post_events.index.was_replaced_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>

          <% if model.original_url.match?(%r{\Ahttps?://}) %>
            <%= external_link_to(model.original_url, external_site_icon(Source::URL.site_name(model.original_url), title: model.original_url, class: "h-4")) %>
          <% elsif model.original_url.present? %>
            <%= tag.span(model.original_url.truncate(30, omission: "...#{model.original_url.last(15)}"), title: model.original_url) %>,
          <% end %>

          <% if model.old_media_asset.present? %>
            <%= link_to_media_asset model.old_media_asset %>
          <% elsif model.old_file_size && model.old_file_ext && model.old_image_width && model.old_image_height %>
            <%= model.old_file_size.to_fs(:human_size, precision: 4) %>
            .<%= model.old_file_ext %>
            (<%= model.old_image_width %>x<%= model.old_image_height %>)
          <% elsif model.old_md5.present? && policy(model).can_see_md5? %>
            <%= model.old_md5 %>
          <% else %>
            <i><%= t("post_events.index.unknown_file") %></i>
          <% end %>
          →
          <% if model.replacement_url.match?(%r{\Ahttps?://}) %>
            <%= external_link_to(model.replacement_url, external_site_icon(Source::URL.site_name(model.replacement_url), title: model.replacement_url, class: "h-4")) %>
          <% elsif model.replacement_url.present? %>
            <%= tag.span(model.replacement_url.truncate(30, omission: "...#{model.replacement_url.last(15)}"), title: model.replacement_url) %>,
          <% end %>

          <% if model.media_asset.present? %>
            <%= link_to_media_asset model.media_asset %>
          <% elsif model.file_size && model.file_ext && model.image_width && model.image_height %>
            <%= model.file_size.to_fs(:human_size, precision: 4) %>
            .<%= model.file_ext %>
            (<%= model.image_width %>x<%= model.image_height %>)
          <% elsif model.md5.present? %>
            <%= model.md5 %>
          <% else %>
            <i><%= t("post_events.index.unknown_file") %></i>
          <% end %>
        <% when "ModAction" %>
          <% case model.category %>
          <% when "post_ban" %>
            <%= t("post_events.index.was_banned_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_unban" %>
            <%= t("post_events.index.was_unbanned_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_delete" %>
            <%= t("post_events.index.was_deleted_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_undelete" %>
            <%= t("post_events.index.was_undeleted_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_regenerate" %>
            <%= t("post_events.index.thumbnails_regenerated_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_regenerate_iqdb" %>
            <%= t("post_events.index.reindexed_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_rating_lock_create" %>
            <%= t("post_events.index.rating_locked_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_rating_lock_delete" %>
            <%= t("post_events.index.rating_unlocked_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_note_lock_create" %>
            <%= t("post_events.index.note_locked_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% when "post_note_lock_delete" %>
            <%= t("post_events.index.note_unlocked_by_html", post: link_to(post.dtext_shortlink, post), user: link_to_user(creator)).html_safe %>
          <% else %>
            <div class="prose">
              <%= t("post_events.index.generic_html", user: link_to_user(creator), description: format_text(model.description.chomp(".").strip, inline: true)).html_safe %>.
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% t.column t("post_events.index.column_category"), column: "category" do |event| %>
        <%= link_to event.pretty_category, post_events_path(search: { category: event.category, **search_params }) %>
      <% end %>

      <% t.column t("post_events.index.column_user"), column: "user" do |event| %>
        <% if policy(event).can_see_creator? %>
          <%= link_to_user event.creator %> <%= link_to "»", post_events_path(search: { **search_params, creator_name: event.creator.name }) %>
        <% else %>
          <i><%= t("post_events.index.hidden") %></i>
        <% end %>
        <div><%= time_ago_in_words_tagged(event.event_at) %></div>
      <% end %>

      <% t.column column: "control" do |event| %>
        <%= render PopupMenuComponent.new do |menu| %>
          <% unless @post %>
            <% menu.with_item do %>
              <%= link_to t("post_events.index.post_history"), post_post_events_path(event.post) %>
            <% end %>
          <% end %>

          <% if policy(event).can_see_creator? %>
            <% menu.with_item do %>
              <%= link_to t("post_events.index.user_history"), post_events_path(search: { creator_name: event.creator.name }) %>
            <% end %>
          <% end %>

          <% menu.with_item do %>
            <%= link_to t("post_events.index.details"), event.model %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@post_events) %>
  </div>
</div>

<%= render "secondary_links" %>
