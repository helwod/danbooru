<% content_for(:secondary_links) do %>
  <% case controller_name %>
  <% when "post_approvals" %>
    <%= quick_search_form_for(:user_name, post_approvals_path, "user", autocomplete: "user") %>
  <% when "post_disapprovals" %>
    <%= quick_search_form_for(:user_name, post_disapprovals_path, "user", autocomplete: "user") %>
  <% else %>
    <%= quick_search_form_for(:creator_name, url_for, "user", autocomplete: "user") %>
  <% end %>

  <%= subnav_link_to t("post_events.secondary_links.events"), post_events_path, id: "events" %>
  <%= subnav_link_to t("post_events.secondary_links.appeals"), post_appeals_path, id: "appeals" %>
  <%= subnav_link_to t("post_events.secondary_links.approvals"), post_approvals_path, id: "approvals" %>
  <%= subnav_link_to t("post_events.secondary_links.disapprovals"), post_disapprovals_path, id: "disapprovals" %>
  <%= subnav_link_to t("post_events.secondary_links.flags"), post_flags_path, id: "flags" %>
  <%= subnav_link_to t("post_events.secondary_links.replacements"), post_replacements_path, id: "replacements" %>
  <%= subnav_link_to t("post_events.secondary_links.mod_actions"), mod_actions_path(search: { subject_type: "Post" }), id: "mod-actions" %>
<% end %>
