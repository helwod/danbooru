<div id="c-moderation-reports">
  <div id="a-index">
    <h1><%= t("moderation_reports.title") %></h1>

    <%= search_form_for(moderation_reports_path) do |f| %>
      <%= f.input :recipient_name, label: t("moderation_reports.reported_user"), input_html: { value: params[:search][:recipient_name], "data-autocomplete": "user" } %>
      <%= f.input :creator_name, label: t("moderation_reports.reporter"), input_html: { value: params[:search][:creator_name], "data-autocomplete": "user" } %>
      <%= f.input :reason_matches, label: t("moderation_reports.reason"), input_html: { value: params[:search][:reason_matches] } %>
      <%= f.input :model_id, label: t("moderation_reports.id"), input_html: { value: params[:search][:model_id] } %>
      <%= f.input :model_type, label: t("moderation_reports.type"), collection: ModerationReport.model_types, include_blank: true, selected: params[:search][:model_type] %>
      <%= f.input :status, label: t("moderation_reports.status"), collection: ModerationReport.statuses.keys, include_blank: true, selected: params[:search][:status] %>
      <%= f.submit t("moderation_reports.search") %>
    <% end %>

    <%= table_for @moderation_reports, class: "striped autofit", width: "100%" do |t| %>
      <% t.column t("moderation_reports.reported"), column: "reported" do |report| %>
        <% if report.model_type == "Dmail" %>
          <%= link_to report.model.dtext_shortlink, dmail_path(report.model, key: report.model.key) %>
        <% else %>
          <%= link_to report.model.dtext_shortlink, report.model %>
        <% end %>
        <%= link_to "»", moderation_reports_path(search: { model_type: report.model_type, model_id: report.model_id }) %>
      <% end %>

      <% t.column t("moderation_reports.reason"), td: { class: "col-expand" }, column: "reason" do |report| %>
        <span class="prose">
          <%= report.dtext_reason.format_text %>
        </span>
      <% end %>

      <% t.column t("moderation_reports.status"), column: "status" do |report| %>
        <%= link_to t("moderation_reports.statuses.#{report.status}", default: report.status.capitalize), moderation_reports_path(search: { status: report.status }) %>
      <% end %>

      <% t.column t("moderation_reports.reported_user"), column: "reported-user" do |report| %>
        <%= link_to_user report.reported_user %>
        <%= link_to "»", moderation_reports_path(search: { recipient_name: report.reported_user.name }) %>
      <% end %>

      <% t.column t("moderation_reports.reporter"), column: "reporter" do |report| %>
        <%= link_to_user report.creator %>
        <%= link_to "»", moderation_reports_path(search: { creator_name: report.creator.name }) %>
        <div><%= time_ago_in_words_tagged(report.created_at) %></div>
      <% end %>

      <% t.column column: "control" do |report| %>
        <%= render PopupMenuComponent.new do |menu| %>
          <% menu.with_item do %>
            <%= link_to t("moderation_reports.mark_as_handled"), moderation_report_path(report.id), method: :put, remote: true, "data-params": "moderation_report[status]=handled" %>
          <% end %>

          <% menu.with_item do %>
            <%= link_to t("moderation_reports.reject"), moderation_report_path(report.id), method: :put, remote: true, "data-params": "moderation_report[status]=rejected" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@moderation_reports) %>
  </div>
</div>
