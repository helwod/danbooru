<% page_title t("upgrade_codes.title") %>

<%= render "users/secondary_links" %>

<div id="c-user-upgrades">
  <div id="a-redeem" class="fixed-width-container mx-auto">
    <h1 class="text-center mb-4"><%= t("upgrade_codes.title") %></h1>

    <% if CurrentUser.user.level <= User::Levels::MEMBER %>
      <p><%= t("upgrade_codes.intro") %>

      <p><%= t("upgrade_codes.where_to_buy_html",
                upgrade_page: link_to(t("upgrade_codes.upgrade_page"), new_user_upgrade_path),
                contact: link_to(t("upgrade_codes.contact_us"), contact_path)) %></p>

      <% if CurrentUser.user.is_anonymous? %>
        <p><%= t("upgrade_codes.login_required_html",
                login: link_to(t("upgrade_codes.login"), login_path(url: redeem_upgrade_codes_path)),
                create_account: link_to(t("upgrade_codes.create_account"), new_user_path(url: redeem_upgrade_codes_path))) %></p>
      <% else %>
        <%= simple_form_for(:upgrade_code, url: upgrade_upgrade_codes_path, remote: true) do |f| %>
          <%= f.input :code, placeholder: "abcd1234", input_html: { value: params[:code] } %>
          <%= f.submit t("upgrade_codes.upgrade_account"), class: "button-primary" %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-center"><%= t("upgrade_codes.already_upgraded") %></p>
    <% end %>
  </div>
</div>
