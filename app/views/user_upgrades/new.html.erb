<% page_title t("user_upgrades.page_title") %>
<% meta_description t("user_upgrades.meta_description") %>

<% content_for :html_header do %>
  <meta name="referrer" content="no-referrer">
<% end %>

<%= render "users/secondary_links" %>

<div id="c-user-upgrades">
  <div id="a-new" class="fixed-width-container mx-auto">

    <% if @user_upgrade.is_gift? %>
      <h1 class="text-center mb-4"><%= t("user_upgrades.new.gift_heading") %></h1>

      <% if @user_upgrade.recipient.is_platinum? %>
        <p><%= t("user_upgrades.new.already_above_gold_html", user: link_to_user(@recipient)).html_safe %></p>
      <% elsif @user_upgrade.recipient.is_gold? %>
        <p><%= t("user_upgrades.new.already_gold_html", user: link_to_user(@recipient)).html_safe %></p>
      <% else %>
        <h6><%= t("user_upgrades.new.gifting_to_html", user: link_to_user(@user_upgrade.recipient)).html_safe %></h6>
      <% end %>
    <% else %>
      <h1 class="text-center mb-4"><%= t("user_upgrades.new.upgrade_heading") %></h1>

      <p><%= t("user_upgrades.new.benefits_intro", app_name: Danbooru.config.canonical_app_name) %></p>

      <p><%= t("user_upgrades.new.lifetime_upgrade", app_name: Danbooru.config.canonical_app_name) %></p>

      <% if !UserUpgrade.enabled? %>
        <p><b><%= t("user_upgrades.new.disabled_notice") %></b></p>
      <% end %>
    <% end %>

    <% if Danbooru.config.is_promotion? %>
      <p>
        <%= tag.img src: "/images/padoru.gif", width: 24, height: 24 %>
        <b><%= t("user_upgrades.new.promotion", time: time_ago_in_words_tagged(Danbooru.config.winter_sale_end_date)) %></b>
        <%= tag.img src: "/images/padoru.gif", width: 24, height: 24 %>
      </p>
    <% end %>

    <table id="feature-comparison" class="w-full text-center table-md mt-8 mb-8">
      <thead>
        <tr>
          <th></th>
          <th><%= t("user_upgrades.new.plan_basic") %></th>
          <th><%= t("user_upgrades.new.plan_gold") %></th>
        </tr>
      </thead>
      <tbody>
        <colgroup id="labels" class="w-1/4"></colgroup>
        <colgroup id="basic" class="w-1/4"></colgroup>
        <colgroup id="gold" class="w-1/4"></colgroup>
        <tr>
          <td></td>
          <td><%= t("user_upgrades.new.free") %></td>
          <td>
            <% if Danbooru.config.is_promotion? %>
              <s>$20</s>
            <% end %>
            <b><%= number_to_currency(UserUpgrade.gold_price, precision: 0) %></b>
            <div class="fineprint"><%= t("user_upgrades.new.one_time_fee") %></div>
          </td>
        </tr>
        <tr>
          <td><%= t("user_upgrades.new.tag_limit") %></td>
          <td><%= User.tag_query_limit(User::Levels::MEMBER) %></td>
          <td><%= t("user_upgrades.unlimited") %></td>
        </tr>
        <tr>
          <td><%= t("user_upgrades.new.page_limit") %></td>
          <td><%= User.page_limit(User::Levels::MEMBER) %></td>
          <td><%= User.page_limit(User::Levels::GOLD) %></td>
        </tr>
        <tr>
          <td><%= t("user_upgrades.new.private_favorites") %></td>
          <td><%= t("user_upgrades.no") %></td>
          <td><%= t("user_upgrades.yes") %></td>
        </tr>
        <tr>
          <td><%= t("user_upgrades.new.favorite_groups") %></td>
          <td><%= User.favorite_group_limit(User::Levels::MEMBER) %></td>
          <td><%= t("user_upgrades.unlimited") %></td>
        </tr>
        <tr>
          <td><%= t("user_upgrades.new.saved_searches") %></td>
          <td><%= User.max_saved_searches(User::Levels::MEMBER) %></td>
          <td><%= User.max_saved_searches(User::Levels::GOLD) %></td>
        </tr>
        <tr>
          <td><%= t("user_upgrades.new.max_search_duration") %></td>
          <td><%= t("user_upgrades.new.three_seconds") %></td>
          <td><%= t("user_upgrades.new.nine_seconds") %></td>
        </tr>
        <tr>
          <td></td>
          <td>
            <% if @user_upgrade.purchaser.is_anonymous? %>
              <%= link_to t("user_upgrades.new.create_free_account"), new_user_path(url: new_user_upgrade_path), class: "button-outline-primary" %>
            <% end %>
          </td>
          <td>
            <% if !UserUpgrade.enabled? %>
              <%= button_to t("user_upgrades.new.upgrade_to_gold"), nil, class: "button-primary", disabled: true %>
            <% elsif @user_upgrade.purchaser.is_anonymous? %>
              <%= link_to t("user_upgrades.new.upgrade_to_gold"), new_user_path(url: new_user_upgrade_path), class: "button-primary block mb-2" %>
              <%= link_to t("user_upgrades.new.redeem_upgrade_code"), redeem_upgrade_codes_path, class: "text-sm block" %>
            <% elsif @user_upgrade.recipient.level <= User::Levels::MEMBER %>
              <%= button_to t("user_upgrades.new.upgrade_to_gold"), user_upgrades_path(user_id: @recipient.id, upgrade_type: "gold", country: params[:country], promo: params[:promo], payment_processor: "shopify"), class: "button-primary mb-2", remote: true, disable_with: t("user_upgrades.new.redirecting") %>
              <%= link_to t("user_upgrades.new.redeem_upgrade_code"), redeem_upgrade_codes_path, class: "text-sm" %>
            <% else %>
              <%= link_to t("user_upgrades.new.upgrade_to_gold"), user_upgrades_path(user_id: @recipient.id), class: "button-primary", disabled: true %>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>

    <% if @user_upgrade.purchaser.is_anonymous? %>
      <p class="text-center">
        <%= t("user_upgrades.new.already_have_account_html", login: link_to(t("user_upgrades.new.log_in"), login_path(url: new_user_upgrade_path))).html_safe %>
      </p>
    <% end %>

    <h2 class="mb-4"><%= t("user_upgrades.new.faq_heading") %></h2>

    <div id="frequently-asked-questions" class="divide-y-1">
      <details>
        <summary><%= t("user_upgrades.new.faq_upgrade_question") %></summary>

        <p><%= t("user_upgrades.new.faq_upgrade_answer_html", redeem: link_to(t("user_upgrades.new.redeem_here"), redeem_upgrade_codes_path), contact: link_to(t("user_upgrades.new.contact_us"), contact_path)).html_safe %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_benefits_question", app_name: Danbooru.config.canonical_app_name) %></summary>

        <p><%= t("user_upgrades.new.faq_benefits_answer", app_name: Danbooru.config.canonical_app_name) %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_tag_limit_question") %></summary>

        <p><%= t("user_upgrades.new.faq_tag_limit_answer", limit: User.tag_query_limit(User::Levels::MEMBER)) %></p>

        <p><%= t("user_upgrades.new.faq_tag_limit_more_html", link: link_to_wiki(t("user_upgrades.new.wiki_cheatsheet"), "help:cheatsheet")).html_safe %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_page_limit_question") %></summary>

        <p><%= t("user_upgrades.new.faq_page_limit_answer") %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_private_favorites_question") %></summary>

        <p><%= t("user_upgrades.new.faq_private_favorites_answer_html", settings: link_to(t("user_upgrades.new.settings_link"), settings_path)).html_safe %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_favorite_groups_question") %></summary>

        <p><%= t("user_upgrades.new.faq_favorite_groups_answer_html", link: link_to_wiki(t("user_upgrades.new.wiki_favorite_groups"), "help:favorite groups")).html_safe %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_saved_searches_question") %></summary>

        <p><%= t("user_upgrades.new.faq_saved_searches_answer_html", link: link_to_wiki(t("user_upgrades.new.wiki_saved_searches"), "help:saved searches")).html_safe %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_search_duration_question") %></summary>

        <p><%= t("user_upgrades.new.faq_search_duration_answer") %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_gift_question") %></summary>

        <p><%= t("user_upgrades.new.faq_gift_answer") %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_payment_question") %></summary>

        <p><%= t("user_upgrades.new.faq_payment_answer") %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_subscription_question") %></summary>

        <p><%= t("user_upgrades.new.faq_subscription_answer") %></p>
      </details>

      <details>
        <summary><%= t("user_upgrades.new.faq_refund_question") %></summary>

        <p><%= t("user_upgrades.new.faq_refund_answer_html", contact: link_to(t("user_upgrades.new.contact_us"), contact_path), email: mail_to(Danbooru.config.contact_email)).html_safe %>

        <p><%= t("user_upgrades.new.faq_refund_note") %></p>
      </details>
    </div>
  </div>
</div>
