<div id="c-user-upgrades">
  <div id="a-index">
    <%= search_form_for(user_upgrades_path) do |f| %>
      <%= f.input :recipient_name, label: t("user_upgrades.form.recipient"), input_html: { value: params[:search][:recipient_name], data: { autocomplete: "user" } } %>
      <%= f.input :purchaser_name, label: t("user_upgrades.form.purchaser"), input_html: { value: params[:search][:purchaser_name], data: { autocomplete: "user" } } %>
      <%= f.input :upgrade_type, collection: UserUpgrade.upgrade_types.transform_keys { |k| t("user_upgrades.upgrade_types.#{k}", default: k.humanize) }, include_blank: true, selected: params[:search][:upgrade_type] %>
      <%= f.input :status, collection: UserUpgrade.statuses.transform_keys { |k| t("user_upgrades.statuses.#{k}", default: k.humanize) }, include_blank: true, selected: params[:search][:status] %>
      <%= f.input :is_gifted, label: t("user_upgrades.form.gifted"), as: :select, include_blank: true, selected: params[:search][:is_gifted] %>
      <%= f.submit t("user_upgrades.search") %>
    <% end %>

    <%= table_for @user_upgrades, class: "striped autofit" do |t| %>
      <% t.column :recipient, column: "recipient", name: t("user_upgrades.columns.recipient") do |user_upgrade| %>
        <%= link_to_user user_upgrade.recipient %>
      <% end %>

      <% t.column :purchaser, column: "purchaser", name: t("user_upgrades.columns.purchaser") do |user_upgrade| %>
        <%= link_to_user user_upgrade.purchaser %>
      <% end %>

      <% t.column :upgrade_type, column: "upgrade-type", name: t("user_upgrades.columns.upgrade_type") do |user_upgrade| %>
        <%= t("user_upgrades.upgrade_types.#{user_upgrade.upgrade_type}", default: user_upgrade.upgrade_type.humanize) %>
      <% end %>

      <% t.column :is_gifted, column: "gifted", name: t("user_upgrades.columns.gifted") do |user_upgrade| %>
        <%= t("user_upgrades.yes") if user_upgrade.is_gift? %>
      <% end %>

      <% t.column :status, column: "status", name: t("user_upgrades.columns.status") do |user_upgrade| %>
        <%= t("user_upgrades.statuses.#{user_upgrade.status}", default: user_upgrade.status.humanize) %>
      <% end %>

      <% t.column :updated_at, column: "updated", name: t("user_upgrades.columns.updated") do |user_upgrade| %>
        <%= time_ago_in_words_tagged(user_upgrade.updated_at) %>
      <% end %>

      <% t.column column: "control" do |user_upgrade| %>
        <%= link_to t("user_upgrades.action.show"), user_upgrade %>
        <% if policy(user_upgrade).receipt? %>
          | <%= link_to t("user_upgrades.action.receipt"), receipt_user_upgrade_path(user_upgrade), target: "_blank" %>
        <% end %>
        <% if policy(user_upgrade).payment? %>
          | <%= link_to t("user_upgrades.action.payment"), payment_user_upgrade_path(user_upgrade), target: "_blank" %>
        <% end %>
        <% if policy(user_upgrade).refund? %>
          | <%= link_to t("user_upgrades.action.refund"), refund_user_upgrade_path(user_upgrade), remote: true, method: :put, "data-confirm": t("user_upgrades.confirm_refund") %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@user_upgrades) %>
  </div>
</div>
