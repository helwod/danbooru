<div id="c-artist-urls">
  <div id="a-index">
    <%= search_form_for(artist_urls_path) do |f| %>
      <%= f.simple_fields_for :artist do |fa| %>
        <%= fa.input :name, label: t("artist_urls.index.search_artist_name"), input_html: { value: params.dig(:search, :artist, :name), "data-autocomplete": "artist" } %>
      <% end %>
      <%= f.input :url_matches, label: t("artist_urls.index.search_url"), input_html: { value: params[:search][:url_matches] } %>
      <%= f.input :is_active, label: t("artist_urls.index.search_active"), collection: [[t("artist_urls.index.yes"), true], [t("artist_urls.index.no"), false]], include_blank: true, selected: params[:search][:is_active] %>
      <%= f.input :order, collection: [[t("artist_urls.index.order_id"), "id"], [t("artist_urls.index.order_created"), "created_at"], [t("artist_urls.index.order_updated"), "updated_at"]], selected: params[:search][:order] %>
      <%= f.submit t("artist_urls.index.submit") %>
    <% end %>

    <%= table_for @artist_urls, width: "100%" do |t| %>
      <% t.column :id %>
      <% t.column t("artist_urls.index.column_artist_name"), column: "artist-name" do |artist_url| %>
        <%= link_to(artist_url.artist.name, artist_url.artist) %>
      <% end %>
      <% t.column t("artist_urls.index.column_url"), column: "url" do |artist_url| %>
        <%= external_link_to(artist_url.url.to_s) %>
      <% end %>
      <% t.column t("artist_urls.index.column_active"), column: "active" do |artist_url| %>
        <%= artist_url.is_active.to_s %>
      <% end %>
      <% t.column t("artist_urls.index.column_created"), column: "created" do |artist_url| %>
        <%= compact_time(artist_url.created_at) %>
      <% end %>
      <% t.column t("artist_urls.index.column_updated"), column: "updated" do |artist_url| %>
        <%= compact_time(artist_url.updated_at) %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@artist_urls) %>
  </div>
</div>

<%= render "artists/secondary_links" %>
