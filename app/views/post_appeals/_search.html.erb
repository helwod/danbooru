<%= search_form_for(post_appeals_path) do |f| %>
  <%= f.input :reason_matches, label: t("post_appeals.search.reason"), input_html: { value: params[:search][:reason_matches] } %>
  <%= f.input :post_tags_match, label: t("post_appeals.search.tags"), input_html: { value: params[:search][:post_tags_match], data: { autocomplete: "tag-query" } } %>
  <%= f.input :post_id, label: t("post_appeals.search.post_id"), input_html: { value: params[:search][:post_id] } %>
  <%= f.input :creator_name, label: t("post_appeals.search.creator"), input_html: { value: params[:search][:creator_name], data: { autocomplete: "user" } } %>
  <%= f.input :status, collection: PostAppeal.statuses.map { |name, value| [t("post_appeals.status.#{name}", default: name.titleize), value] }, include_blank: true, selected: params[:search][:status] %>
  <%= f.submit t("post_appeals.search.submit") %>
<% end %>
