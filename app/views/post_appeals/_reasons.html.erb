<span class="post-appeal-reason prose">
  <% if appeal.reason.present? %>
    <span class="prose"><%= format_text(appeal.reason.strip.chomp("."), inline: true) %></span>
  <% else %>
    <span class="prose"><em><%= t("post_appeals.reasons.no_reason") %></em></span>
  <% end %>

  <% if policy(appeal).edit? %>
    (<%= link_to t("post_appeals.reasons.edit"), edit_post_appeal_url(appeal), remote: true %>)
  <% end %>

  (<%= link_to_user(appeal.creator) %>, <%= time_ago_in_words_tagged(appeal.created_at) %>)
</span>
