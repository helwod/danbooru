<div id="p-table-listing">
  <% if @user.present? %>
    <h1 class="mb-2"><%= t("user_events.account_history_for_html", user: link_to_user(@user)).html_safe %></h1>
  <% else %>
    <h1 class="mb-2"><%= t("user_events.title") %></h1>
  <% end %>

  <%= render "users/sockpuppets", user: @user %>

  <%= search_form_for(user_events_path) do |f| %>
    <%= f.input :user_name, label: t("user_events.form.user_name"), input_html: { value: params[:search][:user_name], "data-autocomplete": "user" } %>
    <%= f.input :ip_addr, label: t("user_events.form.ip_addr"), input_html: { value: params.dig(:search, :ip_addr) } %>
    <%= f.input :session_id, label: t("user_events.form.session_id"), input_html: { value: params.dig(:search, :session_id) } %>
    <%= f.simple_fields_for :ip_geolocation do |f1| %>
      <%= f1.input :city, input_html: { value: params.dig(:search, :ip_geolocation, :city) } %>
      <%= f1.input :country, as: :string, input_html: { value: params.dig(:search, :ip_geolocation, :country) } %>
      <%= f1.input :is_proxy, label: t("user_events.form.proxy"), as: :select, include_blank: true, selected: params.dig(:search, :ip_geolocation, :is_proxy) %>
    <% end %>
    <%= f.input :category, collection: UserEvent.categories.transform_keys { |k| t("user_events.categories.#{k}", default: k.humanize) }, include_blank: true, selected: params[:search][:category] %>
    <%= f.submit t("user_events.search") %>
  <% end %>

  <div class="flex flex-col items-end mb-2">
    <%= link_to current_page_path(mode: "list"), class: "flex items-center gap-1 text-xs" do %>
      <%= list_icon %> <%= t("user_events.list_link") %>
    <% end %>
  </div>

  <%= table_for @user_events, class: "striped autofit w-full" do |t| %>
    <% t.column :user, column: "user", name: t("user_events.columns.user") do |user_event| %>
      <% if CurrentUser.user != user_event.user && user_event.user.is_banned? %>
        <%= link_to t("user_events.banned"), current_page_path(search: search_params.deep_merge(user: { is_banned: true }), page: nil), class: "chip-red text-error text-xxs" %>
      <% end %>

      <%= link_to_user user_event.user %>
      <%= link_to "»", current_page_path(search: search_params.deep_merge(user_name: user_event.user.name), page: nil) %>
    <% end %>

    <% t.column :message, column: "message", name: t("user_events.columns.message"), td: { class: "col-expand" } do |user_event| %>
      <% user = user_event.user %>

      <% case user_event.category %>
      <% when "login" %>
        <%= t("user_events.table.login") %>
      <% when "login_pending_verification" %>
        <%= t("user_events.table.login_pending_verification") %>
      <% when "login_verification" %>
        <%= t("user_events.table.login_verification") %>
      <% when "reauthenticate" %>
        <%= t("user_events.table.reauthenticate") %>
      <% when "failed_login" %>
        <%= t("user_events.table.failed_login") %>
      <% when "failed_reauthenticate" %>
        <%= t("user_events.table.failed_reauthenticate") %>
      <% when "logout" %>
        <%= t("user_events.table.logout") %>
      <% when "user_creation" %>
        <%= t("user_events.table.user_creation") %>
      <% when "user_deletion" %>
        <%= t("user_events.table.user_deletion") %>
      <% when "user_undeletion" %>
        <%= t("user_events.table.user_undeletion") %>
      <% when "password_reset_request" %>
        <%= t("user_events.table.password_reset_request") %>
      <% when "password_reset" %>
        <%= t("user_events.table.password_reset") %>
      <% when "password_change" %>
        <%= t("user_events.table.password_change") %>
      <% when "email_change" %>
        <%= t("user_events.table.email_change") %>
      <% when "email_verification" %>
        <%= t("user_events.table.email_verification") %>
      <% when "account_verification" %>
        <%= t("user_events.table.account_verification") %>
      <% when "totp_enable" %>
        <%= t("user_events.table.totp_enable") %>
      <% when "totp_disable" %>
        <%= t("user_events.table.totp_disable") %>
      <% when "totp_update" %>
        <%= t("user_events.table.totp_update") %>
      <% when "totp_login_pending_verification" %>
        <%= t("user_events.table.totp_login_pending_verification") %>
      <% when "totp_login" %>
        <%= t("user_events.table.totp_login") %>
      <% when "totp_reauthenticate" %>
        <%= t("user_events.table.totp_reauthenticate") %>
      <% when "totp_failed_login" %>
        <%= t("user_events.table.totp_failed_login") %>
      <% when "totp_failed_reauthenticate" %>
        <%= t("user_events.table.totp_failed_reauthenticate") %>
      <% when "backup_code_generate" %>
        <%= t("user_events.table.backup_code_generate") %>
      <% when "backup_code_login" %>
        <%= t("user_events.table.backup_code_login") %>
      <% when "backup_code_reauthenticate" %>
        <%= t("user_events.table.backup_code_reauthenticate") %>
      <% when "api_key_create" %>
        <%= t("user_events.table.api_key_create") %>
      <% when "api_key_update" %>
        <%= t("user_events.table.api_key_update") %>
      <% when "api_key_delete" %>
        <%= t("user_events.table.api_key_delete") %>
      <% end %>
    <% end %>

    <% t.column :category, column: "category", name: t("user_events.columns.category") do |user_event| %>
      <%= link_to t("user_events.categories.#{user_event.category}", default: user_event.category.humanize), current_page_path(search: search_params.deep_merge(category: UserEvent.categories[user_event.category]), page: nil) %>
    <% end %>

    <% if policy(UserEvent).can_see_session? %>
      <% t.column :session, column: "session", name: t("user_events.columns.session") do |user_event| %>
        <%= link_to user_event.session_id[0..6], current_page_path(search: search_params.deep_merge(session_id: user_event.session_id), page: nil), class: "font-monospace" %>
      <% end %>

      <% t.column :browser, column: "browser", name: t("user_events.columns.browser") do |user_event| %>
        <div>
          <% if user_event.parsed_user_agent.product_version.present? %>
            <%= link_to user_event.parsed_user_agent.product_version, current_page_path(search: search_params.deep_merge(user_agent_ilike: "*#{user_event.parsed_user_agent.full_product_version}*", user_agent: nil), page: nil), title: user_event.user_agent %>
          <% end %>
          <%= link_to "»", current_page_path(search: { user_agent: user_event.user_agent, user_agent_ilike: nil }, page: nil) %>
        </div>
      <% end %>

      <% t.column :os, column: "os", name: t("user_events.columns.os") do |user_event| %>
        <% if user_event.parsed_user_agent.os.present? %>
          <div>
            <%= link_to user_event.parsed_user_agent.os, current_page_path(search: search_params.deep_merge(user_agent_ilike: "*#{user_event.parsed_user_agent.platform}*", user_agent: nil), page: nil), title: user_event.user_agent %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% t.column :location, column: "location", name: t("user_events.columns.location") do |user_event| %>
      <% if user_event.ip_addr.is_tor? %>
        <%= link_to t("user_events.tor"), current_page_path(search: search_params.deep_merge(ip_addr: user_event.ip_addr.supernet(64)), page: nil) %>
      <% elsif user_event.city.present? && user_event.country.present? %>
        <%= link_to user_event.ip_geolocation.city, current_page_path(search: search_params.deep_merge(ip_geolocation: { city: user_event.ip_geolocation.city, country: user_event.ip_geolocation.country }), page: nil) %>,
        <%= link_to user_event.ip_geolocation.country, current_page_path(search: search_params.deep_merge(ip_geolocation: { city: nil, country: user_event.ip_geolocation.country }), page: nil) %>
      <% end %>
    <% end %>

    <% t.column :ip_address, column: "ip-address", name: t("user_events.columns.ip_address") do |user_event| %>
      <div class="flex items-center gap-1 leading-none">
        <% ip_addr = user_event.ip_addr %>

        <% if IpAddressPolicy.new(CurrentUser.user, ip_addr).show? && (user_event.ip_geolocation&.is_proxy? || ip_addr.is_tor?) %>
          <%= link_to t("user_events.proxy"), current_page_path(search: search_params.deep_merge(ip_geolocation: { is_proxy: true }), page: nil), class: "chip-red text-error text-xxs" %>
        <% end %>

        <% if ip_addr.is_tor? %>
          <%= link_to ip_addr.supernet(64), current_page_path(search: search_params.deep_merge(ip_addr: ip_addr.supernet(64)), page: nil), title: ip_addr %>
        <% elsif ip_addr.ipv6? %>
          <%= link_to ip_addr.subnet, current_page_path(search: search_params.deep_merge(ip_addr: ip_addr.subnet), page: nil), title: ip_addr %>
        <% else %>
          <%= link_to ip_addr, current_page_path(search: search_params.deep_merge(ip_addr: ip_addr.subnet), page: nil) %>
        <% end %>

        <% if IpAddressPolicy.new(CurrentUser.user, ip_addr).show? %>
          <%= link_to search_icon, ip_address_path(ip_addr) %>
        <% end %>
      </div>
    <% end %>

    <% t.column :date, column: "date", name: t("user_events.columns.date") do |user_event| %>
      <%= time_ago_in_words_tagged(user_event.created_at) %>
    <% end %>
  <% end %>

  <%= numbered_paginator(@user_events) %>
</div>
