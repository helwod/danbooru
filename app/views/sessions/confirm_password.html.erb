<% page_title t("sessions.confirm_password") %>
<%= render "secondary_links" %>

<div id="c-sessions">
  <div id="a-confirm-password">
    <div class="card mt-8 p-4 max-w-480px mx-auto flex flex-col items-center">
      <h1 class="pb-4"><%= t("sessions.confirm_password") %></h1>

      <% if @user.totp.present? %>
        <p><%= t("sessions.confirm_password_with_totp_hint") %></p>
      <% else %>
        <p><%= t("sessions.confirm_password_hint") %></p>
      <% end %>

      <%= edit_form_for(@session, as: :session, url: reauthenticate_session_path, method: "post", html: { class: "w-full stacked-form stacked-hints", "data-validate-form": true }) do |f| %>
        <%= f.input :url, as: :hidden, input_html: { value: @url } %>
        <%= f.input :password, hint: link_to(t("sessions.forgot_password"), password_reset_path), require: true, input_html: { autofocus: true, autocomplete: "current-password", value: nil } %>
        <% if @user.totp.present? %>
          <%= f.input :verification_code, placeholder: "123456", required: true, minlength: 6, maxlength: User::BACKUP_CODE_LENGTH, pattern: '\d+', input_html: { value: nil }, hint: t("sessions.backup_code_hint") %>
        <% end %>
        <%= f.submit_button t("sessions.continue") %>
      <% end %>
    </div>
  </div>
</div>
