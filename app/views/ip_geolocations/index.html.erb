<div id="c-ip-geolocations">
  <div id="a-index">
    <%= search_form_for(ip_geolocations_path) do |f| %>
      <%= f.input :ip_addr, label: t("ip_geolocations.ip_address"), input_html: { value: params[:search][:ip_addr] } %>
      <%= f.input :asn, label: t("ip_geolocations.asn"), input_html: { value: params[:search][:asn] } %>
      <%= f.input :continent, label: t("ip_geolocations.continent"), input_html: { value: params[:search][:continent] } %>
      <%= f.input :country, label: t("ip_geolocations.country"), as: :string, input_html: { value: params[:search][:country] } %>
      <%= f.input :region, label: t("ip_geolocations.region"), input_html: { value: params[:search][:region] } %>
      <%= f.input :city, label: t("ip_geolocations.city"), input_html: { value: params[:search][:city] } %>
      <%= f.input :is_proxy, label: t("ip_geolocations.proxy"), as: :select, include_blank: true, selected: params[:search][:is_proxy] %>
      <%= f.submit t("ip_geolocations.search") %>
    <% end %>

    <%= table_for @ip_geolocations, class: "striped autofit" do |t| %>
      <% t.column t("ip_geolocations.ip_address"), column: "ip-address" do |ip_geolocation| %>
        <%= ip_geolocation.ip_addr %>
      <% end %>

      <% t.column :network, column: "network", name: t("ip_geolocations.network") %>
      <% t.column :asn, column: "asn", name: t("ip_geolocations.asn") %>
      <% t.column :organization, column: "organization", name: t("ip_geolocations.organization") %>
      <% t.column :is_proxy, column: "is-proxy", name: t("ip_geolocations.is_proxy") %>
      <% t.column :continent, column: "continent", name: t("ip_geolocations.continent") %>
      <% t.column :country, column: "country", name: t("ip_geolocations.country") %>
      <% t.column :region, column: "region", name: t("ip_geolocations.region") %>
      <% t.column :city, column: "city", name: t("ip_geolocations.city") %>

      <% t.column t("ip_geolocations.updated"), column: "updated" do |ip_geolocation| %>
        <%= time_ago_in_words_tagged(ip_geolocation.updated_at) %>
      <% end %>

      <% t.column t("ip_geolocations.created"), column: "created" do |ip_geolocation| %>
        <%= time_ago_in_words_tagged(ip_geolocation.created_at) %>
      <% end %>

      <% t.column column: "control" do |ip_geolocation| %>
        <%= external_link_to "https://ipinfo.io/#{ip_geolocation.ip_addr}", t("ip_geolocations.ip_info") %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@ip_geolocations) %>
  </div>
</div>
