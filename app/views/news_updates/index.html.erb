<div id="c-news-updates">
  <div id="a-index">
    <h1><%= t("news_updates.title") %></h1>

    <%= table_for @news_updates, width: "100%", class: "striped autofit" do |t| %>
      <% t.column t("news_updates.creator"), column: "creator" do |news_update| %>
        <%= link_to_user news_update.creator %>
      <% end %>
      <% t.column :message, column: "message", name: t("news_updates.message"), td: { class: "col-expand" } do |news_update| %>
        <div class="prose"><%= news_update.dtext_message.format_text %></div>
      <% end %>
      <% t.column :duration, column: "duration", name: t("news_updates.duration") do |news_update| %>
        <%= news_update.duration.in_days.round.days.inspect %>
      <% end %>
      <% t.column :created, column: "created", name: t("news_updates.created") do |news_update| %>
        <%= time_ago_in_words_tagged(news_update.created_at) %>
      <% end %>
      <% t.column :expired, column: "expired", name: t("news_updates.expired") do |news_update| %>
        <%= time_ago_in_words_tagged(news_update.expired_at) %>
      <% end %>
      <% t.column :status, column: "status", name: t("news_updates.status") %>
      <% t.column column: "control" do |news_update| %>
        <%= link_to t("news_updates.edit_link"), edit_news_update_path(news_update) %>
          <% if news_update.is_deleted? %>
        | <%= link_to t("news_updates.undelete"), news_update_path(news_update), method: :put, remote: true, "data-params": "news_update[is_deleted]=false", "data-confirm": t("news_updates.undelete_confirm") %>
          <% else %>
        | <%= link_to t("news_updates.delete"), news_update_path(news_update), method: :delete, "data-confirm": t("news_updates.delete_confirm") %>
          <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@news_updates) %>
  </div>
</div>

<%= render "secondary_links" %>
