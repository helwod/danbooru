<% page_title t("emails.verify_title") %>

<div id="c-emails">
  <div id="a-verify" class="fixed-width-container">
    <h1><%= t("emails.verify_title") %></h1>

    <% if @user.is_restricted? %>
      <p><%= t("emails.verify_restricted") %></p>
    <% end %>

    <p><%= t("emails.verify_unverified_html", address: tag.strong(@email_address.address)) %></p>

    <%= edit_form_for(@user, method: :post, url: send_confirmation_user_email_path(@user)) do |f| %>
      <%= f.submit_button t("emails.send_confirmation") %>
    <% end %>
  </div>
</div>
