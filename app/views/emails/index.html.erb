<div id="c-emails">
  <div id="a-index">
    <%= search_form_for(emails_path) do |f| %>
      <%= f.simple_fields_for :user do |fa| %>
        <%= fa.input :name, label: t("emails.user_name"), input_html: { value: params.dig(:search, :user, :name), "data-autocomplete": "user" } %>
      <% end %>

      <%= f.input :address_ilike, label: t("emails.address"), input_html: { value: params[:search][:address_ilike] } %>
      <%= f.input :normalized_address_ilike, label: t("emails.normalized_address"), input_html: { value: params[:search][:normalized_address_ilike] } %>
      <%= f.input :is_verified, label: t("emails.verified"), as: :select, include_blank: true, selected: params[:search][:is_verified] %>
      <%= f.input :is_restricted, label: t("emails.restricted"), as: :select, include_blank: true, selected: params[:search][:is_restricted] %>
      <%= f.submit t("emails.search") %>
    <% end %>

    <%= table_for @email_addresses, class: "striped autofit" do |t| %>
      <% t.column :user, column: "user", name: t("emails.user_name") do |email| %>
        <%= link_to_user email.user %>
      <% end %>
      <% t.column :address, column: "address", name: t("emails.address") do |email| %>
        <%= link_to email.address, emails_path(search: { address_ilike: email.address }) %>
      <% end %>
      <% t.column :normalized_address, column: "normalized-address", name: t("emails.normalized_address") do |email| %>
        <% unless email.is_normalized? %>
          <%= link_to email.normalized_address, emails_path(search: { normalized_address_ilike: email.normalized_address }) %>
        <% end %>
      <% end %>
      <% t.column t("emails.restricted"), column: "restricted" do |email| %>
        <% if email.is_restricted? %>
          <%= link_to t("emails.yes_label"), emails_path(search: { is_restricted: true }) %>
        <% end %>
      <% end %>
      <% t.column t("emails.verified"), column: "verified" do |email| %>
        <% if email.is_verified? %>
          <%= link_to t("emails.yes_label"), emails_path(search: { is_verified: true }) %>
        <% else %>
          <%= link_to t("emails.no_label"), emails_path(search: { is_verified: false }) %>
        <% end %>
      <% end %>
      <% t.column :updated_at, column: "updated", name: t("emails.updated") do |email| %>
        <%= time_ago_in_words_tagged(email.updated_at) %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@email_addresses) %>
  </div>
</div>
