<% page_title t("emails.change_title") %>
<%= render "users/secondary_links" %>

<div id="c-emails">
  <div id="a-edit">
    <div class="card mt-4 p-4 max-w-540px mx-auto flex flex-col items-center gap-2">
      <% if CurrentUser.user == @user %>
        <h1 class="text-center"><%= t("emails.change_title") %></h1>
      <% else %>
        <h1 class="text-center"><%= t("emails.change_heading_html", user: link_to_user(@user)) %></h1>
      <% end %>

      <div class="prose">
        <% if CurrentUser.user != @user %>
          <p><%= t("emails.other_user_warning_html", link: link_to(t("emails.login_history"), user_user_events_path(@user))) %></p>
        <% elsif @user.is_restricted? %>
          <p><%= t("emails.restricted_notice") %></p>

          <p><%= t("emails.restricted_body") %></p>

          <p><%= t("emails.disposable_notice") %></p>
        <% end %>

        <% if CurrentUser.user == @user && @user.recently_verified_account? %>
          <p><%= t("emails.recently_verified_notice", period: User::RECENTLY_PROMOTED_PERIOD.inspect) %></p>
        <% end %>
      </div>

      <%= edit_form_for(@email_address, url: user_email_path(@user), method: "put", html: { class: "w-full stacked-form" }) do |f| %>
        <%= f.input :address, as: :email, input_html: { autofocus: true } %>

        <div>
          <% if policy(@email_address).update? %>
            <%= f.submit_button t("emails.save") %>
          <% end %>

          <% if policy(@email_address).destroy? && @email_address.persisted? %>
            <%= f.submit t("emails.delete"), class: "button-outline-danger", form: "delete-form", "data-confirm": t("emails.delete_confirm") %>
          <% end %>
        </div>
      <% end %>

      <%= edit_form_for(@email_address, url: user_email_path(@user), method: "delete", html: { id: "delete-form", class: "hidden" }) do |f| %>
      <% end %>
    </div>
  </div>
</div>
