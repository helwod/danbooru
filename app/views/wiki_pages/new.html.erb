<%= render "sidebar" %>

<% content_for(:content) do %>
  <h1><%= t("wiki_pages.new.title") %></h1>

  <% if @wiki_page.title.present? %>
    <div class="notice notice-info notice-small" id="new-wiki-page-notice">
      <%= t("wiki_pages.new.notice_html", title: @wiki_page.title) %>
    </div>
  <% end %>

  <%= edit_form_for(@wiki_page) do |f| %>
    <%= f.input :title, error: false, input_html: { data: { autocomplete: "tag" } } %>
    <%= f.input :other_names_string, as: :string, label: t("wiki_pages.form.other_names_label_html", link: link_to_wiki(t("wiki_pages.form.other_names_help"), "help:translated_tags")).html_safe, hint: t("wiki_pages.form.other_names_hint") %>
    <%= f.input :body, as: :dtext, editor_html: { class: "dtext-editor-large" } %>
    <%= f.submit_button %>
  <% end %>

  <%= render "tag_relationships/alias_and_implication_list", tag: @wiki_page.tag %>

  <% if @wiki_page.tag&.is_deprecated? %>
    <p class="fineprint"><%= t("wiki_pages.show.deprecated_html", link: link_to(t("wiki_pages.show.deprecated"), wiki_page_path("help:deprecation_notice"))).html_safe %></p>
  <% end %>

  <%= render_tag_change_notice(tag: @wiki_page.tag, current_user: CurrentUser.user) %>

  <%= render "wiki_pages/posts", wiki_page: @wiki_page %>
<% end %>

<%= render "secondary_links" %>
