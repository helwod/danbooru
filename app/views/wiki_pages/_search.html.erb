<%= search_form_for(wiki_pages_path) do |f| %>
  <%= f.input :title_normalize, label: t("wiki_pages.search.title"), input_html: { value: params[:search][:title_normalize], "data-autocomplete": "wiki-page"} %>
  <%= f.input :other_names_match, label: t("wiki_pages.search.other_names"), input_html: { value: params[:search][:other_names_match] } %>
  <%= f.input :title_or_body_matches, label: t("wiki_pages.search.text"), input_html: { value: params[:search][:title_or_body_matches] } %>
  <%= f.input :linked_to, hint: t("wiki_pages.search.linked_to_hint"), input_html: { value: params[:search][:linked_to], "data-autocomplete": "wiki-page" } %>
  <%= f.simple_fields_for :tag do |fa| %>
    <%= fa.input :category, collection: TagCategory.canonical_mapping.to_a, include_blank: true, selected: params.dig(:search, :tag, :category) %>
  <% end %>
  <%= f.input :is_locked, label: t("wiki_pages.search.locked"), as: :select, include_blank: true, selected: params[:search][:is_locked] %>
  <%= f.input :is_deleted, label: t("wiki_pages.search.deleted"), as: :select, include_blank: true, selected: params[:search][:is_deleted] %>
  <%= f.input :has_embedded_media, label: t("wiki_pages.search.has_images"), as: :select, include_blank: true, selected: params[:search][:has_embedded_media] %>
  <%= f.input :order, collection: [[t("wiki_pages.search.order_newest"), "created_at"], [t("wiki_pages.search.order_title"), "title"], [t("wiki_pages.search.order_posts"), "post_count"]], include_blank: true, selected: params[:search][:order] %>
  <%= f.submit t("wiki_pages.search.submit") %>
<% end %>
