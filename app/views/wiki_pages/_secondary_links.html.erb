<% content_for(:secondary_links) do %>
  <%= quick_search_form_for(:title_normalize, wiki_pages_path, "wiki pages", autocomplete: "wiki-page", redirect: true) %>
  <%= subnav_link_to t("wiki_pages.secondary_links.search"), wiki_pages_path, id: "search" %>
  <% if policy(WikiPage).new? %>
    <%= subnav_link_to t("wiki_pages.secondary_links.new"), new_wiki_page_path, id: "new" %>
  <% end %>
  <%= subnav_link_to t("wiki_pages.secondary_links.changes"), wiki_page_versions_path, id: "changes" %>
  <%= subnav_link_to t("wiki_pages.secondary_links.help"), wiki_page_path("help:wiki"), id: "help" %>
  <% if @wiki_page && @wiki_page.new_record? && @wiki_page.try(:tag).present? %>
    <%= subnav_divider %>
    <%= subnav_link_to t("wiki_pages.secondary_links.posts_count", count: @wiki_page.tag.post_count), posts_path(:tags => @wiki_page.title), id: "posts" %>
  <% elsif @wiki_page && !@wiki_page.new_record? && !@wiki_page_version %>
    <%= subnav_divider %>
    <%= subnav_link_to t("wiki_pages.secondary_links.posts_count", count: @wiki_page.tag.try(:post_count) || 0), posts_path(:tags => @wiki_page.title), id: "posts" %>
    <%= subnav_link_to t("wiki_pages.secondary_links.history"), wiki_page_versions_path(:search => {:wiki_page_id => @wiki_page.id}), id: "history" %>
    <% if policy(@wiki_page).edit? %>
      <% if current_page?(action: :edit) %>
        <% if @wiki_page.is_deleted? %>
          <%= subnav_link_to t("wiki_pages.secondary_links.undelete"), wiki_page_path(@wiki_page.id), remote: true, method: :put, "data-params": "wiki_page[is_deleted]=false", "data-shortcut": "shift+d", "data-confirm": t("wiki_pages.secondary_links.confirm_undelete"), id: "undelete" %>
        <% else %>
          <%= subnav_link_to t("wiki_pages.secondary_links.delete"), wiki_page_path(@wiki_page.id), remote: true, method: :put, "data-params": "wiki_page[is_deleted]=true", "data-shortcut": "shift+d", "data-confirm": t("wiki_pages.secondary_links.confirm_delete"), id: "delete" %>
        <% end %>
      <% else %>
        <%= subnav_link_to t("wiki_pages.secondary_links.edit"), edit_wiki_page_path(@wiki_page.id), "data-shortcut": "e", id: "edit" %>
      <% end %>
    <% end %>
  <% elsif @wiki_page_version %>
    <%= subnav_divider %>
    <%= subnav_link_to t("wiki_pages.secondary_links.posts_count", count: @wiki_page_version.wiki_page.tag.try(:post_count) || 0), posts_path(tags: @wiki_page_version.title), id: "posts" %>
    <%= subnav_link_to t("wiki_pages.secondary_links.history"), wiki_page_versions_path(search: { wiki_page_id: @wiki_page_version.wiki_page_id }), id: "history" %>

    <% if !current_page?(action: :diff) && @wiki_page_version.previous %>
      <%= subnav_link_to t("wiki_pages.secondary_links.diff"), diff_wiki_page_versions_path(:otherpage => @wiki_page_version.id, :thispage => @wiki_page_version.previous.id), id: "diff" %>
    <% end %>

    <% if policy(@wiki_page_version.wiki_page).revert? %>
      <%= subnav_link_to t("wiki_pages.secondary_links.revert_to"), revert_wiki_page_path(@wiki_page_version.wiki_page_id, :version_id => @wiki_page_version.id), :method => :put, :data => {:confirm => t("wiki_pages.secondary_links.confirm_revert")}, id: "revert-to" %>
    <% end %>
  <% end %>
<% end %>
