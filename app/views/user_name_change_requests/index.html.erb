<div id="c-user-name-change-requests">
  <div id="a-index">
    <h1><%= t("user_name_change_requests.title") %></h1>

    <%= search_form_for(user_name_change_requests_path) do |f| %>
      <%= f.input :user_name, label: t("user_name_change_requests.user"), input_html: { value: params[:search][:user_name], "data-autocomplete": "user" } %>
      <%= f.input :old_name, label: t("user_name_change_requests.old_name"), input_html: { value: params[:search][:old_name] } %>
      <%= f.input :new_name, label: t("user_name_change_requests.new_name"), input_html: { value: params[:search][:new_name] } %>
      <%= f.submit t("user_name_change_requests.search") %>
    <% end %>

    <%= table_for @change_requests, width: "100%" do |t| %>
      <% t.column t("user_name_change_requests.user"), column: "user" do |change_request| %>
        <%= link_to_user change_request.user %>
      <% end %>
      <% t.column t("user_name_change_requests.old_name"), column: "old-name" do |change_request| %>
        <%= change_request.original_name %>
      <% end %>
      <% t.column t("user_name_change_requests.new_name"), column: "new-name" do |change_request| %>
        <%= change_request.desired_name %>
      <% end %>
      <% t.column t("user_name_change_requests.date"), column: "date" do |change_request| %>
        <%= compact_time change_request.created_at %>
      <% end %>
      <% t.column column: "control" do |change_request| %>
        <%= link_to t("user_name_change_requests.view"), user_name_change_request_path(change_request) %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@change_requests) %>
  </div>
</div>
