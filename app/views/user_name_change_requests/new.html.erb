<% page_title t("user_name_change_requests.new_title") %>
<%= render "users/secondary_links" %>

<div id="c-user-name-change-requests">
  <div id="a-new">
    <div class="card mt-4 p-4 max-w-540px mx-auto flex flex-col gap-2">
      <% if CurrentUser.user != @change_request.user %>
        <h1 class="text-center"><%= t("user_name_change_requests.new_heading_html", user: link_to_user(@change_request.user)) %></h1>
      <% else %>
        <h1 class="text-center"><%= t("user_name_change_requests.new_title") %></h1>
      <% end %>

      <% if CurrentUser.user != @change_request.user %>
        <p><%= t("user_name_change_requests.admin_warning_html", user: link_to_user(@change_request.user)) %></p>

        <p><%= t("user_name_change_requests.admin_warning_2") %></p>
      <% end %>

      <% if @change_request.user.name_invalid? %>
        <p> <%= t("user_name_change_requests.invalid_name_notice", app_name: Danbooru.config.canonical_app_name) %></p>

        <p>
          <%= t("user_name_change_requests.current_name") %> <b><%= @change_request.user.name %></b>.<br>
          <%= t("user_name_change_requests.error") %> <%= @change_request.user.name_errors.full_messages.join(". ") %>.
        </p>
      <% end %>

      <div class="prose">
        <h6><%= t("user_name_change_requests.rules_heading") %></h6>
        <ul>
          <li><%= t("user_name_change_requests.rule_characters") %></li>
          <li><%= t("user_name_change_requests.rule_edges") %></li>
          <li><%= t("user_name_change_requests.rule_length") %></li>
          <li><%= t("user_name_change_requests.rule_insult") %></li>
          <li><%= t("user_name_change_requests.rule_case") %></li>
          <li><%= t("user_name_change_requests.rule_previous_names") %></li>
          <li><%= t("user_name_change_requests.rule_frequency") %></li>
        </ul>
      </div>

      <%= edit_form_for(@change_request, html: { class: "w-full stacked-form" }) do |f| %>
        <%= f.input :user_id, as: :hidden, input_html: { value: @change_request.user_id } %>
        <%= f.input :desired_name, label: t("user_name_change_requests.new_name_label"), input_html: { autofocus: true } %>
        <%= f.submit_button t("user_name_change_requests.submit"), "data-confirm": t("user_name_change_requests.submit_confirm") %>
      <% end %>
    </div>
  </div>
</div>
