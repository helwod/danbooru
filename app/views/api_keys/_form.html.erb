<%= edit_form_for(api_key, html: { class: "stacked-hints" }, formatted_errors: true) do |f| %>
  <%= f.input :name, as: :string, hint: t("api_keys.name_hint") %>
  <%= f.input :permitted_ip_addresses, label: t("api_keys.ip_addresses"), as: :string, hint: t("api_keys.ip_addresses_hint") %>
  <%= f.input :permissions, as: :select, collection: ApiKey.permissions_list, hint: t("api_keys.permissions_hint"), input_html: { multiple: true } %>
  <%= f.submit_button %>
<% end %>
