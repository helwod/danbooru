<%= render "secondary_links" %>

<div id="c-api-keys">
  <div id="a-index" class="fixed-width-container">
    <div class="page-heading">
      <h1><%= t("api_keys.title") %></h1>

      <%= link_to new_user_api_key_path(CurrentUser.user.id), class: "button-primary" do %>
        <%= plus_icon %> <%= t("api_keys.add") %>
      <% end %>
    </div>

    <% if params[:user_id].present? %>
      <div class="prose">
        <p><%= t("api_keys.intro", app_name: Danbooru.config.canonical_app_name) %></p>

        <p><%= t("api_keys.developer_notice_html", api_link: link_to_wiki("#{Danbooru.config.canonical_app_name} API", "help:api")) %></p>

        <p><%= t("api_keys.secrecy_warning_html") %></p>

        <p><%= t("api_keys.example_usage") %>
          <code>
            <% if @api_keys.present? %>
              <%= profile_url(format: "json", login: CurrentUser.user.name, api_key: @api_keys.first.key) %>
            <% else %>
              <%= profile_url(format: "json", login: CurrentUser.user.name, api_key: "your_api_key_goes_here") %>
            <% end %>
          </code>
        </p>

        <p><%= t("api_keys.see_documentation_html", link: link_to_wiki(t("api_keys.api_documentation"), "help:api")) %></p>
      </div>
    <% end %>

    <% if params[:user_id].present? && !@api_keys.present? %>
      <%= link_to t("api_keys.create"), new_user_api_key_path(CurrentUser.user.id) %>
    <% else %>
      <%= table_for @api_keys, width: "100%", class: "striped autofit" do |t| %>
        <% t.column :name, column: "name", name: t("api_keys.name") %>
        <% t.column :key, column: "key", name: t("api_keys.key"), td: { class: "col-expand" } %>

        <% t.column :permissions, column: "permissions", name: t("api_keys.permissions") do |api_key| %>
          <%= safe_join(api_key.permissions, "<br>".html_safe).presence || t("api_keys.all") %>
        <% end %>

        <% t.column t("api_keys.ips"), column: "ips" do |api_key| %>
          <%= safe_join(api_key.permitted_ip_addresses, "<br>".html_safe).presence || t("api_keys.all") %>
        <% end %>

        <% t.column :uses, column: "uses", name: t("api_keys.uses") %>

        <% t.column t("api_keys.last_used"), column: "last-used" do |api_key| %>
          <%= time_ago_in_words_tagged api_key.last_used_at %>

          <% if api_key.last_ip_address.present? %>
            <br><%= t("api_keys.by_ip", ip: api_key.last_ip_address) %>
          <% end %>
        <% end %>

        <% t.column t("api_keys.created"), column: "created" do |api_key| %>
          <%= time_ago_in_words_tagged api_key.created_at %>

          <% if !params[:user_id].present? %>
            <br> <%= t("api_keys.by_user_html", user: link_to_user(api_key.user)) %>
          <% end %>
        <% end %>

        <% t.column column: "control" do |api_key| %>
          <%= link_to t("api_keys.edit_link"), edit_api_key_path(api_key) %>
          | <%= link_to t("api_keys.delete"), api_key, method: :delete %>
        <% end %>
      <% end %>

      <%= numbered_paginator(@api_keys) %>
    <% end %>
  </div>
</div>
