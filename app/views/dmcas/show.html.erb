<% page_title t("dmcas.title") %>

<% @danbooru = Danbooru.config.canonical_app_name %>

<div id="c-static">
  <div id="a-dmca" class="prose fixed-width-container mx-auto">
    <h1><%= t("dmcas.title") %></h1>

    <p><%= t("dmcas.intro") %></p>

    <p><%= t("dmcas.processing_notice") %></p>

    <p><%= t("dmcas.requirements_notice") %></p>

    <p><%= t("dmcas.copyright_notice") %></p>

    <hr class="border">

    <%= form_tag(dmca_path) do %>
      <p>
        <label><%= t("dmcas.your_name") %></label><br>
        <input name="dmca[name]" class="w-1/2" required></input>
      </p>

      <p>
        <label><%= t("dmcas.your_email") %></label><br>
        <input name="dmca[email]" class="w-1/2" type="email" required></input>
      </p>

      <p>
        <label><%= t("dmcas.your_contact") %></label><br>
        <textarea name="dmca[address]" class="w-1/2"></textarea>
      </p>

      <p>
        <label><%= t("dmcas.infringing_urls_html", app_name: @danbooru) %></label><br>
        <textarea name="dmca[infringing_urls]" class="w-full h-150px" required></textarea>
      </p>

      <p>
        <label><%= t("dmcas.original_urls") %></label><br>
        <textarea name="dmca[original_urls]" class="w-full h-150px" required></textarea>
      </p>

      <p>
        <label><%= t("dmcas.proof") %></label><br>
        <textarea name="dmca[proof]" class="w-full h-16"></textarea>
      </p>

      <p>
        <input type="checkbox" name="perjury_agree" required>
        <label for="dmca[perjury_agree]">
          <%= t("dmcas.perjury_agree") %>
        </label>
      </p>

      <p>
        <input type="checkbox" name="good_faith_agree" required>
        <label for="dmca[good_faith_agree]">
          <%= t("dmcas.good_faith_agree") %>
        </label>
      </p>

      <p>
        <label><%= t("dmcas.signature") %></label><br>
        <input name="dmca[signature]" class="w-1/2" required></input>
      </p>

      <p>
        <input type="submit" value="<%= t("dmcas.submit") %>">
      </p>
    <% end %>

    <hr class="border">

    <p><%= t("dmcas.email_preference_html", link: link_to(t("dmcas.email_us"), "mailto:#{Danbooru.config.dmca_email}")) %></p>

    <ul>
      <li><%= t("dmcas.required_items.contact") %></li>
      <li><%= t("dmcas.required_items.identification", app_name: Danbooru.config.canonical_app_name) %></li>
      <li><%= t("dmcas.required_items.copyrighted_work", app_name: Danbooru.config.canonical_app_name) %></li>
      <li><%= t("dmcas.required_items.good_faith") %></li>
      <li><%= t("dmcas.required_items.accuracy") %></li>
      <li><%= t("dmcas.required_items.signature") %></li>
    </ul>

    <p><%= t("dmcas.template_footer_html", link: external_link_to("https://www.copyright.gov/512/sample-notice.pdf", t("dmcas.template_link"))) %></p>
  </div>
</div>
