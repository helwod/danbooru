<% page_title t("dmcas.title") %>

<div id="c-static">
  <div id="a-dmca" class="prose fixed-width-container">
    <h1><%= t("dmcas.title") %></h1>

    <p><%= t("dmcas.submitted_html", email: @dmca[:email], contact: link_to(Danbooru.config.dmca_email, "mailto:#{Danbooru.config.dmca_email}")) %></p>

    <p><%= t("dmcas.submitted_your_name", name: @dmca[:name]) %></p>
    <p><%= t("dmcas.submitted_your_email", email: @dmca[:email]) %></p>
    <p><%= t("dmcas.submitted_your_address", address: @dmca[:address]) %></p>

    <p><%= t("dmcas.infringing_urls_heading") %></p>
    <ul>
      <% @dmca[:infringing_urls].to_s.split.each do |url| %>
        <li><%= url %></li>
      <% end %>
    </ul>

    <p><%= t("dmcas.original_urls_heading") %></p>
    <ul>
      <% @dmca[:original_urls].to_s.split.each do |url| %>
        <li><%= url %></li>
      <% end %>
    </ul>

    <p><%= t("dmcas.submitted_proof", proof: @dmca[:proof]) %></p>
    <p><%= t("dmcas.submitted_signature", signature: @dmca[:signature]) %></p>
  </div>
</div>
