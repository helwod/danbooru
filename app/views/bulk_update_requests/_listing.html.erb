<% dtext_references = DText.preprocess(bulk_update_requests.map(&:processor).map(&:to_dtext)) %>

<%= table_for bulk_update_requests, width: "100%" do |t| %>
  <% t.column t("bulk_update_requests.listing.column_request"), column: "request" do |request| %>
      <% if request.forum_post.present? %>
        <p><%= link_to t("bulk_update_requests.listing.topic_link", id: request.forum_topic_id, title: request.forum_topic.title), request.forum_post %></p>
      <% elsif request.forum_topic.present? %>
        <p><%= link_to t("bulk_update_requests.listing.topic_link", id: request.forum_topic_id, title: request.forum_topic.title), request.forum_topic %></p>
      <% end %>

      <div class="prose">
        <%= format_text(request.processor.to_dtext, references: dtext_references) %>
      </div>
  <% end %>
  <% t.column t("bulk_update_requests.listing.column_votes"), column: "votes" do |request| %>
    <% if request.forum_post.present? %>
      <%= link_to forum_post_votes_path(search: { forum_post_id: request.forum_post_id }) do %>
        +<%= request.forum_post.votes.select(&:up?).count %> /
        -<%= request.forum_post.votes.select(&:down?).count %>
      <% end %>
    <% end %>
  <% end %>
  <% t.column t("bulk_update_requests.listing.column_status"), column: "status" do |request| %>
    <%= request.status %>
    <% if request.is_approved? %>
      <br><%= t("bulk_update_requests.listing.by", name: link_to_user(request.approver)).html_safe %>
    <% end %>
  <% end %>
  <% t.column t("bulk_update_requests.listing.column_created"), column: "created" do |request| %>
    <%= link_to_user request.user %>
    <%= link_to "»", bulk_update_requests_path(search: { user_name: request.user.name }) %>
    <div><%= time_ago_in_words_tagged(request.created_at) %></div>
  <% end %>
  <% t.column column: "control" do |request| %>
    <%= link_to t("bulk_update_requests.listing.view"), request, class: "button-primary button-sm" %>
  <% end %>
<% end %>
