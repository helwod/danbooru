<%= edit_form_for(@bulk_update_request, formatted_errors: true) do |f| %>
  <div class="prose">
    <details>
      <summary><%= t("bulk_update_requests.form.help_summary") %></summary>

      <%= embed_wiki "help:bur_notice" %>
    </details>

    <p>
      <% if @bulk_update_request.new_record? && @bulk_update_request.forum_topic.present? %>
        <%= t("bulk_update_requests.form.attached_to_html", link: link_to(t("bulk_update_requests.form.topic_link", id: @bulk_update_request.forum_topic_id, title: @bulk_update_request.forum_topic.title), @bulk_update_request.forum_topic)).html_safe %>.
        <%= f.input :forum_topic_id, as: :hidden, input_html: { value: params.dig(:bulk_update_request, :forum_topic_id) } %>
      <% elsif @bulk_update_request.new_record? && @bulk_update_request.forum_topic.blank? %>
        <%= t("bulk_update_requests.form.will_create_topic") %>

        <%= f.input :title, label: t("bulk_update_requests.form.forum_title"), as: :string %>
      <% end %>
    </p>
  </div>

  <%= f.input :script, label: t("bulk_update_requests.form.request"), as: :text %>

  <% if @bulk_update_request.new_record? %>
    <div class="input">
      <%= f.input :reason, as: :dtext, placeholder: t("bulk_update_requests.form.reason_placeholder") %>
    </div>
  <% end %>

  <% if @bulk_update_request.persisted? && policy(@bulk_update_request).can_update_forum? %>
    <%= f.input :forum_topic_id %>
    <%= f.input :forum_post_id %>
  <% end %>

  <%= f.submit_button %>
<% end %>
