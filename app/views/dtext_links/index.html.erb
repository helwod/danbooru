<div id="c-dtext-links">
  <div id="a-index">
    <%= search_form_for(dtext_links_path) do |f| %>
      <%= f.input :link_target_ilike, label: t("dtext_links.index.search_link"), input_html: { value: params[:search][:link_target_ilike], data: { autocomplete: "wiki-page" } } %>
      <%= f.input :model_type, label: t("dtext_links.index.search_page_type"), collection: DtextLink.model_types.map { |m| [t("dtext_links.model_types.#{m}", default: m.titleize), m] }, include_blank: true, selected: params[:search][:model_type] %>
      <%= f.input :link_type, label: t("dtext_links.index.search_link_type"), collection: DtextLink.link_types.map { |name, value| [t("dtext_links.link_types.#{value}", default: name.titleize), value] }, include_blank: true, selected: params[:search][:link_type] %>
      <%= f.input :has_linked_wiki, label: t("dtext_links.index.has_wiki"), collection: [[t("dtext_links.index.yes"), "Yes"], [t("dtext_links.index.no"), "No"]], include_blank: true, selected: params[:search][:has_linked_wiki] %>
      <%= f.input :has_linked_tag, label: t("dtext_links.index.has_tag"), collection: [[t("dtext_links.index.yes"), "Yes"], [t("dtext_links.index.no"), "No"]], include_blank: true, selected: params[:search][:has_linked_tag] %>
      <%= f.submit t("dtext_links.index.submit") %>
    <% end %>

    <%= table_for @dtext_links, class: "striped autofit" do |t| %>
      <% t.column t("dtext_links.index.column_page"), column: "page" do |dtext_link| %>
        <% if dtext_link.model_type == "WikiPage" %>
          <span class="<%= tag_class(dtext_link.model.tag) %>">
            <%= link_to(dtext_link.model.title, dtext_link.model) %>
            <%= link_to("»", dtext_links_path(search: { model_type: "WikiPage", WikiPage: { title: dtext_link.model.title }})) %>
          </span>
        <% else %>
          <%= link_to(dtext_link.model.dtext_shortlink, dtext_link.model) %>
        <% end %>
      <% end %>

      <% t.column t("dtext_links.index.column_link"), column: "link", td: { class: "col-expand" } do |dtext_link| %>
        <% if dtext_link.external_link? %>
          <%= external_link_to(dtext_link.link_target) %>
          <%= link_to("»", dtext_links_path(search: { link_type: "external_link", link_target: dtext_link.link_target })) %>
        <% elsif dtext_link.wiki_link? %>
          <%= link_to_wiki dtext_link.link_target, class: tag_class(dtext_link.linked_wiki&.tag) %>
          <%= link_to("»", dtext_links_path(search: { link_type: "wiki_link", link_target: dtext_link.link_target })) %>
        <% elsif dtext_link.embedded_post? %>
          <%= link_to t("dtext_links.index.post_link", id: dtext_link.link_target), post_path(dtext_link.link_target) %>
          <%= link_to("»", dtext_links_path(search: { link_type: "embedded_post", link_target: dtext_link.link_target })) %>
        <% elsif dtext_link.embedded_media_asset? %>
          <%= link_to t("dtext_links.index.asset_link", id: dtext_link.link_target), media_asset_path(dtext_link.link_target) %>
          <%= link_to("»", dtext_links_path(search: { link_type: "embedded_media_asset", link_target: dtext_link.link_target })) %>
        <% end %>
      <% end %>

      <% t.column t("dtext_links.index.column_type"), column: "type" do |dtext_link| %>
        <%= dtext_link.link_type.delete_suffix("_link").humanize.titleize %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@dtext_links) %>
  </div>
</div>
