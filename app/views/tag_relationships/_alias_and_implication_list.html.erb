<% if tag.present? %>
  <% if tag.antecedent_alias %>
    <p class="fineprint">
      <%= t("tag_relationships.alias_and_implication.aliased_to_html", tag: link_to_wiki_or_artist(tag.antecedent_alias.consequent_tag), learn_more: link_to_wiki(t("tag_relationships.alias_and_implication.learn_more"), "help:tag_aliases")).html_safe %>
    </p>
  <% end %>

  <% if tag.consequent_aliases.present? %>
    <p class="fineprint">
      <%= t("tag_relationships.alias_and_implication.tags_aliased_to_this_html", tags: to_sentence(tag.consequent_aliases.sort_by(&:antecedent_name).map { |ta| link_to_wiki_or_artist ta.antecedent_tag }), learn_more: link_to_wiki(t("tag_relationships.alias_and_implication.learn_more"), "help:tag_aliases")).html_safe %>
    </p>
  <% end %>

  <% Tag.automatic_tags_for([tag.name]).tap do |automatic_tags| %>
    <% if automatic_tags.present? %>
      <p class="fineprint">
        <%= t("tag_relationships.alias_and_implication.automatic_adds_html", tags: to_sentence(automatic_tags.map { |tag| link_to_wiki tag }), learn_more: link_to_wiki(t("tag_relationships.alias_and_implication.learn_more"), "help:autotags")).html_safe %>
      </p>
    <% end %>
  <% end %>

  <% if tag.antecedent_implications.present? %>
    <p class="fineprint">
      <%= t("tag_relationships.alias_and_implication.implicates_html", tags: to_sentence(tag.antecedent_implications.sort_by(&:consequent_name).map { |ti| link_to_wiki_or_artist ti.consequent_tag }), learn_more: link_to_wiki(t("tag_relationships.alias_and_implication.learn_more"), "help:tag_implications")).html_safe %>
    </p>
  <% end %>

  <% if tag.consequent_implications.present? %>
    <p class="fineprint">
      <%= t("tag_relationships.alias_and_implication.tags_implicating_this_html", tags: to_sentence(tag.consequent_implications.sort_by(&:antecedent_name).map { |ti| link_to_wiki_or_artist ti.antecedent_tag }), learn_more: link_to_wiki(t("tag_relationships.alias_and_implication.learn_more"), "help:tag_implications")).html_safe %>
    </p>
  <% end %>
<% end %>
