<% page_title t("dmails.messages") %>
<%= render "secondary_links" %>

<div id="c-dmails">
  <div id="a-index">
    <% if params[:search][:folder].present? %>
      <h1><%= t("dmails.folder_heading", folder: t("dmails.folders.#{params[:search][:folder]}", default: params[:search][:folder].titleize)) %></h1>
    <% else %>
      <h1><%= t("dmails.messages") %></h1>
    <% end %>

    <%= render "search" %>

    <%= table_for @dmails, class: "striped autofit", width: "100%" do |t| %>
      <% t.column t("dmails.date"), column: "date" do |dmail| %>
        <%= compact_time(dmail.created_at) %>
      <% end %>
      <% t.column t("dmails.from"), column: "from" do |dmail| %>
        <%= link_to_user dmail.from %>
      <% end %>
      <% t.column t("dmails.to"), column: "to" do |dmail| %>
        <%= link_to_user dmail.to %>
      <% end %>
      <% t.column t("dmails.subject"), td: { class: "col-expand" }, column: "subject" do |dmail| %>
        <%= link_to dmail.title, dmail_path(dmail) %>
      <% end %>
      <% t.column do |dmail| %>
        <% if dmail.is_read? %>
          <%= link_to t("dmails.mark_unread"), dmail_path(dmail, format: :js), remote: true, method: :put, "data-params": "dmail[is_read]=false" %>
        <% else %>
          <%= link_to t("dmails.mark_read"), dmail_path(dmail, format: :js), remote: true, method: :put, "data-params": "dmail[is_read]=true" %>
        <% end %>
        |
        <% if dmail.is_deleted? %>
          <%= link_to t("dmails.undelete"), dmail_path(dmail, format: :js), remote: true, method: :put, "data-params": "dmail[is_deleted]=false" %>
        <% else %>
          <%= link_to t("dmails.delete"), dmail_path(dmail, format: :js), remote: true, method: :put, "data-params": "dmail[is_deleted]=true", "data-confirm": t("dmails.delete_confirm") %>
        <% end %>

        <% if policy(dmail).reportable? %>
          | <%= link_to t("dmails.report"), new_moderation_report_path(moderation_report: { model_type: "Dmail", model_id: dmail.id }), remote: true, title: t("dmails.report_title") %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@dmails) %>
  </div>
</div>
