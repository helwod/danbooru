<%= search_form_for(dmails_path) do |f| %>
  <%= f.input :folder, as: :hidden, input_html: { value: params[:search][:folder] } %>
  <%= f.input :title_matches, label: t("dmails.subject"), input_html: { value: params[:search][:title_matches] } %>
  <%= f.input :message_matches, label: t("dmails.message"), input_html: { value: params[:search][:messages_matches] } %>
  <%= f.input :to_name, label: t("dmails.to"), input_html: { value: params[:search][:to_name], data: { autocomplete: "user" } } %>
  <%= f.input :from_name, label: t("dmails.from"), input_html: { value: params[:search][:from_name], data: { autocomplete: "user" } } %>
  <%= f.submit t("dmails.search") %>
<% end %>
