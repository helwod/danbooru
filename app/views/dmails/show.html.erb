<% page_title t("dmails.message_title", title: @dmail.title) %>
<%= render "secondary_links" %>

<div id="c-dmails">
  <div id="a-show">
    <div class="dmail">
      <h1><%= @dmail.title %></h1>

      <ul style="margin-bottom: 1em;">
        <li><strong><%= t("dmails.sender") %></strong>: <%= link_to_user @dmail.from %></li>
        <li><strong><%= t("dmails.recipient") %></strong>: <%= link_to_user @dmail.to %></li>
        <li><strong><%= t("dmails.date") %></strong>: <%= compact_time(@dmail.created_at) %></li>
      </ul>

      <div class="prose">
        <%= @dmail.dtext_body.format_text %>

        <% if @dmail.is_automated? %>
          <p class="fineprint">
            <%= t("dmails.automated_notice") %>
          </p>
        <% end %>
      </div>

      <% if CurrentUser.user == @dmail.owner %>
        <div class="mt-4">
        <% if !@dmail.is_automated? %>
          <%= link_to t("dmails.respond"), new_dmail_path(:respond_to_id => @dmail), id: "dmail-respond" %>
          |
        <% end %>
            <%= link_to t("dmails.forward"), new_dmail_path(:respond_to_id => @dmail, :forward => true), id: "dmail-forward" %>
          | <%= link_to t("dmails.share"), dmail_path(@dmail, key: @dmail.key), title: t("dmails.share_title"), id: "dmail-share" %>
        <% if policy(@dmail).reportable? %>
          | <%= link_to t("dmails.report"), new_moderation_report_path(moderation_report: { model_type: "Dmail", model_id: @dmail.id }), remote: true, title: t("dmails.report_title"), id: "dmail-report" %>
        <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
