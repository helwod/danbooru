<% page_title @post.presenter.humanized_essential_tag_string %>
<% meta_description t("posts.show.meta_description", width: @post.image_width, height: @post.image_height, size: number_to_human_size(@post.file_size)) %>
<% seo_canonical_url post_path(@post) %>
<% if Danbooru.config.comments_enabled?.to_s.truthy? %>
  <% atom_feed_tag t("posts.show.atom_feed", id: @post.id), comments_url(:atom, search: { post_id: @post.id }) %>
<% end %>

<%= render "posts/partials/common/secondary_links" %>

<% content_for(:sidebar) do %>
  <%= render "posts/partials/common/search", :path => posts_path, :tags => params[:q], :tags_dom_id => "tags" %>

  <%= render BlacklistComponent.new(user: CurrentUser.user) %>

  <section id="tag-list">
    <%= render_categorized_tag_list(@post, current_query: params[:q]) %>
  </section>

  <section id="post-information">
    <h2><%= t("posts.show.information") %></h2>

    <ul>
      <li id="post-info-id"><%= t("posts.show.id_label") %> <%= @post.id %></li>

      <li id="post-info-uploader">
        <%= t("posts.show.uploader_label") %> <%= link_to_user(@post.uploader) %>
        <%= link_to "»", posts_path(tags: "user:#{@post.uploader.name}") %>
      </li>

      <li id="post-info-date">
        <%= t("posts.show.date_label") %> <%= link_to time_ago_in_words_tagged(@post.created_at), posts_path(tags: "date:#{@post.created_at.to_date}") %>
      </li>

      <% if @post.approver %>
        <li id="post-info-approver">
          <%= t("posts.show.approver_label") %> <%= link_to_user(@post.approver) %>
          <%= link_to "»", posts_path(tags: "approver:#{@post.approver.name}") %>
        </li>
      <% end %>

      <li id="post-info-size">
        <%= t("posts.show.size_label") %> <%= link_to_if policy(@post).visible?, "#{number_to_human_size(@post.file_size)} .#{@post.file_ext}", @post.tagged_file_url %>
        (<%= @post.image_width %>x<%= @post.image_height %>)
        <%= link_to "»", @post.media_asset %>
      </li>

      <li id="post-info-source"><%= t("posts.show.source_label") %> <%= post_source_tag(@post.source, @post.normalized_source) %></li>
      <li id="post-info-rating"><%= t("posts.show.rating_label") %> <%= @post.pretty_rating %></li>

      <li id="post-info-score">
        <%= t("posts.show.score_label") %> <%= render_post_votes @post, current_user: CurrentUser.user %>
      </li>

      <li id="post-info-favorites">
        <%= t("posts.show.favorites_label") %>
        <%= tag.span class: "post-favcount", "data-id": @post.id do %>
          <%= link_to @post.fav_count, post_favorites_path(@post), rel: "nofollow" %>
        <% end %>
      </li>

      <li id="post-info-status">
        <%= t("posts.show.status_label") %>
        <% if @post.is_pending? %>
          <%= t("posts.show.status_pending") %>
        <% elsif @post.is_flagged? %>
          <%= t("posts.show.status_flagged") %>
        <% elsif @post.is_appealed? %>
          <%= t("posts.show.status_appealed") %>
        <% elsif @post.is_deleted? %>
          <%= t("posts.show.status_deleted") %>
        <% else %>
          <%= t("posts.show.status_active") %>
        <% end %>

        <% if @post.is_banned? %>
          <%= t("posts.show.status_banned") %>
        <% end %>
      </li>
    </ul>
  </section>

  <section id="post-options">
    <h2><%= t("posts.options") %></h2>

    <ul>
      <% if policy(@post).visible? %>
        <li id="post-option-resize-to-window">
          <%= link_to t("posts.show.option_resize_to_window"), "#", class: "image-resize-to-window-link", "data-shortcut": "z" %>
        </li>
      <% end %>

      <% if policy(@post).visible? && @post.has_large? && !@post.is_ugoira? %>
        <li id="post-option-view-large">
          <%= link_to t("posts.show.option_view_smaller"), @post.tagged_large_file_url, class: "image-view-large-link" %>
        </li>

        <li id="post-option-view-original">
          <%= link_to t("posts.show.option_view_original"), @post.tagged_file_url, class: "image-view-original-link" %>
        </li>
      <% end %>

      <li id="post-option-find-similar">
        <%= link_to t("posts.show.option_find_similar"), iqdb_queries_path(post_id: @post.id), ref: "nofollow" %>
      </li>

      <% if policy(@post).visible? %>
        <li id="post-option-download">
          <%= link_to t("posts.show.option_download"), @post.tagged_file_url + "?download=1", download: @post.presenter.filename_for_download(CurrentUser.user) %>
        </li>
      <% end %>

      <% if policy(Favorite).create? %>
        <li id="post-option-add-to-favorites">
          <%= link_to t("posts.show.option_favorite"), favorites_path(post_id: @post.id), remote: true, method: :post, id: "add-to-favorites", "data-shortcut": "f", style: ("display: none;" if @post.favorited_by?(CurrentUser.user)) %>
        </li>

        <li id="post-option-remove-from-favorites">
          <%= link_to t("posts.show.option_unfavorite"), favorite_path(@post), remote: true, method: :delete, id: "remove-from-favorites", "data-shortcut": "shift+f", "data-shortcut-when": ":visible", style: ("display: none;" if !@post.favorited_by?(CurrentUser.user)) %>
        </li>
      <% end %>

      <% if policy(@post).update? %>
        <li id="post-option-edit"><%= link_to t("posts.edit"), "#edit", id: "side-edit-link" %></li>
        <li id="post-option-add-to-pool"><%= link_to t("posts.show.option_add_to_pool"), "#", id: "pool", "data-shortcut": "p" %></li>

        <% if @post.can_have_notes? %>
          <li id="post-option-add-note">
            <%= link_to t("posts.show.option_add_note"), "#", id: "translate", "data-shortcut": "n" %>
          </li>
        <% end %>

        <% if @post.has_notes? %>
          <li id="post-option-copy-notes"><%= link_to t("posts.show.option_copy_notes"), "#", id: "copy-notes" %></li>
        <% end %>

        <li id="post-option-add-commentary"><%= link_to t("posts.show.option_add_commentary"), "#", id: "add-commentary", "data-shortcut": "c" %></li>
      <% end %>

      <% if policy(FavoriteGroup).create? %>
        <li id="post-option-add-fav-group"><%= link_to t("posts.show.option_add_to_fav_group"), "#", id: "open-favgroup-dialog-link", "data-shortcut": "g" %></li>
      <% end %>

      <% if @post.is_active? && policy(PostFlag).create? %>
        <li id="post-option-flag"><%= link_to t("posts.show.option_flag"), new_post_flag_path(post_flag: { post_id: @post.id }), remote: true %></li>
      <% elsif @post.is_appealable? && policy(PostAppeal).create? %>
        <li id="post-option-appeal"><%= link_to t("posts.show.option_appeal"), new_post_appeal_path(post_appeal: { post_id: @post.id }), remote: true %></li>
      <% end %>

      <% if policy(PostApproval).create? %>
        <% if @post.is_deleted? && policy(@post).move_favorites? %>
          <li id="post-option-move-favorites"><%= link_to t("posts.show.option_move_favorites"), confirm_move_favorites_moderator_post_post_path(post_id: @post.id) %></li>
        <% end %>

        <% if @post.is_approvable? %>
          <% if @post.is_deleted? %>
            <li id="post-option-undelete"><%= link_to t("posts.show.option_undelete"), post_approvals_path(post_id: @post.id), remote: true, method: :post, "data-shortcut": "shift+o", "data-confirm": t("posts.show.confirm_undelete") %></li>
          <% else %>
            <li id="post-option-approve"><%= link_to t("posts.show.option_approve"), post_approvals_path(post_id: @post.id), remote: true, method: :post, "data-shortcut": "shift+o", "data-confirm": t("posts.show.confirm_approve") %></li>
          <% end %>
        <% end %>

        <% if !@post.is_deleted? && policy(@post).delete? %>
          <li id="post-option-delete"><%= link_to t("posts.show.option_delete"), @post, method: :delete, remote: true %></li>
        <% end %>

        <% if policy(@post).unban? %>
          <li id="post-option-unban"><%= link_to t("posts.show.option_unban"), unban_moderator_post_post_path(@post), remote: true, method: :post, "data-confirm": t("posts.show.confirm_unban") %></li>
        <% elsif policy(@post).ban? %>
          <li id="post-option-ban"><%= link_to t("posts.show.option_ban"), ban_moderator_post_post_path(@post), remote: true, method: :post, "data-confirm": t("posts.show.confirm_ban") %></li>
        <% end %>

        <% if policy(@post).expunge? %>
          <li id="post-option-expunge"><%= link_to t("posts.show.option_expunge"), expunge_moderator_post_post_path(post_id: @post.id), remote: true, method: :post, "data-confirm": t("posts.show.confirm_expunge") %></li>
        <% end %>
      <% end %>

      <% if policy(PostReplacement).create? %>
        <li id="post-option-replace-image"><%= link_to t("posts.show.option_replace_image"), new_post_replacement_path(post_id: @post.id), remote: true %></li>
      <% end %>

      <% if policy(@post).regenerate? %>
        <li id="post-option-regenerate-preview"><%= link_to t("posts.show.option_regenerate_image"), post_regenerations_path(post_id: @post.id, category: "resizes"), method: :post, "data-confirm": t("posts.show.confirm_regenerate") %></li>
      <% end %>
    </ul>
  </section>

  <section id="post-history">
    <h2><%= t("posts.history") %></h2>
    <ul>
      <li id="post-history-tags"><%= link_to t("posts.show.history_tags"), post_versions_path(search: { post_id: @post.id }) %></li>
      <li id="post-history-pools"><%= link_to t("posts.show.history_pools"), pool_versions_path(search: { post_id: @post.id }) %></li>
      <li id="post-history-notes"><%= link_to t("posts.show.history_notes"), note_versions_path(search: { post_id: @post.id }) %></li>
      <li id="post-history-moderation"><%= link_to t("posts.show.history_moderation"), post_post_events_path(@post.id) %></li>
      <li id="post-history-commentary"><%= link_to t("posts.show.history_commentary"), artist_commentary_versions_path(search: { post_id: @post.id }) %></li>
    </ul>
  </section>
<% end %>

<% content_for(:content) do %>
  <% if !CurrentUser.user.new_post_navigation_layout %>
    <%= render_post_navbar(@post, current_user: CurrentUser.user, search: params[:q]) %>
  <% end %>

  <% if @post.is_banned? %>
    <div class="notice notice-small post-notice post-notice-banned">
      <%= t("posts.show.banned_notice") %>
    </div>
  <% end %>

  <% if @post.in_modqueue? %>
    <div class="notice notice-small post-notice post-notice-pending">
      <% if @post.is_pending? %>
        <%= t("posts.show.pending_notice_html", link: link_to_wiki(t("posts.learn_more"), "help:mod_queue")).html_safe %>
      <% elsif @post.is_flagged? %>
        <%= t("posts.show.flagged_notice_html", link: link_to_wiki(t("posts.learn_more"), "howto:flag")).html_safe %>
        <ul class="list-bulleted">
          <li><%= render "post_flags/reasons", flag: @post.flags.select(&:pending?).last %></li>
        </ul>
      <% elsif @post.is_appealed? %>
        <%= t("posts.show.appealed_notice_html", link: link_to_wiki(t("posts.learn_more"), "help:mod_queue")).html_safe %>
        <ul class="list-bulleted">
          <li><%= render "post_appeals/reasons", appeal: @post.appeals.select(&:pending?).last %></li>
        </ul>
      <% end %>

      <%= render "post_disapprovals/counts", disapprovals: @post.disapprovals.order(id: :asc), post: @post %>

      <% if CurrentUser.user.is_approver? %>
        <div class="mt-1">
          <%= render "modqueue/approval_buttons", post: @post %>
          <%= render "post_disapprovals/detailed_rejection_dialog" %>
        </div>
      <% end %>
    </div>
  <% elsif @post.is_deleted? %>
    <div class="notice notice-small post-notice post-notice-deleted">
      <% if @post.flags.succeeded.last.present? %>
        <p><%= t("posts.show.deleted_reason") %></p>
        <%= render "post_flags/reasons", flag: @post.flags.succeeded.last %>
      <% else %>
        <p><%= t("posts.show.deleted_notice") %></p>
      <% end %>

      <%= render "post_disapprovals/counts", disapprovals: @post.disapprovals.order(id: :asc), post: @post %>

      <% if CurrentUser.id == @post.uploader_id %>
        <p><%= t("posts.show.deleted_uploader_advice") %></p>
      <% end %>
    </div>
  <% end %>

  <% if @post.parent.present? %>
    <div class="notice notice-small post-notice post-notice-child">
      <%= render "posts/partials/show/parent_notice", parent: @post.parent, children: @sibling_posts.to_a %>
    </div>
  <% end %>

  <% if @post.has_visible_children? %>
    <div class="notice notice-small post-notice post-notice-parent">
      <%= render "posts/partials/show/child_notice", parent: @post, children: @child_posts.to_a %>
    </div>
  <% end %>

  <% if policy(@post).visible? && @post.has_large? && !@post.is_ugoira? && @post.resize_percentage.floor < 100 %>
    <div class="notice notice-small post-notice post-notice-resized" id="image-resize-notice">
      <%= t("posts.show.resized_notice_html", percentage: number_to_percentage(@post.resize_percentage.floor, precision: 0), link: link_to(t("posts.show.view_original"), @post.tagged_file_url, class: "image-view-original-link")).html_safe %>
    </div>
  <% end %>

  <%= tag.section class: ["image-container", "note-container", ("danbirthday" if is_danbirthday?(@post))], **image_container_data_attributes(@post, CurrentUser.user) do -%>
    <% if @post.banblocked? -%>
      <p><%= t("posts.show.banned_notice") %></p>
    <% elsif @post.levelblocked? -%>
      <p><%= link_to t("posts.show.gold_required"), new_user_upgrade_path %>.</p>
    <% elsif @post.safeblocked? -%>
      <p><%= t("posts.show.safeblocked_html", app_name: Danbooru.config.app_name, link: link_to("Danbooru", "https://danbooru.donmai.us"), learn_more: link_to_wiki(t("posts.learn_more"), "help:safe_mode")).html_safe %></p>
    <% elsif @post.is_flash? -%>
      <%= tag.iframe srcdoc: render("media_assets/flash_player", media_asset: @post.media_asset), sandbox: "allow-scripts", allow: "fullscreen; autoplay", width: @post.image_width, height: @post.image_height, class: "flash-player max-w-full h-auto", style: "border: 0; aspect-ratio: #{@post.image_width} / #{@post.image_height}" %>
    <% elsif @post.is_video? || @post.is_ugoira? -%>
      <%= render VideoComponent.new(@post.media_asset, default_quality: (params.fetch(:size, CurrentUser.user.default_image_size) == "original" ? "original" : "sample"), start_time: params[:time].to_f, html: { id: "image" }) %>
    <% elsif @post.is_image? -%>
      <picture>
        <%= tag.source media: "(max-width: 660px)", srcset: @post.tagged_large_file_url %>
        <%= tag.img width: @post.image_width_for(CurrentUser.user), height: @post.image_height_for(CurrentUser.user), id: "image", class: "fit-width", alt: @post.presenter.humanized_essential_tag_string, src: @post.file_url_for(CurrentUser.user) %>
      </picture>
    <% end %>

    <div id="note-preview"></div>
  <% end -%>

  <% if policy(Favorite).create? %>
    <div class="fav-buttons-container">
      <%= content_tag(:div, class: "mb-2 fav-buttons fav-buttons-#{@post.favorited_by?(CurrentUser.user)}") do %>
        <%= form_tag(favorites_path(post_id: @post.id), method: "post", id: "add-fav-button", "data-remote": true) do %>
          <%= button_tag empty_heart_icon, class: "text-lg py-1 px-3", "data-disable-with": spinner_icon %>
        <% end %>

        <%= form_tag(favorite_path(@post.id), method: "delete", id: "remove-fav-button", "data-remote": true) do %>
          <%= button_tag solid_heart_icon, class: "text-lg py-1 px-3", "data-disable-with": spinner_icon %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <section id="mark-as-translated-section">
    <%= edit_form_for(@post, url: mark_as_translated_post_path(@post), method: :put) do |f| %>
      <%= f.input :q, as: :hidden, input_html: { id: nil, name: "q", value: params[:q] } %>
      <%= f.input :check_translation, as: :boolean, wrapper: "inline-toggle-switch", input_html: { checked: @post.has_tag?("check_translation") } %>
      <%= f.input :partially_translated, as: :boolean, wrapper: "inline-toggle-switch", input_html: { checked: @post.has_tag?("partially_translated") } %>
      <%= f.submit_button t("posts.show.mark_as_translated") %>
    <% end %>
  </section>

  <% if @post.artist_commentary && @post.artist_commentary.any_field_present? %>
    <div id="artist-commentary">
      <%= render "artist_commentaries/show", :artist_commentary => @post.artist_commentary %>
    </div>
  <% end %>

  <% if CurrentUser.user.new_post_navigation_layout %>
    <%= render_post_navbar(@post, current_user: CurrentUser.user, search: params[:q]) %>
  <% end %>

  <menu id="post-sections" class="mb-4">
    <% if Danbooru.config.comments_enabled?.to_s.truthy? %>
      <li class="active"><a href="#comments"><%= t("posts.show.comments") %></a></li>
    <% end %>

    <% if policy(@post).update? %>
      <li><a href="#edit" id="post-edit-link" data-shortcut="e"><%= t("posts.edit") %></a></li>
    <% end %>
  </menu>

  <% if Danbooru.config.comments_enabled?.to_s.truthy? %>
    <section id="comments">
      <%= render_comment_section(@post, current_user: CurrentUser.user) %>
    </section>
  <% end %>

  <section id="notes" style="display: none;">
    <% if @post.has_notes? %>
      <% @post.notes.active.each do |note| %>
        <article data-width="<%= note.width %>" data-height="<%= note.height %>" data-x="<%= note.x %>" data-y="<%= note.y %>" data-id="<%= note.id %>" data-body="<%= note.body %>"><%= raw NoteSanitizer.sanitize(note.body) %></article>
      <% end %>
    <% end %>
  </section>

  <% if policy(@post).update? %>
    <section id="edit" style="display: none;">
      <%= render "posts/partials/show/edit", :post => @post %>
    </section>
  <% end %>
<% end %>

<% if policy(Pool).create? %>
  <div id="add-to-pool-dialog" title="<%= t("posts.show.dialog_add_to_pool") %>" style="display: none;">
    <%= render "pool_elements/new" %>
  </div>
<% end %>

<% artist_commentary = @post.artist_commentary || ArtistCommentary.new(post: @post) %>
<% if policy(artist_commentary).create_or_update? %>
  <div id="add-commentary-dialog" title="<%= t("posts.show.dialog_add_commentary") %>" style="display: none;">
    <%= render "artist_commentaries/form", post: @post, artist_commentary: artist_commentary %>
  </div>
<% end %>

<% if policy(FavoriteGroup).create? %>
  <div id="add-to-favgroup-dialog" title="<%= t("posts.show.dialog_add_to_favgroup") %>" style="display: none;">
    <%= render "favorite_groups/add_to_favgroup_dialog", :post => @post %>
  </div>
<% end %>

<% content_for(:html_header) do %>
  <% if reportbooru_enabled? %>
    <%= reportbooru_beacon_tag("post_views", msg: generate_reportbooru_signature(params[:id])) %>
  <% end %>

  <meta name="post-id" content="<%= @post.id %>">
  <meta name="post-has-embedded-notes" content="<%= @post.has_embedded_notes? %>">

  <%= render OpenGraphComponent.new(media_asset: @post.media_asset, current_user: CurrentUser.user) %>

  <% if @post.rating == "e" %>
    <meta name="rating" content="adult">
  <% end %>
<% end %>
