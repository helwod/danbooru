<% if @post.errors.any? %>
  Danbooru.Utility.error("<%= j @post.errors.full_messages.join('; ') %>");
<% elsif params[:commit] == "Delete" %>
  location.reload();
<% else %>
  Danbooru.Utility.dialog("<%= j t("posts.destroy.dialog_title") %>", "<%= j render "posts/partials/show/delete_dialog", post: @post %>");
<% end %>
