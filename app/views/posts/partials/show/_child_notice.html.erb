<%= t("posts.relationships.child_notice_html", link: link_to(t("posts.relationships.children", count: children.length), posts_path(tags: "parent:#{parent.id}"), rel: "nofollow")).html_safe %>

(<%= link_to_wiki t("posts.learn_more"), "help:post_relationships" %>)
<%= link_to(t("posts.relationships.hide"), "#", id: "has-children-relationship-preview-link") %>

<div id="has-children-relationship-preview">
  <%= render_post_gallery([parent, *children], classes: "inline-block align-top p-2", tags: "parent:#{parent.id}", show_deleted: true, inline: true, size: "150") %>
</div>
