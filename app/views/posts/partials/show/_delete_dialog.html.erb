<div class="delete-post-dialog-body">
  <%= embed_wiki("help:delete_notice") %>

  <%= edit_form_for(post, method: :delete, remote: true) do |f| %>
    <input type="hidden" name="commit" value="Delete">

    <div class="input" x-data="{ length: 0 }">
      <div class="flex justify-between">
        <%= f.label :reason, t("posts.delete_dialog.reason") %>

        <span class="dtext-input-counter-text text-xs pointer-events-none select-none"
              x-text="length + '/<%= PostFlag::MAX_LENGTH %>'"
              x-bind:class="{ 'text-error': length > <%= PostFlag::MAX_LENGTH %> }">0/<%= PostFlag::MAX_LENGTH %></span>
      </div>

      <%= f.input :reason, hint: tag.span(t("posts.edit_form.ctrl_enter"), class: "desktop-only"), as: :string, label: false, placeholder: t("posts.delete_dialog.reason_placeholder"), input_html: { value: "", autofocus: true, "x-on:input": "length = $event.target.value.length" } %>
    </div>

    <% if post.parent_id.present? %>
      <%= f.input :move_favorites, label: t("posts.delete_dialog.move_favorites"), as: :boolean, input_html: { checked: false } %>
    <% end %>

    <div class="dialog-buttons">
      <%= f.submit t("posts.delete_dialog.delete"), name: nil, class: "button-danger" %>
      <%= f.cancel_button t("posts.delete_dialog.cancel") %>
    </div>
  <% end %>
</div>
