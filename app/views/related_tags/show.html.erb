<% page_title t("related_tags.show.page_title") %>
<%= render "tags/secondary_links" %>

<div id="c-related-tags">
  <div id="a-show">
    <h1><%= t("related_tags.show.page_title") %></h1>

    <%= search_form_for(related_tag_path) do |f| %>
      <%= f.input :query, label: t("related_tags.show.search_tag"), input_html: { value: params[:search][:query], "data-autocomplete": "tag-query" } %>
      <%= f.input :category, collection: TagCategory.categories.map { |c| [t("related_tags.show.categories.#{c}", default: c.capitalize), c] }, include_blank: true, selected: params[:search][:category] %>
      <%= f.input :order, collection: [[t("related_tags.show.order_cosine"), "Cosine"], [t("related_tags.show.order_jaccard"), "Jaccard"], [t("related_tags.show.order_overlap"), "Overlap"], [t("related_tags.show.order_frequency"), "Frequency"]], include_blank: true, selected: params[:search][:order] %>
      <%= f.input :search_sample_size, label: t("related_tags.show.search_sample_size"), as: :hidden, input_html: { value: params[:search][:search_sample_size] } %>
      <%= f.input :tag_sample_size, label: t("related_tags.show.tag_sample_size"), as: :hidden, input_html: { value: params[:search][:tag_sample_size] } %>
      <%= f.submit t("related_tags.show.submit") %>
    <% end %>

    <% if params.dig(:search, :query).present? %>
      <%= table_for @query.related_tags, class: "striped w-full fixed-width-container" do |table| %>
        <% table.column t("related_tags.show.column_name"), column: "name" do |t| %>
          <%= link_to_wiki "?", t.name, class: tag_class(t) %>
          <%= link_to t.name, posts_path(tags: t.name), class: tag_class(t) %>
          <%= tag.span humanized_number(t.post_count), class: "post-count", title: t.post_count %>
        <% end %>

        <% table.column t("related_tags.show.order_cosine"), column: "cosine" do |t| %>
          <%= tag.span "%.2f%%" % (t.cosine_similarity * 100) %>
        <% end %>

        <% table.column t("related_tags.show.order_jaccard"), column: "jaccard" do |t| %>
          <%= tag.span "%.2f%%" % (t.jaccard_similarity * 100) %>
        <% end %>

        <% table.column t("related_tags.show.order_overlap"), column: "overlap" do |t| %>
          <%= tag.span "%.2f%%" % (t.overlap_coefficient * 100) %>
        <% end %>

        <% table.column t("related_tags.show.order_frequency"), column: "frequency" do |t| %>
          <%= tag.span "%.2f%%" % (t.frequency * 100) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
