<% if source.present? %>
  <% tags = source.artists.map(&:tag) %>
  <% tags += source.translated_tags %>
  <%= render "related_tags/tag_column", tags: tags, class: "translated-tags-related-tags-column", title: t("related_tags.columns.translated") %>
<% else %>
  <%= render "related_tags/tag_column", tags: [], class: "translated-tags-related-tags-column", title: t("related_tags.columns.translated") %>
<% end %>
