<% page_title t("tags.show.page_title", name: @tag.pretty_name.startcase) %>
<%= render "secondary_links" %>

<div id="c-tags">
  <div id="a-show">
    <h1><%= t("tags.edit.title", name: @tag.name) %></h1>

    <ul>
      <li><%= t("tags.show.count", count: @tag.post_count) %></li>
      <li><%= t("tags.show.category", name: @tag.category_name) %></li>
      <% if @tag.is_deprecated? %>
        <li> <%= t("tags.show.deprecated_html", link: link_to(t("tags.show.deprecated"), wiki_page_path("help:deprecation_notice"))).html_safe %></li>
      <% end %>
    </ul>
  </div>
</div>
