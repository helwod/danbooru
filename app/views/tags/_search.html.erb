<%= search_form_for(tags_path) do |f| %>
  <%= f.input :name_or_alias_matches, label: t("tags.search.name"), input_html: { value: params[:search][:name_or_alias_matches], data: { autocomplete: "tag" } } %>
  <%= f.input :category, label: t("tags.search.category"), collection: TagCategory.canonical_mapping.to_a, include_blank: true,selected: params[:search][:category] %>
  <%= f.input :order, collection: [[t("tags.search.order_newest"), "date"], [t("tags.search.order_count"), "count"], [t("tags.search.order_name"), "name"]], include_blank: false, selected: params[:search][:order] %>
  <%= f.input :is_deprecated, label: t("tags.search.is_deprecated"), collection: [[t("tags.search.yes"), "yes"], [t("tags.search.no"), "no"]], include_blank: true, selected: params[:search][:is_deprecated] %>
  <%= f.input :hide_empty, label: t("tags.search.hide_empty"), collection: [[t("tags.search.yes"), "yes"], [t("tags.search.no"), "no"]], selected: params[:search][:hide_empty] %>
  <%= f.input :has_wiki_page, label: t("tags.search.has_wiki"), collection: [[t("tags.search.yes"), "yes"], [t("tags.search.no"), "no"]], include_blank: true, selected: params[:search][:has_wiki_page] %>
  <%= f.input :has_artist, label: t("tags.search.has_artist"), collection: [[t("tags.search.yes"), "yes"], [t("tags.search.no"), "no"]], include_blank: true, selected: params[:search][:has_artist] %>
  <%= f.submit t("tags.search.submit") %>
<% end %>
