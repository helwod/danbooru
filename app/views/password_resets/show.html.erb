<% page_title t("password_resets.title") %>
<%= render "sessions/secondary_links" %>

<div id="c-password-resets">
  <div id="a-show">
    <div class="card mt-8 p-4 max-w-480px mx-auto flex flex-col items-center">
      <h1 class="pb-4"><%= t("password_resets.title") %></h1>

      <p class="w-full"><%= t("password_resets.request_hint") %></p>

      <p class="w-full"><%= t("password_resets.no_email_warning") %></p>

      <%= edit_form_for(:user, url: password_reset_path, action: :post, html: { class: "w-full stacked-form stacked-hints", "data-validate-form": "true" }) do |f| %>
        <%= f.input :name, label: t("password_resets.name_or_email"), input_html: { "data-autocomplete": "user" } %>
        <%= captcha_tag class: "mb-4", action: :password_reset %>
        <%= f.submit_button t("password_resets.submit"), disabled: true %>
      <% end %>
    </div>
  </div>
</div>
