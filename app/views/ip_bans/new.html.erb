<div id="c-ip-bans">
  <div id="a-new" class="fixed-width-container">
    <h1><%= t("ip_bans.new_title") %></h1>

    <p>
      <%= t("ip_bans.full_ban_notice") %>
    </p>

    <p>
      <%= t("ip_bans.partial_ban_notice") %>
    <p>

    <%= edit_form_for(@ip_ban) do |f| %>
      <%= f.input :ip_addr, label: t("ip_bans.ip_address"), as: :string, hint: t("ip_bans.new_ip_addr_hint") %>
      <%= f.input :reason, label: t("ip_bans.reason"), as: :string %>
      <%= f.input :category, label: t("ip_bans.category"), as: :select, include_blank: false, collection: [[t("ip_bans.full"), "full"], [t("ip_bans.partial"), "partial"]] %>
      <%= f.submit_button %>
    <% end %>
  </div>
</div>

<%= render "secondary_links" %>
