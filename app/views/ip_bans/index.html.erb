<div id="c-ip-bans">
  <div id="a-index">
    <h1><%= t("ip_bans.title") %></h1>

    <%= search_form_for(ip_bans_path) do |f| %>
      <%= f.input :ip_addr, label: t("ip_bans.ip_addr"), hint: t("ip_bans.ip_addr_hint"), input_html: { value: params[:search][:ip_addr] } %>
      <%= f.input :reason, label: t("ip_bans.reason"), input_html: { value: params[:search][:reason] } %>
      <%= f.input :creator_name, label: t("ip_bans.creator"), input_html: { value: params[:search][:creator_name], "data-autocomplete": "user" } %>
      <%= f.input :category, label: t("ip_bans.category"), collection: IpBan.categories, include_blank: true, selected: params[:search][:category] %>
      <%= f.input :is_deleted, label: t("ip_bans.status"), collection: [[t("ip_bans.active"), "false"], [t("ip_bans.deleted"), "true"]], include_blank: true, selected: params[:search][:is_deleted] %>
      <%= f.input :order, label: t("ip_bans.order"), collection: [[t("ip_bans.order_by.newest"), "created_at"], [t("ip_bans.order_by.oldest"), "created_at_asc"], [t("ip_bans.order_by.last_seen"), "last_hit_at"]], include_blank: true, selected: params[:search][:order] %>
      <%= f.submit t("ip_bans.search") %>
    <% end %>

    <%= table_for @ip_bans, class: "striped autofit", width: "100%" do |t| %>
      <% t.column t("ip_bans.ip_address"), column: "ip-address" do |ip_ban| %>
        <%= link_to ip_ban.ip_addr, user_events_path(search: { ip_addr: ip_ban.ip_addr.to_s }) %>
        <%= link_to search_icon, ip_address_path(ip_ban.ip_addr.to_s) %>
      <% end %>
      <% t.column t("ip_bans.reason"), td: { class: "col-expand" }, column: "reason" do |ban| %>
        <div class="prose">
          <%= ban.dtext_reason.format_text %>
        </div>
      <% end %>
      <% t.column t("ip_bans.status"), column: "status" do |ip_ban| %>
        <% if ip_ban.is_deleted? %>
          <%= t("ip_bans.deleted") %>
        <% end %>
      <% end %>
      <% t.column t("ip_bans.type"), column: "type" do |ip_ban| %>
        <%= t("ip_bans.categories.#{ip_ban.category}", default: ip_ban.category.delete_suffix("_ban").capitalize) %>
      <% end %>
      <% t.column t("ip_bans.last_seen"), column: "last-seen" do |ip_ban| %>
        <%= time_ago_in_words_tagged ip_ban.last_hit_at %>
      <% end %>
      <% t.column :hit_count, column: "hits", name: t("ip_bans.hits") %>
      <% t.column t("ip_bans.creator"), column: "creator" do |ip_ban| %>
        <%= link_to_user ip_ban.creator %>
        <%= link_to "»", ip_bans_path(search: { creator_name: ip_ban.creator.name }) %>
        <div><%= time_ago_in_words_tagged(ip_ban.created_at) %></div>
      <% end %>
      <% t.column column: "control" do |ip_ban| %>
        <% if ip_ban.is_deleted? %>
          <%= link_to t("ip_bans.undelete"), ip_ban_path(ip_ban), remote: true, method: :put, "data-params": "ip_ban[is_deleted]=false", "data-confirm": t("ip_bans.undelete_confirm") %>
        <% else %>
          <%= link_to t("ip_bans.delete"), ip_ban_path(ip_ban), remote: true, method: :put, "data-params": "ip_ban[is_deleted]=true", "data-confirm": t("ip_bans.remove_confirm") %>
        <% end %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@ip_bans) %>
  </div>
</div>

<%= render "secondary_links" %>
