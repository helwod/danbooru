<% content_for(:secondary_links) do %>
  <%= quick_search_form_for(:ip_addr, ip_bans_path, "ip addresses") %>
  <%= subnav_link_to t("ip_bans.listing"), ip_bans_path, id: "listing" %>
  <%= subnav_link_to t("ip_bans.bans"), bans_path, id: "bans" %>
  <%= subnav_link_to t("ip_bans.feedbacks"), user_feedbacks_path, id: "feedbacks" %>
  <% if policy(IpBan).create? %>
    <%= subnav_divider %>
    <%= subnav_link_to t("ip_bans.new"), new_ip_ban_path, id: "new" %>
  <% end %>
<% end %>
