<% page_title t("admin.edit_user_title", name: @user.pretty_name) %>
<%= render "users/secondary_links" %>

<div id="c-admin-users">
  <div id="a-edit" class="max-w-720px">
    <h1 class="mb-4"><%= t("admin.edit_user_heading_html", user: link_to_user(@user)) %></h1>

    <div class="space-y-2">
      <% if policy(@user).promote? %>
        <div class="card-outlined p-2 flex items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="font-bold"><%= t("admin.promote_title") %></div>
            <div class="fineprint max-w-360px"><%= t("admin.promote_desc") %></div>
          </div>

          <%= link_to t("admin.promote"), promote_user_path(@user), class: "button-primary h-fit" %>
        </div>

        <% if @user.level > User::Levels::MEMBER %>
          <div class="card-outlined p-2 flex items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="font-bold"><%= t("admin.demote_title") %></div>
              <div class="fineprint max-w-360px"><%= t("admin.demote_desc") %></div>
            </div>

            <%= link_to t("admin.demote"), demote_user_path(@user), class: "button-primary h-fit" %>
          </div>
        <% end %>
      <% end %>

      <% if policy(UserNameChangeRequest.new(user: @user)).can_rename_user? %>
        <div class="card-outlined p-2 flex items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="font-bold"><%= t("admin.change_username_title") %></div>
            <div class="fineprint max-w-360px"><%= t("admin.change_username_desc") %></div>
          </div>

          <%= link_to t("admin.rename"), change_name_user_path(@user), class: "button-primary h-fit" %>
        </div>
      <% end %>

      <% if policy(Ban.new(user: @user)).create? %>
        <% if @user.is_banned? %>
          <div class="card-outlined p-2 flex items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex sm:flex-col md:items-center gap-2 leading-none">
                <span class="font-bold"><%= t("admin.unban_title") %></span>

                <% if @user.active_ban.forever? %>
                  <span class="chip-red w-fit text-error text-xs"><%= t("admin.permabanned") %></span>
                <% else %>
                  <span class="chip-red w-fit text-error text-xs"><%= t("admin.expires", time: time_ago_in_words_tagged(@user.active_ban.expires_at, compact: true)) %></span>
                <% end %>
              </div>
              <div class="fineprint max-w-360px"><%= t("admin.unban_desc") %></div>
            </div>

            <%= link_to t("admin.edit_ban"), edit_ban_path(@user.active_ban), class: "button-primary h-fit" %>
          </div>
        <% else %>
          <div class="card-outlined p-2 flex items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="font-bold"><%= t("admin.ban_title") %></div>
              <div class="fineprint max-w-360px"><%= t("admin.ban_desc") %></div>
            </div>

            <%= link_to t("admin.ban"), new_ban_path(ban: { user_id: @user.id }), class: "button-danger h-fit", disabled: @user.is_banned? %>
          </div>
        <% end %>
      <% end %>

      <% if policy(@user).deactivate? %>
        <div class="card-outlined p-2 flex items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="font-bold"><%= t("admin.deactivate_title") %></div>
            <div class="fineprint max-w-360px"><%= t("admin.deactivate_desc") %></div>
          </div>

          <%= link_to t("admin.deactivate"), deactivate_user_path(@user), class: "button-outline-danger h-fit", disabled: @user.is_deleted? %>
        </div>
      <% end %>
    </div>

    <% if policy(@user).can_recover_account? %>
      <h2 class="my-4"><%= t("admin.account_recovery") %></h2>

      <p><%= t("admin.recovery_notice") %></p>

      <p><%= t("admin.recovery_warning_html", link: link_to(t("admin.login_history"), user_user_events_path(@user))) %></p>

      <div class="space-y-2">
        <div class="card-outlined p-2 flex items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="font-bold"><%= t("admin.change_email_title") %></div>
            <div class="fineprint max-w-360px">
              <%= t("admin.change_email_desc") %>
            </div>
          </div>

          <%= link_to t("admin.change_email"), edit_user_email_path(@user), class: "button-primary h-fit", disabled: !policy(EmailAddress.new(user_id: @user.id)).update? %>
        </div>

        <div class="card-outlined p-2 flex items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex sm:flex-col md:items-center gap-2 leading-none">
              <span class="font-bold"><%= t("admin.recover_2fa_title") %></span>
              <% if @user.backup_codes.blank? %>
                <span class="chip-red w-fit text-error text-xs"><%= t("admin.two_factor_disabled") %></span>
              <% elsif @user.email_address.blank? %>
                <span class="chip-red w-fit text-error text-xs"><%= t("admin.no_email") %></span>
              <% else %>
                <span class="chip-green w-fit text-success text-xs"><%= t("admin.enabled") %></span>
              <% end %>
            </div>

            <div class="fineprint max-w-360px">
              <%= t("admin.recover_2fa_desc") %>
            </div>
          </div>

          <%= link_to t("admin.send_backup_code"), confirm_recover_user_backup_codes_path(user_id: @user.id), class: "button-primary h-fit", disabled: @user.backup_codes.blank? || @user.email_address.blank? %>
        </div>
      </div>
    <% end %>
  </div>
</div>
