<%= search_form_for(comment_votes_path) do |f| %>
  <%= f.input :user_name, label: t("comment_votes.labels.voter"), input_html: { value: params[:search][:user_name], "data-autocomplete": "user" } %>
  <%= f.simple_fields_for :comment do |fc| %>
    <%= fc.input :creator_name, label: t("comment_votes.labels.commenter"), input_html: { value: params.dig(:search, :comment, :creator_name), "data-autocomplete": "user" } %>
    <%= fc.input :body_matches, label: t("comment_votes.labels.text"), input_html: { value: params.dig(:search, :comment, :body_matches ) } %>
    <%= fc.input :post_tags_match, label: t("comment_votes.labels.tags"), input_html: { value: params.dig(:search, :comment, :post_tags_match), "data-autocomplete": "tag-query" } %>
    <%= fc.input :post_id, label: t("comment_votes.labels.post_id"), input_html: { value: params.dig(:search, :comment, :post_id) } %>
  <% end %>
  <%= f.input :is_deleted, label: t("comment_votes.labels.deleted"), as: :select, include_blank: true, selected: params[:search][:is_deleted] %>
  <%= f.input :score, collection: [["+1", "1"], ["-1", "-1"]], include_blank: true, selected: params[:search][:score] %>
  <%= f.submit t("comment_votes.labels.search") %>
<% end %>
