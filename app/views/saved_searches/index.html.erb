<div id="c-saved-searches">
  <div id="a-index">
    <h1>
      <%= t("saved_searches.index.title") %>
      <% if params[:label] %>
        (<%= params[:label] %>)
      <% end %>
    </h1>

    <%= search_form_for(saved_searches_path) do |f| %>
      <%= f.input :query_ilike, label: t("saved_searches.index.search_query"), input_html: { value: params[:search][:query_ilike] } %>
      <%= f.input :label, label: t("saved_searches.index.search_label"), input_html: { value: params[:search][:label], "data-autocomplete": "saved-search-label" } %>
      <%= f.input :order, collection: [[t("saved_searches.index.order_newest"), "id"], [t("saved_searches.index.order_query"), "query"], [t("saved_searches.index.order_label"), "label"]], include_blank: false, selected: params[:search][:order] %>
      <%= f.submit t("saved_searches.index.submit") %>
    <% end %>

    <%= table_for @saved_searches, class: "striped autofit", width: "100%" do |t| %>
      <% t.column t("saved_searches.index.column_query"), th: {"data-sort": "string"}, td: {class: "col-expand"}, column: "query" do |ss| %>
        <%= link_to ss.query, posts_path(tags: ss.query) %>
      <% end %>
      <% t.column t("saved_searches.index.column_labels"), th: {"data-sort": "string"}, column: "labels" do |ss| %>
        <% ss.labels.each do |label| %>
          <%= link_to label, posts_path(:tags => "search:#{label}") %>
        <% end %>
      <% end %>
      <% t.column t("saved_searches.index.column_posts"), column: "posts" do |ss| %>
        <%= ss.cached_size if ss.cached_size > 0 %>
      <% end %>
      <% t.column t("saved_searches.index.column_refreshed"), column: "refreshed" do |ss| %>
        <% if ss.refreshed_at.present? %>
          <%= time_ago_in_words_tagged ss.refreshed_at %>
        <% else %>
          <%= t("saved_searches.index.older_than", duration: SavedSearch::REDIS_EXPIRY.inspect) %>
        <% end %>
      <% end %>
      <% t.column t("saved_searches.index.column_created"), column: "created" do |ss| %>
        <%= time_ago_in_words_tagged ss.created_at %>
      <% end %>
      <% t.column column: "control" do |ss| %>
        <%= link_to t("saved_searches.index.edit"), edit_saved_search_path(ss) %>
          | <%= link_to t("saved_searches.index.delete"), saved_search_path(ss), :method => :delete, :remote => true %>
      <% end %>
    <% end %>

    <%= numbered_paginator(@saved_searches) %>
  </div>
</div>

<%= render "secondary_links" %>
