<div id="save-search-dialog" title="<%= t("saved_searches.interface.dialog_title") %>" style="display: none;">

  <%= edit_form_for(SavedSearch.new, remote: true) do |f| %>
    <%= f.input :query, as: :string, input_html: { value: params[:tags], data: { autocomplete: "tag-query" } } %>
    <%= f.input :label_string, label: t("saved_searches.interface.labels"), hint: t("saved_searches.interface.labels_hint"), input_html: { "data-autocomplete": "saved-search-label" } %>
    <%= f.input :disable_labels, label: t("saved_searches.interface.dont_show_again"), as: :boolean %>
    <div class="dialog-buttons">
      <%= f.submit_button %>
      <%= f.cancel_button t("saved_searches.interface.cancel") %>
    </div>
  <% end %>
</div>
