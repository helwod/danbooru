<% page_title t("passwords.title") %>

<div id="c-passwords">
  <div id="a-edit">
    <div class="card mt-8 p-4 max-w-480px mx-auto flex flex-col items-center">
      <h1 class="pb-4"><%= t("passwords.title") %></h1>

      <% if @user.totp.present? %>
        <p class="w-full"><%= t("passwords.totp_hint") %></p>
      <% end %>

      <%= edit_form_for(@user, url: user_password_path(@user), html: { class: "w-full stacked-form stacked-hints", "data-validate-form": "true" }) do |f| %>
        <% if @user == CurrentUser.user %>
          <%= f.input :current_password, as: :password, input_html: { autocomplete: "current-password" }, hint: link_to(t("passwords.forgot_password"), password_reset_path) %>
        <% end %>

        <% if @user.totp.present? %>
          <%= f.input :verification_code, placeholder: "123456", required: true, minlength: 6, maxlength: User::BACKUP_CODE_LENGTH, pattern: '\d+', input_html: { value: nil }, hint: t("passwords.backup_code_hint_html", link: link_to(t("passwords.disable_totp"), edit_user_totp_path(@user))) %>
        <% end %>

        <%= f.input :password, required: true, label: t("passwords.new_password"), input_html: { autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH } %>
        <%= f.input :password_confirmation, required: true, label: t("passwords.confirm_password"), input_html: { autocomplete: "new-password" } %>
        <p class="text-sm text-muted"><%= t("passwords.logout_notice") %></p>
        <%= f.submit_button t("passwords.save") %>
      <% end %>
    </div>

    <div class="mt-4 flex justify-center">
      <%= link_to t("passwords.back_to_settings"), settings_path %>
    </div>
  </div>
</div>

<%= render "users/secondary_links" %>
