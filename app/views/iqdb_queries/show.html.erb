<% page_title t("iqdb_queries.show.page_title") %>
<% noindex if params[:search].present? %>

<div id="c-iqdb-queries">
  <div id="a-check">
    <h1><%= t("iqdb_queries.show.heading") %></h1>
    <section>
      <p><%= t("iqdb_queries.show.intro", app_name: Danbooru.config.app_name) %></p>

      <%= search_form_for(iqdb_queries_path, method: :post) do |f| %>
        <%= f.input :post_id, label: t("iqdb_queries.show.post_id"), input_html: { value: params[:search][:post_id] } %>
        <%= f.input :url, input_html: { value: params[:search][:url] } %>
        <%= f.input :hash, input_html: { value: params[:search][:hash] }, placeholder: t("iqdb_queries.show.hash_placeholder") %>
        <%= f.input :file, as: :file %>
        <%= f.submit t("iqdb_queries.show.submit") %>
      <% end %>
    </section>

    <%= render SimilarImagesComponent.new(matches: @matches, current_user: CurrentUser.user, low_similarity: search_params[:similarity]&.to_f, high_similarity: search_params[:high_similarity]&.to_f) %>
  </div>
</div>

<%= render "uploads/secondary_links" %>
