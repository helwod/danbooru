<% page_title t("explore.posts.viewed.page_title") %>
<% meta_description t("explore.posts.viewed.meta_description", scale: @scale) %>

<%= render "posts/partials/common/secondary_links" %>

<div id="c-explore-posts">
  <div id="a-viewed">
    <h1><%= t("explore.posts.viewed.heading", date: @date) %></h1>

    <%= render BlacklistComponent.new(user: CurrentUser.user, inline: true) %>

    <%= render_post_gallery(@posts) %>

    <div class="paginator flex gap-2 items-center justify-center mt-4">
      <%= link_to t("explore.posts.previous"), viewed_explore_posts_path(date: 1.day.ago(@date).to_date) %>
      <%= link_to t("explore.posts.next_day"), viewed_explore_posts_path(date: 1.day.since(@date).to_date) %>
    </div>
  </div>
</div>
