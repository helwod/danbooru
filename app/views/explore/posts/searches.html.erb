<% page_title t("explore.posts.searches.page_title") %>
<%= render "posts/partials/common/secondary_links" %>

<div id="c-explore-posts">
  <div id="a-searches">
    <h1><%= t("explore.posts.searches.heading", date: @date) %></h1>

    <table class="striped" width="100%">
      <thead>
        <tr>
          <th><%= t("explore.posts.searches.column_tags") %></th>
          <th style="text-align: right;"><%= t("explore.posts.searches.column_count") %></th>
        </tr>
      </thead>
      <tbody>
        <% @searches.each do |search, count| %>
          <tr class="tag-type-<%= Tag.find_by_name(search)&.category.to_i %>" data-is-deprecated="<%= Tag.find_by_name(search)&.is_deprecated? %>">
            <td><%= link_to search, posts_path(tags: search) %></td>
            <td style="text-align: right;"><%= count.to_i %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="paginator flex gap-2 items-center justify-center mt-4">
      <%= link_to t("explore.posts.previous"), searches_explore_posts_path(date: 1.day.ago(@date).to_date) %>
      <%= link_to t("explore.posts.next_day"), searches_explore_posts_path(date: 1.day.since(@date).to_date) %>
    </div>
  </div>
</div>
