<div id="dtext-help" class="prose">
  <table class="striped" width="100%">
    <thead>
      <tr>
        <th width="50%"><%= t("static.dtext_help_type") %></th>
        <th width="50%"><%= t("static.dtext_help_result") %></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>[b]<%= t("static.dtext_help_bold") %>[/b]</td>
        <td><b><%= t("static.dtext_help_bold") %></b></td>
      </tr>
      <tr>
        <td>[i]<%= t("static.dtext_help_italics") %>[/i]</td>
        <td><i><%= t("static.dtext_help_italics") %></i></td>
      </tr>
      <tr>
        <td>[u]<%= t("static.dtext_help_underline") %>[/u]</td>
        <td><u><%= t("static.dtext_help_underline") %></u></td>
      </tr>
      <tr>
        <td>[s]<%= t("static.dtext_help_strikethrough") %>[/s]</td>
        <td><s><%= t("static.dtext_help_strikethrough") %></s></td>
      </tr>
      <tr>
        <td>[tn]<%= t("static.dtext_help_note") %>[/tn]</td>
        <td><%= format_text "[tn]#{t("static.dtext_help_note")}[/tn]" %></td>
      </tr>
      <tr>
        <td>[spoilers]<%= t("static.dtext_help_spoiler") %>[/spoilers]</td>
        <td><%= format_text " [spoilers]#{t("static.dtext_help_spoiler")}[/spoilers]" %></td>
      </tr>
      <tr>
        <td>&lt;<%= root_url.chomp("/") %>&gt;</td>
        <td><%= format_text root_url.chomp("/") %></td>
      </tr>
      <tr>
        <td>"<%= Danbooru.config.app_name %>":[<%= root_url.chomp("/") %>]</td>
        <td><%= format_text "\"#{Danbooru.config.app_name}\":[#{root_url.chomp("/")}]" %></td>
      </tr>
      <tr>
        <td>[[Kantai Collection]]</td>
        <td><%= format_text "[[Kantai Collection]]" %></td>
      </tr>
      <tr>
        <td>[[Kantai Collection|Kancolle]]</td>
        <td><%= format_text "[[Kantai Collection|Kancolle]]" %></td>
      </tr>
      <tr>
        <td>[[Fate (series)|]]</td>
        <td><%= format_text "[[Fate (series)|]]" %></td>
      </tr>
      <tr>
        <td>{{kantai_collection comic}}</td>
        <td><%= format_text "{{kantai_collection comic}}" %></td>
      </tr>
      <tr>
        <td>@user</td>
        <td><%= format_text "@user" %></td>
      </tr>
      <tr>
        <td>post #1</td>
        <td><%= format_text "post #1" %></td>
      </tr>
      <tr>
        <td>topic #1</td>
        <td><%= format_text "topic #1" %></td>
      </tr>
      <tr>
        <td>
          * <%= t("static.dtext_help_item_one") %><br>
          * <%= t("static.dtext_help_item_two") %><br>
          * <%= t("static.dtext_help_item_three") %><br>
        </td>
        <td><%= format_text "* #{t("static.dtext_help_item_one")}\n* #{t("static.dtext_help_item_two")}\n* #{t("static.dtext_help_item_three")}" %></td>
      </tr>
      <tr>
        <td>h1. <%= t("static.dtext_help_big_header") %></td>
        <td><%= format_text "h1. #{t("static.dtext_help_big_header")}" %></td>
      </tr>
      <tr>
        <td>h6. <%= t("static.dtext_help_small_header") %></td>
        <td><%= format_text "h6. #{t("static.dtext_help_small_header")}" %></td>
      </tr>
      <tr>
        <td>[quote]<%= t("static.dtext_help_quote") %>[/quote]</td>
        <td><%= format_text "[quote]#{t("static.dtext_help_quote")}[/quote]" %></td>
      </tr>
    </tbody>
  </table>

  <p class="fineprint">
    <%= t("static.dtext_help_footer_html", link: link_to_wiki(t("static.dtext_help_wiki_link"), "help:dtext")).html_safe %>
  </p>
</div>
