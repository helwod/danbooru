<% page_title "#{t("static.error")}: #{@exception.class}" %>

<h1><%= t("static.error") %></h1>

<% if @message.present? %>
  <p><%= t("static.error") %>: <%= @message %></p>
<% else %>
  <p><%= t("static.unexpected_error", class: @exception.class) %></p>

  <h3><%= t("static.details") %></h3>

  <ul class="backtrace font-monospace p-4 mb-4">
    <li><%= t("static.exception_raised", class: @exception.class.to_s) %></li>

    <% Rails.backtrace_cleaner.clean(@backtrace).each do |b| %>
      <li class="backtrace-line"><%= b %></li>
    <% end %>
  </ul>
<% end %>
