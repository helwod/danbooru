<% page_title t("privacy_policy.title") %>

<% @app_name = Danbooru.config.canonical_app_name %>
<% @contact_email = Danbooru.config.contact_email %>

<div id="c-static">
  <div id="a-privacy-policy" class="prose fixed-width-container">
    <h1><%= t("privacy_policy.title") %></h1>

    <p><em><%= t("privacy_policy.last_updated") %></em></p>

    <p><%= t("privacy_policy.intro", app_name: @app_name) %></p>

    <p><%= t("privacy_policy.contact_html", email: link_to(@contact_email, "mailto:#{@contact_email}")).html_safe %></p>

    <h4><%= t("privacy_policy.what_we_collect.heading") %></h4>

    <h6><%= t("privacy_policy.what_we_collect.provide.heading") %></h6>

    <p><em><%= t("privacy_policy.what_we_collect.provide.summary") %></em></p>

    <p><%= t("privacy_policy.what_we_collect.provide.intro") %></p>

    <ul class="list-bulleted">
      <li><%= t("privacy_policy.what_we_collect.provide.account_html").html_safe %></li>

      <li><%= t("privacy_policy.what_we_collect.provide.content_html").html_safe %></li>

      <li><%= t("privacy_policy.what_we_collect.provide.actions_html").html_safe %></li>

      <li><%= t("privacy_policy.what_we_collect.provide.payment_html").html_safe %></li>

      <li><%= t("privacy_policy.what_we_collect.provide.other_html").html_safe %></li>
    </ul>

    <h6><%= t("privacy_policy.what_we_collect.automatic.heading") %></h6>

    <p><em><%= t("privacy_policy.what_we_collect.automatic.summary") %></em></p>

    <ul class="list-bulleted">
      <li><%= t("privacy_policy.what_we_collect.automatic.logs_html").html_safe %></li>

      <li><%= t("privacy_policy.what_we_collect.automatic.cookies_html").html_safe %></li>
    </ul>

    <h6><%= t("privacy_policy.what_we_collect.other_sources.heading") %></h6>

    <p><em><%= t("privacy_policy.what_we_collect.other_sources.summary", app_name: @app_name) %></em></p>

    <p><%= t("privacy_policy.what_we_collect.other_sources.body", app_name: @app_name) %></p>

    <h4><%= t("privacy_policy.usage.heading") %></h4>

    <p><em><%= t("privacy_policy.usage.summary") %></em></p>

    <p><%= t("privacy_policy.usage.intro") %></p>

    <ul class="list-bulleted">
      <li><%= t("privacy_policy.usage.provide_html").html_safe %></li>

      <li><%= t("privacy_policy.usage.manage_html").html_safe %></li>

      <li><%= t("privacy_policy.usage.protect_html").html_safe %></li>

      <li><%= t("privacy_policy.usage.monitor_html").html_safe %></li>

      <li><%= t("privacy_policy.usage.login_html", app_name: @app_name).html_safe %></li>

      <li><%= t("privacy_policy.usage.legal_html").html_safe %></li>
    </ul>

    <h4><%= t("privacy_policy.sharing.heading") %></h4>

    <p><em><%= t("privacy_policy.sharing.summary", app_name: @app_name) %></em></p>

    <p><%= t("privacy_policy.sharing.intro") %></p>

    <ul class="list-bulleted">
      <li><%= t("privacy_policy.sharing.content") %></li>

      <li><%= t("privacy_policy.sharing.edits") %></li>

      <li><%= t("privacy_policy.sharing.personal") %></li>

      <li><%= t("privacy_policy.sharing.private") %></li>

      <li><%= t("privacy_policy.sharing.username") %></li>

      <li><%= t("privacy_policy.sharing.profile") %></li>

      <li><%= t("privacy_policy.sharing.messages") %></li>

      <li><%= t("privacy_policy.sharing.moderators") %></li>

      <li><%= t("privacy_policy.sharing.third_party_api", app_name: @app_name) %></li>
    </ul>

    <p><%= t("privacy_policy.sharing.otherwise") %></p>

    <ul class="list-bulleted">
      <li><%= t("privacy_policy.sharing.consent_html").html_safe %></li>

      <li><%= t("privacy_policy.sharing.providers_html").html_safe %></li>

      <li><%= t("privacy_policy.sharing.aggregated_html").html_safe %></li>

      <li><%= t("privacy_policy.sharing.enforce_html").html_safe %></li>

      <li><%= t("privacy_policy.sharing.law_html").html_safe %></li>

      <li><%= t("privacy_policy.sharing.emergency_html").html_safe %></li>

      <li><%= t("privacy_policy.sharing.transfers_html").html_safe %></li>
    </ul>

    <h6><%= t("privacy_policy.linked.heading") %></h6>

    <p><em><%= t("privacy_policy.linked.summary", app_name: @app_name) %></em></p>

    <p><%= t("privacy_policy.linked.body_1", app_name: @app_name) %></p>

    <p><%= t("privacy_policy.linked.body_2") %></p>

    <p><%= t("privacy_policy.linked.body_3", app_name: @app_name) %></p>

    <h4><%= t("privacy_policy.controlling.heading") %></h4>

    <h6><%= t("privacy_policy.controlling.access.heading") %></h6>

    <p><%= t("privacy_policy.controlling.access.body_html", settings: link_to(t("privacy_policy.controlling.access.settings_link"), settings_path)).html_safe %></p>

    <h6><%= t("privacy_policy.controlling.delete.heading") %></h6>

    <p><em><%= t("privacy_policy.controlling.delete.summary") %></em></p>

    <p><%= t("privacy_policy.controlling.delete.body_1_html", app_name: @app_name, here: link_to(t("privacy_policy.controlling.delete.here_link"), deactivate_users_path)).html_safe %></p>

    <p><%= t("privacy_policy.controlling.delete.body_2") %></p>

    <p><%= t("privacy_policy.controlling.delete.body_3") %></p>

    <p><%= t("privacy_policy.controlling.delete.body_4") %></p>

    <h6><%= t("privacy_policy.controlling.email.heading") %></h6>

    <p><%= t("privacy_policy.controlling.email.body_html", settings: link_to(t("privacy_policy.controlling.access.settings_link"), settings_path)).html_safe %></p>

    <h6><%= t("privacy_policy.controlling.cookies.heading") %></h6>

    <p><%= t("privacy_policy.controlling.cookies.body") %></p>

    <h4><%= t("privacy_policy.other.heading") %></h4>

    <h6><%= t("privacy_policy.other.minors.heading") %></h6>

    <p><%= t("privacy_policy.other.minors.body") %></p>

    <h6><%= t("privacy_policy.other.retention.heading") %></h6>

    <p><em><%= t("privacy_policy.other.retention.summary") %></em></p>

    <p><%= t("privacy_policy.other.retention.body_1") %></p>

    <p><%= t("privacy_policy.other.retention.body_2") %></p>

    <h6><%= t("privacy_policy.other.transfers.heading") %></h6>

    <p><em><%= t("privacy_policy.other.transfers.summary") %></em></p>

    <p><%= t("privacy_policy.other.transfers.body") %></p>

    <h6><%= t("privacy_policy.other.security.heading") %></h6>

    <p><em><%= t("privacy_policy.other.security.summary") %></em></p>

    <p><%= t("privacy_policy.other.security.body_1", app_name: @app_name) %></p>

    <p><%= t("privacy_policy.other.security.body_2") %></p>

    <h6><%= t("privacy_policy.other.changes.heading") %></h6>

    <p><em><%= t("privacy_policy.other.changes.summary") %></em></p>

    <p><%= t("privacy_policy.other.changes.body_1") %></p>

    <p><%= t("privacy_policy.other.changes.body_2") %></p>
  </div>
</div>
