<% page_title t("static.access_denied_title") %>

<h1><%= t("static.access_denied_title") %></h1>

<p>
  <%= t("static.access_denied_body") %>

  <% if CurrentUser.user.is_anonymous? %>
    <%= t("static.access_denied_login_html", login: link_to(t("static.logging_in"), main_app.login_path(url: request.fullpath)), signup: link_to(t("static.signing_up"), main_app.new_user_path)).html_safe %>
  <% end %>
</p>

<%= link_to t("static.go_back"), :back, :rel => "prev" %>
