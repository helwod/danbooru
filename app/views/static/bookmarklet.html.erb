<% page_title t("static.bookmarklet_title") %>
<%= render "uploads/secondary_links" %>

<div id="c-static">
  <div id="a-bookmarklet">
    <div class="card fixed-width-container p-4 mx-auto prose">
      <p class="text-center">
        <% bookmarklet = "javascript:void(location.href='#{request.protocol + request.host_with_port}/uploads/new?url='+encodeURIComponent(location.href)+'&ref='+encodeURIComponent(document.referrer))" %>
        <% drag_notice = j t("static.bookmarklet_drag_notice") %>
        <%= link_to t("static.bookmarklet_link", app_name: Danbooru.config.app_name), bookmarklet, class: "text-xl font-bold text-center button-outline-primary", "x-data": "{}", "x-on:click.prevent": "Danbooru.Notice.info('#{drag_notice}')" %>
      </p>

      <p class="fineprint text-center"><%= t("static.bookmarklet_drag") %></p>

      <p><%= t("static.bookmarklet_intro", app_name: Danbooru.config.app_name) %></p>

      <p><%= t("static.bookmarklet_to_install") %></p>

      <ul>
        <li><%= t("static.bookmarklet_install_1", link: t("static.bookmarklet_link", app_name: Danbooru.config.app_name)) %></li>
        <li><%= t("static.bookmarklet_install_2") %></li>
        <li><%= t("static.bookmarklet_install_3") %></li>
      </ul>

      <p><%= t("static.bookmarklet_to_use") %></p>

      <ul>
        <li><%= t("static.bookmarklet_use_1", link: t("static.bookmarklet_link", app_name: Danbooru.config.app_name)) %></li>
        <li><%= t("static.bookmarklet_use_2") %></li>
        <li><%= t("static.bookmarklet_use_3") %></li>
      </ul>

      <h4><%= t("static.bookmarklet_supported_sites") %></h4>

      <div class="columns-5xs space-y-1">
        <% sites = Source::Site.sites.select { |site| site.extractors.present? } %>
        <% sites = sites.reject { |site| site.extractors == [Source::Extractor::URLShortener] } %>
        <% sites = sites.sort_by { |site| site.name.downcase } %>

        <% sites.each do |site| %>
          <div>
            <%= external_link_to site.url.to_s, class: "inline-flex items-center gap-2 chip-primary" do %>
              <%= external_site_icon site.name, class: "h-4" %>
              <%= site.name %>
            <% end %>
          </div>
        <% end %>
      </div>

      <h4><%= t("static.bookmarklet_external_links") %></h4>

      <ul>
        <li><a href="https://support.mozilla.org/en-US/kb/bookmarklets-perform-common-web-page-tasks"><%= t("static.bookmarklet_mozilla_link") %></a></li>
      </ul>
    </div>
  </div>
</div>
