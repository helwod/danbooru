<% page_title t("static.page_limit_exceeded_title") %>

<h1><%= t("static.search_error") %></h1>

<p>
  <%= @message %>

  <% if CurrentUser.is_gold? %>
    <%= t("static.narrow_search_terms") %>
  <% else %>
    <%= t("static.narrow_search_or_upgrade_html", upgrade: link_to(t("static.upgrade_your_account"), new_user_upgrade_path), limit: CurrentUser.user.page_limit).html_safe %>
  <% end %>
</p>

<%= link_to t("static.go_back"), :back, rel: "prev" %>
