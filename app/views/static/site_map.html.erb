<% page_title t("static.site_map_title") %>

<div id="c-static">
  <div id="a-site-map" class="fixed-width-container space-y-4 md:flex md:space-y-0">
    <section class="flex-auto space-y-4">
      <ul>
        <li><h2><%= t("static.sm_posts_section") %></h2></li>
        <li><%= link_to(t("static.sm_posts"), posts_path) %></li>
        <li><%= link_to(t("static.sm_upload"), new_upload_path) %></li>
        <li><%= link_to(t("static.sm_popular"), popular_explore_posts_path) %></li>
        <li><%= link_to(t("static.sm_votes"), post_votes_path) %></li>
        <li><%= link_to(t("static.sm_most_viewed"), viewed_explore_posts_path) %></li>
        <li><%= link_to(t("static.sm_iqdb"), iqdb_queries_path) %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:posts" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_post_events_section") %></h2></li>
        <li><%= link_to(t("static.sm_tag_history"), post_versions_path) %></li>
        <li><%= link_to(t("static.sm_events"), post_events_path) %></li>
        <li><%= link_to(t("static.sm_appeals"), post_appeals_path) %></li>
        <li><%= link_to(t("static.sm_approvals"), post_approvals_path) %></li>
        <li><%= link_to(t("static.sm_disapprovals"), post_disapprovals_path) %></li>
        <li><%= link_to(t("static.sm_flags"), post_flags_path) %></li>
        <li><%= link_to(t("static.sm_replacements"), post_replacements_path) %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_artists_section") %></h2></li>
        <li><%= link_to(t("static.sm_artists"), artists_path) %></li>
        <li><%= link_to(t("static.sm_history"), artist_versions_path) %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:artists" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_artist_commentary_section") %></h2></li>
        <li><%= link_to(t("static.sm_commentary"), artist_commentaries_path) %></li>
        <li><%= link_to(t("static.sm_history"), artist_commentary_versions_path) %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:artist_commentary" %></li>
      </ul>
    </section>

    <section class="flex-auto space-y-4">
      <ul>
        <li><h2><%= t("static.sm_tags_section") %></h2></li>
        <li><%= link_to(t("static.sm_tags"), tags_path) %></li>
        <li><%= link_to(t("static.sm_history"), tag_versions_path) %></li>
        <li><%= link_to(t("static.sm_aliases"), tag_aliases_path) %></li>
        <li><%= link_to(t("static.sm_implications"), tag_implications_path) %></li>
        <li><%= link_to(t("static.sm_ai_tags"), ai_tags_path) %></li>
        <li><%= link_to(t("static.sm_related_tags"), related_tag_path) %></li>
        <li><%= link_to_wiki t("static.sm_cheat_sheet"), "help:cheatsheet" %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:tags" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_notes_section") %></h2></li>
        <li><%= link_to(t("static.sm_notes"), notes_path) %></li>
        <li><%= link_to(t("static.sm_history"), note_versions_path) %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:notes" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_pools_section") %></h2></li>
        <li><%= link_to(t("static.sm_pools"), pools_path) %></li>
        <li><%= link_to(t("static.sm_gallery"), gallery_pools_path) %></li>
        <% if PoolVersion.enabled? %>
          <li><%= link_to(t("static.sm_history"), pool_versions_path) %></li>
        <% end %>
        <li><%= link_to_wiki t("static.sm_help"), "help:pools" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_reports_section") %></h2></li>
        <li><%= link_to(t("static.sm_reports"), reports_path) %></li>
        <li><%= link_to(t("static.sm_top_searches"), searches_explore_posts_path) %></li>
        <li><%= link_to(t("static.sm_missed_searches"), missed_searches_explore_posts_path) %></li>
      </ul>
    </section>

    <section class="flex-auto space-y-4">
      <% if Danbooru.config.comments_enabled?.to_s.truthy? %>
        <ul>
          <li><h2><%= t("static.sm_comments_section") %></h2></li>
          <li><%= link_to(t("static.sm_comments"), comments_path) %></li>
          <li><%= link_to(t("static.sm_search"), comments_path(group_by: "comment")) %></li>
          <li><%= link_to(t("static.sm_votes"), comment_votes_path) %></li>
          <li><%= link_to(t("static.sm_rss"), comments_path(:atom)) %></li>
          <li><%= link_to_wiki t("static.sm_help"), "help:comments" %></li>
        </ul>
      <% end %>

      <% if Danbooru.config.forum_enabled?.to_s.truthy? %>
        <ul>
          <li><h2><%= t("static.sm_forum_section") %></h2></li>
          <li><%= link_to(t("static.sm_forum"), forum_topics_path) %></li>
          <li><%= link_to(t("static.sm_search"), search_forum_posts_path) %></li>
          <li><%= link_to(t("static.sm_bulk_update_requests"), bulk_update_requests_path) %></li>
          <li><%= link_to(t("static.sm_votes"), forum_post_votes_path) %></li>
          <li><%= link_to(t("static.sm_rss"), forum_topics_path(:atom)) %></li>
          <li><%= link_to_wiki t("static.sm_help"), "help:forum" %></li>
        </ul>
      <% end %>

      <ul>
        <li><h2><%= t("static.sm_wiki_section") %></h2></li>
        <li><%= link_to_wiki t("static.sm_wiki"), "help:home" %></li>
        <li><%= link_to(t("static.sm_search"), wiki_pages_path) %></li>
        <li><%= link_to(t("static.sm_history"), wiki_page_versions_path) %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:wiki" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_site_section") %></h2></li>
        <li><%= link_to(t("static.sm_site_status"), status_path) %></li>
        <li><%= link_to(t("static.sm_site_statistics"), statistics_path) %></li>
        <li><%= link_to(t("static.sm_source_code"), Danbooru.config.source_code_url) %></li>
        <li><%= link_to_wiki t("static.sm_user_scripts"), "help:user_scripts" %></li>
        <li><%= link_to(t("static.sm_keyboard_shortcuts"), keyboard_shortcuts_path) %></li>
        <li><%= link_to_wiki t("static.sm_api_documentation"), "help:api" %></li>
        <li><%= link_to(t("static.sm_background_jobs"), jobs_path) %></li>
      </ul>
    </section>

    <section class="flex-auto space-y-4">
      <ul>
        <li><h2><%= t("static.sm_profile_section") %></h2></li>
        <% if CurrentUser.is_anonymous? %>
          <li><%= link_to t("static.sm_login"), login_path %></li>
          <li><%= link_to t("static.sm_sign_up"), new_user_path %></li>
        <% else %>
          <li><%= link_to t("static.sm_profile"), profile_path %></li>
          <li><%= link_to t("static.sm_settings"), settings_path %></li>
          <li><%= link_to t("static.sm_uploads"), user_uploads_path(CurrentUser.user) %></li>
          <li><%= link_to t("static.sm_dmails"), dmails_path(search: { folder: "received" }) %></li>
          <li><%= link_to t("static.sm_favorites"), favorites_path %></li>
          <li><%= link_to t("static.sm_favorite_groups"), favorite_groups_path %></li>
          <li><%= link_to t("static.sm_saved_searches"), saved_searches_path %></li>
        <% end %>
        <li><%= link_to t("static.sm_upgrade_account"), new_user_upgrade_path %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_users_section") %></h2></li>
        <li><%= link_to(t("static.sm_users"), users_path) %></li>
        <li><%= link_to(t("static.sm_bans"), bans_path) %></li>

        <% if policy(IpBan).index? %>
          <li><%= link_to(t("static.sm_ip_bans"), ip_bans_path) %></li>
        <% end %>

        <% if policy(EmailAddress).index? %>
          <li><%= link_to(t("static.sm_email_addresses"), emails_path) %></li>
        <% end %>

        <% if policy(UserNameChangeRequest).index? %>
          <li><%= link_to(t("static.sm_name_changes"), user_name_change_requests_path) %></li>
        <% end %>

        <li><%= link_to(t("static.sm_feedback"), user_feedbacks_path) %></li>
        <li><%= link_to_wiki t("static.sm_help"), "help:users" %></li>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_admin_section") %></h2></li>

        <% if policy(PostApproval).create? %>
          <li><%= link_to(t("static.sm_modqueue"), modqueue_index_path) %></li>
        <% end %>

        <li><%= link_to(t("static.sm_mod_actions"), mod_actions_path) %></li>

        <% if policy(UserAction).index? %>
          <li><%= link_to(t("static.sm_user_actions"), user_actions_path) %></li>
        <% end %>

        <% if policy(UserEvent).can_see_events_by_others? %>
          <li><%= link_to(t("static.sm_user_events"), user_events_path) %></li>
        <% end %>

        <% if policy(ModerationReport).index? %>
          <li><%= link_to(t("static.sm_moderation_reports"), moderation_reports_path) %></li>
        <% end %>

        <% if policy(NewsUpdate).index? %>
          <li><%= link_to(t("static.sm_news_updates"), news_updates_path) %></li>
        <% end %>

        <% if policy(SiteCredential).create? %>
          <li><%= link_to(t("static.sm_site_credentials"), site_credentials_path) %></li>
        <% end %>
      </ul>

      <ul>
        <li><h2><%= t("static.sm_legal_section") %></h2></li>
        <li><%= link_to(t("static.sm_privacy_policy"), privacy_policy_path) %></li>
        <li><%= link_to(t("static.sm_terms_of_service"), terms_of_service_path) %></li>
        <li><%= link_to(t("static.sm_2257_statement"), usc_2257_path) %></li>
        <li><%= link_to(t("static.sm_dmca"), dmca_path) %></li>
      </ul>
    </section>
  </div>
</div>
