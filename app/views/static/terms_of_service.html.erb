<% page_title t("terms_of_service.title") %>

<% @app_name = Danbooru.config.canonical_app_name %>
<% @contact_email = Danbooru.config.contact_email %>

<div id="c-static">
  <div id="a-terms-of-service" class="prose fixed-width-container">
    <h1><%= t("terms_of_service.title") %></h1>

    <p class="summary"><%= t("terms_of_service.last_updated") %></p>

    <p><%= t("terms_of_service.intro_1") %></p>

    <p><%= t("terms_of_service.intro_2_html", upload_rules: link_to_wiki(t("terms_of_service.upload_rules_link"), "help:upload_rules"), community_rules: link_to_wiki(t("terms_of_service.community_rules_link"), "help:community_rules"), privacy_policy: link_to(t("terms_of_service.privacy_policy_link"), privacy_policy_path)).html_safe %></p>

    <h4><%= t("terms_of_service.access.heading") %></h4>

    <p><%= t("terms_of_service.access.minors") %></p>

    <p><%= t("terms_of_service.access.terminate_html", upload_rules: link_to_wiki(t("terms_of_service.upload_rules_link"), "help:upload_rules"), community_rules: link_to_wiki(t("terms_of_service.community_rules_link"), "help:community_rules")).html_safe %></p>

    <h4><%= t("terms_of_service.cannot.heading") %></h4>

    <p><%= t("terms_of_service.cannot.intro_html", upload_rules: link_to_wiki(t("terms_of_service.upload_rules_link"), "help:upload_rules"), community_rules: link_to_wiki(t("terms_of_service.community_rules_link"), "help:community_rules")).html_safe %>

    <p><%= t("terms_of_service.cannot.will_not") %></p>

    <ul class="list-bulleted">
      <li>
        <%= t("terms_of_service.cannot.multiple_accounts") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.bypass_limits") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.share_account") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.sell_accounts") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.spam") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.unauthorized_access") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.malware") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.disrupt") %>
      </li>

      <li>
        <%= t("terms_of_service.cannot.bots") %>
      </li>
    </ul>

    <h4><%= t("terms_of_service.content.heading") %></h4>

    <p><%= t("terms_of_service.content.responsibility") %></p>

    <p><%= t("terms_of_service.content.must_abide_html", upload_rules: link_to_wiki(t("terms_of_service.upload_rules_link"), "help:upload_rules"), community_rules: link_to_wiki(t("terms_of_service.community_rules_link"), "help:community_rules")).html_safe %></p>

    <p><%= t("terms_of_service.content.exposure") %></p>

    <p><%= t("terms_of_service.content.rights") %></p>

    <p><%= t("terms_of_service.content.license", app_name: @app_name) %></p>

    <h4><%= t("terms_of_service.copyright.heading") %></h4>

    <p><%= t("terms_of_service.copyright.dmca_intro") %></p>

    <p><%= t("terms_of_service.copyright.report_html", form: link_to(t("terms_of_service.copyright.report_form_link"), dmca_path), email: link_to(Danbooru.config.dmca_email, "mailto:#{Danbooru.config.dmca_email}")).html_safe %></p>

    <p><%= t("terms_of_service.copyright.notice_methods") %></p>

    <ul>
      <li><%= t("terms_of_service.copyright.required_1") %></li>
      <li><%= t("terms_of_service.copyright.required_2", app_name: Danbooru.config.canonical_app_name) %></li>
      <li><%= t("terms_of_service.copyright.required_3", app_name: Danbooru.config.canonical_app_name) %></li>
      <li><%= t("terms_of_service.copyright.required_4") %></li>
      <li><%= t("terms_of_service.copyright.required_5") %></li>
      <li><%= t("terms_of_service.copyright.required_6") %></li>
    </ul>

    <p><%= t("terms_of_service.copyright.required_note") %></p>

    <p><%= t("terms_of_service.copyright.fair_use") %></p>

    <p><%= t("terms_of_service.copyright.factual_info") %></p>

    <h4><%= t("terms_of_service.upgrade.heading") %></h4>

    <p><%= t("terms_of_service.upgrade.payment") %></p>

    <p><%= t("terms_of_service.upgrade.fees") %></p>

    <h4><%= t("terms_of_service.api.heading") %></h4>

    <p><%= t("terms_of_service.api.rate_limits_html", api_docs: link_to_wiki(t("terms_of_service.api.api_docs_link"), "help:api")).html_safe %></p>

    <h4><%= t("terms_of_service.privacy.heading") %></h4>

    <p><%= t("terms_of_service.privacy.body_html", privacy_policy: link_to(t("terms_of_service.privacy_policy_link"), privacy_policy_path)).html_safe %></p>

    <h4><%= t("terms_of_service.misc.heading") %></h4>

    <p><%= t("terms_of_service.misc.definitions", app_name: @app_name) %></p>

    <p><%= t("terms_of_service.misc.entire_agreement") %></p>

    <h4><%= t("terms_of_service.changes.heading") %></h4>

    <p><%= t("terms_of_service.changes.body_1") %></p>

    <p><%= t("terms_of_service.changes.body_2") %></p>

    <h4><%= t("terms_of_service.warranties.heading") %></h4>

    <p><%= t("terms_of_service.warranties.body", app_name: @app_name.upcase) %></p>

    <h4><%= t("terms_of_service.liability.heading") %></h4>

    <p><%= t("terms_of_service.liability.body", app_name: @app_name.upcase) %></p>
  </div>
</div>
