<% page_title t("static.search_timeout_title") %>

<div id="c-static">
  <div id="a-search-timeout" class="fixed-width-container">
    <h1><%= t("static.search_timeout_title") %></h1>

    <p><%= t("static.search_timeout_body") %></p>

    <h3><%= t("static.search_timeout_why") %></h3>

    <p>
      <%= t("static.search_timeout_why_body") %>
    </p>

    <% if params[:controller] == "posts" && params[:action] == "index" && params[:tags].present? %>
      <h3><%= t("static.search_timeout_what") %></h3>

      <p><%= t("static.search_timeout_try") %></p>

      <p>
        <table class="striped">
          <tr>
            <td><%= link_to "#{params[:tags]} age:<1month", posts_url(tags: "#{params[:tags]} age:<1month") %></td>
            <td><%= t("static.search_timeout_recent") %></td>
          </tr>
          <tr>
            <td><%= link_to "#{params[:tags]} order:score", posts_url(tags: "#{params[:tags]} order:score") %></td>
            <td><%= t("static.search_timeout_order_score") %></td>
          </tr>
          <tr>
            <td><%= link_to "#{params[:tags]} limit:5", posts_url(tags: "#{params[:tags]} limit:5") %></td>
            <td><%= t("static.search_timeout_fewer") %></td>
          </tr>
        </table>
      </p>
    <% end %>

    <% if !CurrentUser.is_gold? %>
      <h3><%= t("static.search_timeout_limits") %></h3>

      <p>
        <%= t("static.search_timeout_limits_body_html", upgrade: link_to(t("static.search_timeout_upgrade_link"), new_user_upgrade_path)).html_safe %>
      </p>
    <% end %>

    <%= link_to t("static.go_back"), :back, rel: "prev" %>
  </div>
</div>
