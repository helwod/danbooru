<div id="c-notes">
  <div id="a-index">
    <h1><%= t("notes.index.title") %></h1>

    <%= search_form_for(notes_path) do |f| %>
      <%= f.hidden_field :group_by, value: "note" %>

      <%= f.input :body_matches, label: t("notes.index.search_note"), input_html: { value: params[:search][:body_matches] } %>
      <%= f.input :post_tags_match, label: t("notes.index.search_tags"), input_html: { value: params[:search][:post_tags_match], "data-autocomplete": "tag-query" } %>
      <%= f.submit t("notes.index.submit") %>
    <% end %>

    <%= table_for @notes, class: "striped autofit" do |t| %>
      <% t.column t("notes.index.column_post"), column: "post" do |note| %>
        <%= link_to note.post_id, note.post %>
      <% end %>
      <% t.column t("notes.index.column_note"), column: "note" do |note| %>
        <%= link_to "#{note.id}.#{note.version}", post_path(note.post_id, anchor: "note-#{note.id}") %>
        <%= link_to "»", note_versions_path(search: { note_id: note.id }) %>
      <% end %>
      <% t.column t("notes.index.column_text"), td: { class: "col-expand" }, column: "text" do |note| %>
        <%= note.body %>
        <% unless note.is_active? %>
          <span class="inactive"><%= t("notes.index.deleted") %></span>
        <% end %>
      <% end %>
      <% t.column t("notes.index.column_created"), column: "created" do |note| %>
        <div><%= time_ago_in_words_tagged(note.created_at) %></div>
      <% end %>
    <% end %>

    <%= numbered_paginator(@notes) %>
  </div>
</div>

<%= render "secondary_links" %>
