<% content_for(:secondary_links) do %>
  <%= quick_search_form_for(:body_matches, notes_path, "notes") %>
  <%= subnav_link_to t("notes.secondary_links.notes"), notes_path, id: "notes" %>
  <%= subnav_link_to t("notes.secondary_links.posts"), posts_path(:tags => "order:note"), id: "posts" %>
  <%= subnav_link_to t("notes.secondary_links.changes"), note_versions_path, id: "changes" %>
  <%= subnav_link_to t("notes.secondary_links.requests"), posts_path(:tags => "translation_request"), id: "requests" %>
  <%= subnav_link_to t("notes.secondary_links.help"), wiki_page_path("help:notes"), id: "help" %>
<% end %>
