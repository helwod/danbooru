<%= search_form_for(post_votes_path) do |f| %>
  <%= f.input :user_name, label: t("post_votes.search.voter"), input_html: { value: params[:search][:user_name], "data-autocomplete": "user" } %>
  <%= f.input :post_id, label: t("post_votes.search.post"), input_html: { value: params[:search][:post_id] } %>
  <%= f.input :post_tags_match, label: t("post_votes.search.tags"), input_html: { value: params[:search][:post_tags_match], "data-autocomplete": "tag-query" } %>
  <%= f.input :score, collection: [["+3", "3"], ["+1", "1"], ["-1", "-1"], ["-3", "-3"]], include_blank: true, selected: params[:search][:score] %>
  <%= f.submit t("post_votes.search.submit") %>
<% end %>
