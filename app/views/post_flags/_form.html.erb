<div class="flag-dialog-body">
  <%= embed_wiki("help:flag_notice", classes: "mb-4") %>

  <% if CurrentUser.user.flag_limit < Float::INFINITY && CurrentUser.user.post_flags.active.count > 0 %>
    <p><b><%= t("post_flags.form.remaining") %></b>: <%= (CurrentUser.user.flag_limit - CurrentUser.user.post_flags.active.count).clamp(0..) %></p>
  <% end %>

  <%= edit_form_for(post_flag, format: :js, remote: true) do |f| %>
    <%= f.hidden_field :post_id if post_flag.new_record? %>
    <%= f.input :reason, hint: tag.span(t("post_flags.form.ctrl_enter"), class: "desktop-only"), as: :dtext, inline: true, input_html: { autofocus: true }, placeholder: t("post_flags.form.reason_placeholder") %>
    <div class="dialog-buttons">
      <%= f.submit_button create: t("post_flags.form.submit") %>
      <%= f.cancel_button t("post_flags.form.cancel") if local_assigns[:inline] %>
    </div>
  <% end %>
</div>
