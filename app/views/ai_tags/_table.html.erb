<%= table_for @ai_tags, class: "striped autofit" do |t| %>
  <% t.column :tag, column: "tag", name: t("ai_tags.tag") do |ai_tag| %>
    <%= link_to_wiki "?", ai_tag.tag.name %>
    <%= link_to ai_tag.tag.pretty_name, ai_tags_path(search: { tag_name: ai_tag.tag.name }), class: "tag-type-#{ai_tag.tag.category}", "data-tag-name": ai_tag.tag.name %>
  <% end %>

  <% t.column :asset, column: "asset", name: t("ai_tags.asset") do |ai_tag| %>
    <%= link_to t("ai_tags.asset_link", id: ai_tag.media_asset_id), ai_tag.media_asset %>
  <% end %>

  <% t.column :post, column: "post", name: t("ai_tags.post") do |ai_tag| %>
    <% if ai_tag.post.present? %>
      <%= link_to t("ai_tags.post_link", id: ai_tag.post.id), ai_tag.post %>
    <% end %>
  <% end %>

  <% t.column :confidence, column: "confidence", name: t("ai_tags.confidence") do |ai_tag| %>
    <%= ai_tag.score %>%
  <% end %>

  <% t.column t("ai_tags.tagged"), column: "tagged" do |ai_tag| %>
    <%= t("ai_tags.yes_label") if ai_tag.post_tagged? %>
  <% end %>
<% end %>
