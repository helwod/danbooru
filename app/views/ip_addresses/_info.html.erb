<div class="space-x-4">
  <div class="inline-block">
    <table class="aligned-vertical table-sm">
      <% if ip_info[:country].present? %>
        <tr>
          <th><%= t("ip_addresses.location") %></th>
          <td>
            <% if ip_info[:city] %>
              <%= ip_info[:city] %>,
            <% end %>
            <% if ip_info[:region].present? %>
              <%= ip_info[:region] %>,
            <% end %>
            <%= ip_info[:country] %>
          </td>
        </tr>
      <% end %>

      <% if ip_info[:network].present? %>
        <tr>
          <th><%= t("ip_addresses.network") %></th>
          <td>
            <%= link_to ip_info[:network], user_events_path(search: { ip_addr: ip_info[:network] }) %>
            (<%= link_to t("ip_addresses.info"), "https://ipinfo.io/AS#{ip_info[:asn]}/#{ip_info[:network]}"  %>)
          </td>
        </tr>
      <% end %>

      <tr>
        <th><%= t("ip_addresses.proxy") %></th>
        <td><%= ip_address.is_proxy? ? t("ip_addresses.yes_label") : t("ip_addresses.no_label") %></td>
      </tr>

      <% if ip_address.is_tor? %>
        <tr>
          <th><%= t("ip_addresses.tor") %></th>
          <td><%= t("ip_addresses.yes_label") %></td>
        </tr>
      <% end %>

      <tr>
        <th><%= t("ip_addresses.ip_banned") %></th>
        <td>
          <% if IpBan.ip_matches(ip_address.to_s).exists? %>
            <%= t("ip_addresses.yes_label") %> (<%= link_to t("ip_addresses.info"), ip_bans_path(search: { ip_addr: ip_address.to_s }) %>)
          <% else %>
            <%= t("ip_addresses.no_label") %>
          <% end %>
        </td>
      </tr>

      <% if ip_info[:asn].present? %>
        <tr>
          <th><%= t("ip_addresses.asn") %></th>
          <td>
            <%= link_to "AS#{ip_info[:asn]}", "https://ipinfo.io/AS#{ip_info[:asn]}" %>
          </td>
        </tr>
      <% end %>

      <% if ip_info[:organization].present? %>
        <tr>
          <th><%= t("ip_addresses.organization") %></th>
          <td>
            <%= ip_info[:organization] %>
          </td>
        </tr>
      <% end %>

      <% if ip_info[:carrier].present? %>
        <tr>
          <th><%= t("ip_addresses.mobile_carrier") %></th>
          <td><%= ip_info[:carrier] %></td>
        </tr>
      <% end %>

      <tr>
        <th><%= t("ip_addresses.details") %></th>
        <td>
          <details>
            <pre><%= JSON.pretty_generate(ip_address.ip_lookup.response) %></pre>
          </details>
        </td>
      </tr>
    </table>
  </div>

  <div class="inline-block align-top">
    <% if ip_info[:latitude].present? && ip_info[:longitude].present? %>
      <%= embedded_map(ip_info[:latitude], ip_info[:longitude], 300, 200) %>
    <% end %>
  </div>
</div>
